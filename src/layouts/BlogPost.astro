---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { ADSENSE_CLIENT, AD_SLOTS, SITE_TITLE } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & { minutes?: number };

const { title, description, pubDate, updatedDate, heroImage, minutes } = Astro.props;

const isZh = /[\p{Script=Han}]/u.test(title);
const pageLang = isZh ? 'zh-CN' : 'en';

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = heroImage
	? new URL(typeof heroImage === 'string' ? heroImage : heroImage.src, Astro.site).href
	: new URL('/og.png', Astro.site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate || pubDate).toISOString(),
	url: pageUrl,
	image: imageUrl,
	inLanguage: pageLang,
	author: {
		'@type': 'Person',
		name: 'QCSunny',
		url: new URL('/about/', Astro.site).href,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: {
			'@type': 'ImageObject',
			url: new URL('/og.png', Astro.site).href,
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl,
	},
};
---

<html lang={pageLang}>
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
		{ADSENSE_CLIENT && (
			<script
				async
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
				crossorigin="anonymous"
			></script>
		)}
		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		<!-- KaTeX math rendering (100% on-demand in browser, 0 npm dependencies, 0 impact on non-math pages) -->
		<script is:inline>
			document.addEventListener('DOMContentLoaded', () => {
				const prose = document.querySelector('.prose');
				// If the article has no mathematical notation ($), do not load KaTeX at all
				if (!prose || !prose.textContent || !prose.textContent.includes('$')) return;

				const link = document.createElement('link');
				link.rel = 'stylesheet';
				link.href = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css';
				link.crossOrigin = 'anonymous';
				document.head.appendChild(link);

				const scriptKaTeX = document.createElement('script');
				scriptKaTeX.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js';
				scriptKaTeX.crossOrigin = 'anonymous';
				scriptKaTeX.onload = () => {
					const scriptAuto = document.createElement('script');
					scriptAuto.src = 'https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js';
					scriptAuto.crossOrigin = 'anonymous';
					scriptAuto.onload = () => {
						if (window.renderMathInElement) {
							window.renderMathInElement(prose, {
								delimiters: [
									{ left: '$$', right: '$$', display: true },
									{ left: '$', right: '$', display: false },
								],
								throwOnError: false,
							});
						}
					};
					document.head.appendChild(scriptAuto);
				};
				document.head.appendChild(scriptKaTeX);
			});
		</script>
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
				max-width: 960px;
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 14px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: min(780px, calc(100% - 2.5em));
				margin: auto;
				padding: 2rem 0 4rem;
				color: var(--fg);
				font-size: 1.05rem;
				line-height: 1.85;
				overflow-wrap: break-word;
				word-break: break-word;
			}
			.back-nav {
				margin-bottom: 2rem;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--dim);
				text-decoration: none;
				transition: color 0.15s ease, transform 0.15s ease;
			}
			.back-link:hover {
				color: var(--accent);
				transform: translateX(-3px);
				text-decoration: none;
			}
			.title {
				margin: 0 0 2.5em;
				padding: 0 0 2em;
				border-bottom: 1px solid var(--gridline);
				text-align: left;
			}
			.title h1 {
				font-size: clamp(1.9rem, 4.8vw, 2.7rem);
				font-weight: 800;
				line-height: 1.3;
				letter-spacing: -0.02em;
				margin: 0.4em 0 0.5em;
				color: var(--fg);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				align-items: center;
				margin: 0;
				color: var(--dim);
				font-size: 0.85rem;
				font-family:
					ui-monospace,
					'SFMono-Regular',
					Consolas,
					Menlo,
					monospace;
			}
			.meta-chip {
				background: var(--accent-soft);
				color: var(--accent);
				padding: 0.15em 0.5em;
				border-radius: 5px;
				font-weight: 600;
			}
			.lede {
				color: var(--dim);
				font-size: 1.12rem;
				line-height: 1.7;
				margin: 0.8em 0 0;
			}
			.last-updated-on {
				font-style: italic;
			}
			.blog-tools-card {
				margin: 3.5rem 0 1.5rem;
				padding: 1.8rem 2rem;
				border: 1px solid var(--gridline);
				border-radius: 14px;
				background: var(--card);
				box-shadow: var(--box-shadow);
				position: relative;
				overflow: hidden;
			}
			.blog-tools-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: linear-gradient(90deg, var(--accent) 0%, #8b5cf6 100%);
			}
			.blog-tools-card h3 {
				font-size: 1.18rem;
				font-weight: 700;
				margin-bottom: 0.5em;
				color: var(--fg);
			}
			.blog-tools-card p {
				font-size: 0.94rem;
				color: var(--dim);
				margin-bottom: 1.1em;
				line-height: 1.65;
			}
			.blog-tools-card .tool-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em 0.8em;
				margin-bottom: 1.1em;
			}
			.blog-tools-card .tool-chip {
				display: inline-block;
				padding: 0.4em 0.85em;
				font-size: 0.86rem;
				font-weight: 600;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				text-decoration: none;
				color: var(--fg);
				background: var(--bg);
				transition: border-color 0.15s, color 0.15s, transform 0.15s;
			}
			.blog-tools-card .tool-chip:hover {
				border-color: var(--accent);
				color: var(--accent);
				transform: translateY(-2px);
				text-decoration: none;
			}
			.blog-tools-card .all-tools-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				font-size: 0.92rem;
				color: var(--accent);
				text-decoration: none;
				font-weight: 700;
			}
			.blog-tools-card .all-tools-link:hover {
				text-decoration: underline;
			}
			.blog-ad {
				margin: 2.5em auto;
				min-height: 120px;
				display: flex;
				justify-content: center;
			}
			.blog-ad .adsbygoogle {
				width: 100%;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="back-nav">
						<a class="back-link" href="/blog/">
							← <span class="i18n-zh">返回博客列表</span><span class="i18n-en">Back to Blog</span>
						</a>
					</div>
					<header class="title">
						<p class="meta">
							<span class="meta-chip">
								<span class="i18n-zh">深度长文</span>
								<span class="i18n-en">Article</span>
							</span>
							<FormattedDate date={pubDate} />
							<span aria-hidden="true">·</span>
							{minutes && <span>{minutes} min read</span>}
							{
								updatedDate && (
									<span class="last-updated-on">
										(updated <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</p>
						<h1>{title}</h1>
						{description && <p class="lede">{description}</p>}
					</header>
					<slot />

					<aside class="blog-tools-card">
						<h3>🛠️ 探索在线免注册小工具库</h3>
						<p>
							本站提供 40+ 款纯浏览器端运行的免登录免费工具，数据仅在本地运算，绝不上传任何服务器：
						</p>
						<div class="tool-links">
							<a class="tool-chip" href="/tools/json-formatter/">JSON 格式化</a>
							<a class="tool-chip" href="/tools/sql-formatter/">SQL 格式化</a>
							<a class="tool-chip" href="/tools/jwt-decoder/">JWT 解码</a>
							<a class="tool-chip" href="/tools/url-parser/">URL 解析</a>
							<a class="tool-chip" href="/finance/compound-interest/">复利计算器</a>
							<a class="tool-chip" href="/finance/mortgage/">房贷计算器</a>
							<a class="tool-chip" href="/tools/uuid-generator/">UUID 生成器</a>
							<a class="tool-chip" href="/calculators/standard/">科学计算器</a>
						</div>
						<a class="all-tools-link" href="/tools/">
							<span class="i18n-zh">浏览全部 40+ 个在线工具 →</span>
							<span class="i18n-en">Browse all 40+ tools →</span>
						</a>
					</aside>

					{ADSENSE_CLIENT && AD_SLOTS.bottom && (
						<div class="blog-ad">
							<ins
								class="adsbygoogle"
								style="display:block"
								data-ad-client={ADSENSE_CLIENT}
								data-ad-slot={AD_SLOTS.bottom}
								data-ad-format="auto"
								data-full-width-responsive="true"
							></ins>
							<script is:inline>
								(adsbygoogle = window.adsbygoogle || []).push({});
							</script>
						</div>
					)}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
