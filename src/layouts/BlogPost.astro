---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadingTime from '../components/ReadingTime.astro';
import Header from '../components/Header.astro';
import { buildBlogSearchConfig } from '../components/tools/blogSearchConfig';
import TableOfContents from '../components/blog/TableOfContents.astro';
import SupportBox from '../components/SupportBox.astro';
import { ADSENSE_CLIENT, AD_SLOTS, SITE_TITLE } from '../consts';
import { CALCULATOR_FEATURED, REGISTRY, TOOL_COUNT } from '../tools/registry';
import katexHref from '../styles/katex.css?url';

// The tools card used to say "40+"; a hardcoded count ages into a lie as tools
// ship, so every page that quotes a total takes it from TOOL_COUNT — the single
// registry-derived number (REAL_TOOLS minus the redirect stubs that carry no
// page).
const toolTotal = TOOL_COUNT;

// Astro auto-binds props typing to `interface Props` but not to a `type`
// alias, so headings silently stayed never[] and the TOC filter's `h` was
// untyped (two latent astro-check errors on main; CI never runs it). An
// interface cannot extend the indexed-access `CollectionEntry<'blog'>['data']`
// while replacing the relation fields with resolved cards, so omit those two
// fields and make the binding explicit with a cast.
type RelatedPost = { slug: string; title: string; description: string; contentLang: string };
type Props = Omit<CollectionEntry<'blog'>['data'], 'relatedTools' | 'relatedPosts'> & {
	relatedTools?: string[];
	relatedPosts?: RelatedPost[];
	minutes?: number;
	slug?: string;
	hasMath?: boolean;
	/** render()'s markdown headings, for the TOC (h2/h3 with id attributes). */
	headings?: { depth: number; slug: string; text: string }[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	asOfDate,
	heroImage,
	contentLang,
	relatedTools = [],
	relatedPosts = [],
	minutes,
	slug,
	hasMath,
	headings = [],
} = Astro.props as Props;

const allTools = [...CALCULATOR_FEATURED, ...REGISTRY];
const relatedToolEntries = relatedTools
	.map((key) => {
		const [category, toolSlug] = key.split('/');
		return allTools.find((tool) => tool.category === category && tool.slug === toolSlug);
	})
	.filter((tool): tool is NonNullable<typeof tool> => Boolean(tool))
	.filter((tool) => tool.kind !== 'redirect');

// The Header's search button stays pointed at the blog collection on a reading
// page too, so hopping to a neighbouring article never needs a trip back to the
// list first.
const blogSearchConfig = buildBlogSearchConfig(await getCollection('blog'));

// The document language follows the UI toggle at runtime; content language is
// explicit metadata so assistive technology and crawlers can read the authored
// article language independently of the visitor's interface language.
const pageLang = 'en';

// h2/h3 only: every h1 on the page is the article title itself, and h4+
// entries are noise in a 250px column. Three entries minimum — a two-entry
// TOC is a pair of links, not navigation.
const tocHeadings = headings
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ id: h.slug, text: h.text, depth: h.depth as 2 | 3 }));

const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
// Social card: an authored heroImage wins, otherwise the per-post card that
// og-images.mjs rasterizes into dist/og/<slug>.png at build time.
const socialImage = heroImage
	? typeof heroImage === 'string'
		? heroImage
		: heroImage.src
	: slug
		? `/og/${slug}.png`
		: '/og.png';
const imageUrl = new URL(socialImage, Astro.site).href;

const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description: description,
	datePublished: pubDate.toISOString(),
	...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
	...(asOfDate ? { temporalCoverage: `..${asOfDate.toISOString().slice(0, 10)}` } : {}),
	url: pageUrl,
	image: imageUrl,
	inLanguage: contentLang,
	author: {
		'@type': 'Person',
		name: 'QCSunny',
		url: new URL('/about/', Astro.site).href,
	},
	publisher: {
		'@type': 'Organization',
		name: SITE_TITLE,
		logo: {
			'@type': 'ImageObject',
			url: new URL('/og.png', Astro.site).href,
		},
	},
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': pageUrl,
	},
};
---

<html lang={pageLang}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={socialImage}
			ogType="article"
			publishedTime={pubDate.toISOString()}
		/>
		{ADSENSE_CLIENT && (
			<script is:inline
				async
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
				crossorigin="anonymous"
			></script>
		)}
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
		{
			/* Formulas are already rendered into the HTML by satteri-katex.mjs at
			   build time (see astro.config.mjs), so all that is left to ship is
			   KaTeX's stylesheet and the fonts it references — no JavaScript, no
			   cdn.jsdelivr.net, nothing for a third-party outage to break. The
			   ?url import hands back the hashed, immutably-cached emitted file;
			   hasMath keeps the posts without formulas from loading it. */
		}
		{hasMath && <link rel="stylesheet" href={katexHref} />}
		<style>
			main {
				/* 1140px total container, centred — the GitHub-code-page shape:
				   a fixed reading column plus a utility column beside it, inside
				   one bounded frame, instead of the reading column floating alone
				   in a full-bleed main. The 2em gutter keeps it off the viewport
				   edge on narrow screens, where the frame gracefully loses width
				   before the grid below ever has to re-flow. */
				width: min(var(--w-shell), 100% - 2em);
				max-width: var(--w-shell);
				margin: 0 auto;
				/* 2.5em = 45px above the back-to-blog link, down from 86px of
				   dead space. A post carries no hero image by design (the OG card
				   is the only place that asset is used), so .hero-image below is
				   an empty box and the old 3em here stacked on .prose's 2rem top padding —
				   two layers of top spacing with nothing to separate them from. .prose's is
				   now 0, so this one owns the rhythm on its own. The bottom stays 3em: the
				   article's end spacing and the ad slot below are untouched. */
				padding: 2.5em 0 3em;
				box-sizing: border-box;
			}
			/* reading column + TOC column. At ≥1200px: article left, TOC right
			   (820 text + 48 gap + 250 TOC = 1118 ≤ 1140). Below that the TOC
			   collapses into a disclosure button and, because it is written
			   after the article in the markup, the grid places it in a second
			   row — the areas swap it to the top, where a reader can reach it
			   without scrolling a full article first. */
			.article-grid {
				display: grid;
				grid-template-areas:
					'toc'
					'article';
				grid-template-columns: minmax(0, 1fr);
				gap: 0;
			}
			.article-grid > article {
				grid-area: article;
			}
			.article-grid > :global(.toc) {
				grid-area: toc;
			}
			@media (min-width: 1200px) {
				.article-grid {
					grid-template-areas: 'article toc';
					grid-template-columns: minmax(0, 1fr) 250px;
					column-gap: 3em;
				}
			}
			/* the reading column at ≥1200: 820px is the middle of the requested
			   800–860 band and the figure the 1140 frame actually affords beside
			   a 250px TOC. Below that, the responsive single column —
			   min(840px, 100% − 32px), which is also the post-TOC-collapse
			   width the breakpoint calls for. */
			article {
				/* --w-outer at desk sizes; below the 1200px grid the column is
				   simply as wide as the shell, which is already ≤ the requested
				   min(840px, 100% − 32px) on laptops and phones. */
				width: min(var(--w-outer), 100%);
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
				max-width: var(--w-shell);
				margin: 0 auto;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 14px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				/* .prose fills the article's content box (the --w-outer grid) and
				 * centres the text column inside it with padding: (w-outer −
				 * w-prose)/2 per side. The grid is a touch wider than the text
				 * because a markdown table is display:block + overflow-x:auto —
				 * a grid exactly the text width would clip wide tables inside a
				 * scrollbar even when the viewport could hold them whole. Tables
				 * and code blocks break out to --w-wide from this box (see
				 * global.css). */
				box-sizing: border-box; /* without it the centring padding adds
				 * to the grid width and every breakout below comes out
				 * un-centred */
				width: 100%;
				/* 0 on top: this 2rem used to sit between the hero image and the
				   text, and the hero image is never rendered, so it stacked on
				   main's own top padding into 86px above a single back link. main
				   owns that rhythm now (2.5em). The horizontal centrer padding and the
				   4rem bottom are unchanged. */
				padding: 0 calc((var(--w-outer) - var(--w-prose)) / 2) 4rem;
				color: var(--fg);
				/* 16px / 1.7 — the GitHub-docs body figure. The old value was
				   18px, which at the requested 800–860px column put ~47 CJK
				   glyphs on a line; 16px brings that back to ~52 while the wider
				   column keeps the Latin line near the comfortable maximum. */
				font-size: 1rem;
				line-height: 1.7;
				overflow-wrap: break-word;
				word-break: break-word;
			}
			/* Code blocks and tables break out of the prose measure — the rule
			   lives in global.css, because this <style> is scoped and a
			   descendant selector cannot reach markdown-rendered elements. */
			.back-nav {
				margin-bottom: 2rem;
			}
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4em;
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--dim);
				text-decoration: none;
				transition: color 0.15s ease, transform 0.15s ease;
			}
			.back-link:hover {
				color: var(--accent);
				transform: translateX(-3px);
				text-decoration: none;
			}
			.title {
				margin: 0 0 2.5em;
				padding: 0 0 2em;
				border-bottom: 1px solid var(--gridline);
				text-align: left;
			}
			.title h1 {
				font-size: clamp(1.9rem, 4.8vw, 2.7rem);
				font-weight: 800;
				line-height: 1.3;
				letter-spacing: -0.02em;
				margin: 0.4em 0 0.5em;
				color: var(--fg);
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				align-items: center;
				margin: 0;
				color: var(--dim);
				font-size: 0.85rem;
				font-family: var(--font-mono);
			}
			.meta-chip {
				background: var(--accent-soft);
				color: var(--accent);
				padding: 0.15em 0.5em;
				border-radius: 5px;
				font-weight: 600;
			}
			.lede {
				color: var(--dim);
				font-size: 1.12rem;
				line-height: 1.7;
				margin: 0.8em 0 0;
			}
			.last-updated-on {
				font-style: italic;
			}
			.blog-tools-card {
				margin: 3.5rem 0 1.5rem;
				padding: 1.8rem 2rem;
				border: 1px solid var(--gridline);
				border-radius: 14px;
				background: var(--card);
				box-shadow: var(--box-shadow);
				position: relative;
				overflow: hidden;
			}
			.blog-tools-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 3px;
				background: linear-gradient(90deg, var(--accent) 0%, #8b5cf6 100%);
			}
			.blog-tools-card h3 {
				font-size: 1.18rem;
				font-weight: 700;
				margin-bottom: 0.5em;
				color: var(--fg);
			}
			.blog-tools-card p {
				font-size: 0.94rem;
				color: var(--dim);
				margin-bottom: 1.1em;
				line-height: 1.65;
			}
			.blog-tools-card .tool-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em 0.8em;
				margin-bottom: 1.1em;
			}
			.blog-tools-card .tool-chip {
				display: inline-block;
				padding: 0.4em 0.85em;
				font-size: 0.86rem;
				font-weight: 600;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				text-decoration: none;
				color: var(--fg);
				background: var(--bg);
				transition: border-color 0.15s, color 0.15s, transform 0.15s;
			}
			.blog-tools-card .tool-chip:hover {
				border-color: var(--accent);
				color: var(--accent);
				transform: translateY(-2px);
				text-decoration: none;
			}
			.blog-tools-card .all-tools-link {
				display: inline-flex;
				align-items: center;
				gap: 0.3em;
				font-size: 0.92rem;
				color: var(--accent);
				text-decoration: none;
				font-weight: 700;
			}
			.blog-tools-card .all-tools-link:hover {
				text-decoration: underline;
			}
			.blog-ad {
				margin: 2.5em auto;
				min-height: 120px;
				display: flex;
				justify-content: center;
			}
			.blog-ad .adsbygoogle {
				width: 100%;
			}
		</style>
	</head>

	<body>
		<Header searchConfig={blogSearchConfig} />
		<main>
			<div class="article-grid">
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="back-nav">
						<a class="back-link" href="/blog/">
							← <span class="i18n-zh">返回博客列表</span><span class="i18n-en">Back to Blog</span>
						</a>
					</div>
					<header class="title">
						<p class="meta">
							<span class="meta-chip">
								<span class="i18n-zh">深度长文</span>
								<span class="i18n-en">Article</span>
							</span>
							<FormattedDate date={pubDate} />
							<span aria-hidden="true">·</span>
							{minutes && <ReadingTime minutes={minutes} />}
							{
								updatedDate && (
									<span class="last-updated-on">
										(updated <FormattedDate date={updatedDate} />)
									</span>
								)
							}
						</p>
						<h1 lang={contentLang}>{title}</h1>
						{description && <p class="lede" lang={contentLang}>{description}</p>}
					</header>
					<div class="post-content" lang={contentLang}>
						<slot />
					</div>

					{(relatedToolEntries.length > 0 || relatedPosts.length > 0) && (
						<aside class="blog-tools-card">
							{relatedToolEntries.length > 0 && <>
								<h3><span class="i18n-zh">配套工具</span><span class="i18n-en">Related tools</span></h3>
								<p><span class="i18n-zh">用这些工具把文章中的方法直接跑起来。</span><span class="i18n-en">Try the methods from this article with these tools.</span></p>
								<div class="tool-links">{relatedToolEntries.slice(0, 4).map((tool) => <a class="tool-chip" data-related-tool href={`/${tool.category}/${tool.slug}/`}><span class="i18n-en">{tool.name}</span><span class="i18n-zh">{tool.nameZh || tool.name}</span></a>)}</div>
								<a class="all-tools-link" href="/tools/"><span class="i18n-zh">浏览全部 {toolTotal} 款工具 →</span><span class="i18n-en">Browse all {toolTotal} tools →</span></a>
							</>}
							{relatedPosts.length > 0 && <>
								<h3><span class="i18n-zh">继续阅读</span><span class="i18n-en">Continue reading</span></h3>
								<div class="tool-links">{relatedPosts.slice(0, 3).map((post) => <a class="tool-chip" data-related-post href={`/blog/${post.slug}/`} lang={post.contentLang}>{post.title}</a>)}</div>
							</>}
						</aside>
					)}

					<SupportBox />

					{ADSENSE_CLIENT && AD_SLOTS.bottom && (
						<div class="blog-ad">
							<ins
								class="adsbygoogle"
								style="display:block"
								data-ad-client={ADSENSE_CLIENT}
								data-ad-slot={AD_SLOTS.bottom}
								data-ad-format="auto"
								data-full-width-responsive="true"
							></ins>
							<script is:inline>
								(adsbygoogle = window.adsbygoogle || []).push({});
							</script>
						</div>
					)}
				</div>
			</article>
			<TableOfContents headings={tocHeadings} />
			</div>
		</main>
		<Footer />

		<!-- Copy button per fenced block. Inline, like the AdSense script
		     below, so it stays out of the bundle: no prose page ships a module
		     script (perf-budget.spec.ts pins that), and a dependency here would
		     mean one more third party between a reader and their clipboard.
		     Styles live in global.css — the wrapper is built at runtime and so
		     carries no scope attribute. -->
		<script is:inline>
			(() => {
				const copyText = (text) => {
					if (navigator.clipboard && window.isSecureContext) {
						return navigator.clipboard.writeText(text);
					}
					// http:// and older engines: the fallback path, which a
					// revoked clipboard permission also lands on.
					return new Promise((resolve, reject) => {
						const ta = document.createElement('textarea');
						ta.value = text;
						ta.setAttribute('readonly', '');
						ta.style.cssText = 'position:fixed;top:0;left:-9999px;opacity:0';
						document.body.appendChild(ta);
						ta.select();
						try {
							// execCommand is deprecated (ts 6387); is:inline JS can't use a TS cast
							// to silence it, so Reflect.get avoids statically naming the API.
							Reflect.get(document, 'execCommand').call(document, 'copy') ? resolve() : reject(new Error('copy failed'));
						} catch (err) {
							reject(err);
						} finally {
							ta.remove();
						}
					});
				};

				// Both labels ride the same .i18n-* span pairs the rest of the
				// site does, so CSS alone follows the switch — no language check
				// to get backwards, and no aria-label, which would be static and
				// override the visible text a screen reader already gets.
				const span = (cls, text) => {
					const el = document.createElement('span');
					el.className = cls;
					el.textContent = text;
					return el;
				};
				const pair = (cls, en, zh) => {
					const el = document.createElement('span');
					el.className = cls;
					el.append(span('i18n-en', en), span('i18n-zh', zh));
					return el;
				};

				document.querySelectorAll('.prose pre').forEach((pre) => {
					if (pre.parentElement && pre.parentElement.classList.contains('code-block')) return;

					const wrap = document.createElement('div');
					wrap.className = 'code-block';
					pre.replaceWith(wrap);
					wrap.appendChild(pre);

					const label = pair('code-copy-label', 'Copy', '复制');
					const done = pair('code-copy-done', 'Copied ✓', '已复制 ✓');
					done.hidden = true;

					const btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'code-copy';
					btn.append(label, done);
					wrap.appendChild(btn);

					let timer = 0;
					btn.addEventListener('click', async () => {
						try {
							await copyText(pre.innerText);
							label.hidden = true;
							done.hidden = false;
							btn.classList.add('is-copied');
						} catch {
							// clipboard denied or blocked: leave the button alone
							return;
						}
						clearTimeout(timer);
						timer = setTimeout(() => {
							label.hidden = false;
							done.hidden = true;
							btn.classList.remove('is-copied');
						}, 1800);
					});
				});
			})();
		</script>
	</body>
</html>
