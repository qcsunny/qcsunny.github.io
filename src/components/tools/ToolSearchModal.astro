---
import { getAllSearchItems } from '../../tools/registry';
import type { SearchCategory, SearchConfig, SearchCopy, SearchItem } from './SearchTypes';

// The site-wide search overlay. It is data-driven so a page can search
// anything — the tool registry by default, the blog collection on the blog
// pages — and the visual language is one and the same everywhere. The config
// is built at build time (no fetch), so the first keystroke has data and
// search keeps working offline.
//
// The item shape is deliberately loose (name/desc over slug/description) so
// the tool registry and the blog collection both map onto it without an
// adapter; `slug` and `keywords` are folded into the searchable text.

interface Props {
	/** Absent → the default tool index. Present → search those items instead. */
	config?: SearchConfig;
}

const { config } = Astro.props;

const allTools = getAllSearchItems();

// One chip per registry category — a chip keyed by a category no tool holds
// (the pre-migration 'tools', or the removed 'utilities') filters to nothing
// and leaves every badge as the raw key, so this list is kept in lockstep
// with the CATEGORIES array in registry.ts.
const TOOLS_CATEGORIES: SearchCategory[] = [
	{ key: 'calculators', labelEn: 'Calculators', labelZh: '计算' },
	{ key: 'devtools', labelEn: 'Dev Tools', labelZh: '开发' },
	{ key: 'converters', labelEn: 'Converters', labelZh: '换算' },
	{ key: 'finance', labelEn: 'Finance', labelZh: '金融' },
	{ key: 'text', labelEn: 'Text', labelZh: '文本' },
	{ key: 'security', labelEn: 'Security', labelZh: '安全' },
	{ key: 'office', labelEn: 'Office', labelZh: '办公' },
	{ key: 'daily', labelEn: 'Daily', labelZh: '日常' },
	{ key: 'color', labelEn: 'Color', labelZh: '颜色' },
	{ key: 'seo', labelEn: 'SEO', labelZh: 'SEO' },
	{ key: 'media', labelEn: 'Media', labelZh: '媒体' },
	{ key: 'fun', labelEn: 'Fun', labelZh: '趣味' },
];
const TOOLS_COPY: SearchCopy = {
	placeholderEn: `Search ${allTools.length} tools (e.g. mortgage, irr, tax, uuid, speed)...`,
	placeholderZh: '搜索工具 (支持中英文、拼音、关键词，如 房贷、IRR、个税、换算)...',
	emptyHintEn: 'Try searching with "mortgage", "tax", "json", "speed", "loan"',
	emptyHintZh: '可尝试搜索："房贷"、"个税"、"json"、"速度"、"贷款"等',
	footerLinkHref: '/tools/',
	footerLinkEn: 'Tools Hub',
	footerLinkZh: '前往全部工具库',
	btnAriaEn: 'Search tools (shortcut /)',
	btnAriaZh: '搜索工具 (快捷键 /)',
	btnTitleEn: 'Search tools (/ or Ctrl+K)',
	btnTitleZh: '搜索工具 (快捷键 / 或 Ctrl+K)',
};
// The registry's item shape uses slug/description; the overlay reads name/desc.
const TOOLS_ITEMS: SearchItem[] = allTools.map((t) => ({
	href: t.href,
	slug: t.slug,
	name: t.name,
	nameZh: t.nameZh,
	desc: t.description,
	descZh: t.descriptionZh,
	category: t.category,
	keywords: t.keywords,
}));

const items = config?.items ?? TOOLS_ITEMS;
const categories = config?.categories ?? TOOLS_CATEGORIES;
const copy = config?.copy ?? TOOLS_COPY;
const totalCount = items.length;
// The row payload (84 tools × bilingual text ≈ 17 KB brotli) used to be inlined
// into every page's HTML; it now lives in a build-generated JSON the script
// fetches on open and warms during browser idle (long-cached in _headers, so
// one download per visitor per deployment instead of one per page). The pills
// and counts below still render server-side — that markup is a few hundred
// bytes. Row order in the JSON is load-bearing and mirrors the rehydration in
// the script: [href, name, nameZh, desc, descZh, category, keywords, slug].
const indexUrl = config?.indexUrl ?? '/search-index.json';
---

<div id="site-search-modal" class="sm-overlay" style="display: none;" aria-hidden="true" role="dialog" aria-modal="true"
	aria-label="Site search" data-aria-en="Site search" data-aria-zh="站内搜索" data-index-url={indexUrl}>
	<div class="sm-backdrop" id="sm-backdrop"></div>
	<div class="sm-container">
		<div class="sm-panel">
			<div class="sm-input-row">
				<span class="sm-search-icon" aria-hidden="true">
					<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
						<circle cx="7" cy="7" r="4.6"></circle>
						<path d="M10.4 10.4 L13.8 13.8"></path>
					</svg>
				</span>
				<input
					type="text"
					id="sm-input"
					class="sm-input"
					placeholder={copy.placeholderEn}
					data-placeholder-en={copy.placeholderEn}
					data-placeholder-zh={copy.placeholderZh}
					autocomplete="off"
					spellcheck="false"
				/>
				<button
					type="button"
					id="sm-clear"
					class="sm-clear"
					aria-label="Clear"
					data-aria-en="Clear"
					data-aria-zh="清空"
					style="display: none;">×</button
				>
				<button
					type="button"
					id="sm-close"
					class="sm-close-btn"
					aria-label="Close modal"
					data-aria-en="Close modal"
					data-aria-zh="关闭搜索框">esc</button>
			</div>

			<div class="sm-filter-row">
				<button type="button" class="sm-filter-pill sm-filter-active" data-cat="all">
					<span class="i18n-en">All</span>
					<span class="i18n-zh">全部</span>
					<span class="sm-pill-num">({totalCount})</span>
				</button>
				{categories.map((cat) => (
					<button type="button" class="sm-filter-pill" data-cat={cat.key}>
						<span class="i18n-en">{cat.labelEn}</span>
						<span class="i18n-zh">{cat.labelZh}</span>
					</button>
				))}
			</div>

			<div class="sm-results-area">
				<div id="sm-results-list" class="sm-results-list"></div>

				<div id="sm-empty" class="sm-empty" style="display: none;">
					<p class="sm-empty-text">
						<span class="i18n-en">No results matching "<strong class="sm-empty-q"></strong>"</span>
						<span class="i18n-zh">未找到与 “<strong class="sm-empty-q"></strong>” 相关的内容</span>
					</p>
					<p class="sm-empty-hint">
						<span class="i18n-en">{copy.emptyHintEn}</span>
						<span class="i18n-zh">{copy.emptyHintZh}</span>
					</p>
				</div>
			</div>

			<div class="sm-footer">
				<div class="sm-footer-keys">
					<span><kbd>↑</kbd><kbd>↓</kbd> <span class="i18n-en">Navigate</span><span class="i18n-zh">选择</span></span>
					<span><kbd>Enter</kbd> <span class="i18n-en">Open</span><span class="i18n-zh">打开</span></span>
					<span><kbd>Esc</kbd> <span class="i18n-en">Close</span><span class="i18n-zh">关闭</span></span>
				</div>
				<a href={copy.footerLinkHref} class="sm-footer-all-link">
					<span class="i18n-en">{copy.footerLinkEn}</span>
					<span class="i18n-zh">{copy.footerLinkZh}</span>
				</a>
			</div>
		</div>
	</div>
</div>

<script is:inline>
	(() => {
		const modal = document.getElementById('site-search-modal');
		const backdrop = document.getElementById('sm-backdrop');
		const input = document.getElementById('sm-input');
		const clearBtn = document.getElementById('sm-clear');
		const closeBtn = document.getElementById('sm-close');
		const resultsList = document.getElementById('sm-results-list');
		const emptyEl = document.getElementById('sm-empty');
		const emptyQSpans = document.querySelectorAll('.sm-empty-q');
		const filterPills = Array.from(document.querySelectorAll('.sm-filter-pill'));

		if (!modal || !input) return;

		let selectedCat = 'all';
		let activeIndex = 0;
		let currentItems = [];
		let isComposing = false;
		// Where focus came from, so closing can give it back. Hiding the modal
		// without this leaves the browser holding its now-invisible input as
		// document.activeElement until the next layout pass drops the display:none
		// box; a "/" pressed in that gap reads activeElement as an <input> and the
		// guard below skips the shortcut, so "Esc, then /" silently does nothing.
		// Unannotated on purpose: this is:inline script ships as plain JavaScript,
		// so a TS type here would be a SyntaxError that kills the whole IIFE and
		// leaves window.openSiteSearchModal unset on every page.
		let lastFocused = null;

		// Category lookup: label pair keyed by the data-cat the rows and the
		// pills both carry. Read off the server-rendered pills themselves, so
		// nothing about the categories needs to travel with the script.
		const CAT_MAP = {};
		for (const pill of filterPills) {
			const key = pill.getAttribute('data-cat');
			if (!key || key === 'all') continue;
			CAT_MAP[key] = {
				key,
				labelEn: (pill.querySelector('.i18n-en') || {}).textContent || key,
				labelZh: (pill.querySelector('.i18n-zh') || {}).textContent || key,
			};
		}

		// The index payload: fetched from the build-generated JSON (see
		// search-index.mjs), warmed during browser idle so the first "/" press
		// usually finds it in memory already. Until it lands the list shows a
		// loading row; keystrokes still work — renderResults re-runs when the
		// rows arrive. fetch+cache means one download per visitor per deployment
		// instead of the ~17 KB that used to ride in every page's HTML.
		let idx = null;
		let loadPromise = null;
		const loadIndex = () => {
			if (idx || loadPromise) return loadPromise;
			loadPromise = fetch(modal.dataset.indexUrl || '/search-index.json')
				.then((r) => {
					if (!r.ok) throw new Error('search index ' + r.status);
					return r.json();
				})
				.then((data) => {
					// Positional rows → the object shape this script reads:
					// [href, name, nameZh, desc, descZh, category, keywords, slug].
					// Blog rows ship descZh empty (same paragraph as desc), so
					// fall back rather than matching against "".
					idx = data.rows.map(function (r) {
						return { href: r[0], name: r[1], nameZh: r[2] || r[1], desc: r[3], descZh: r[4] || r[3], category: r[5], keywords: r[6], slug: r[7] };
					});
					// Per-pill counts from the loaded rows: the build-time total only
					// covers "All" (and only the registry), while this modal also serves
					// the blog index — counting here is correct for both.
					const counts = {};
					for (const item of idx) counts[item.category] = (counts[item.category] || 0) + 1;
					for (const pill of filterPills) {
						const key = pill.getAttribute('data-cat');
						const n = key === 'all' ? idx.length : counts[key] || 0;
						let num = pill.querySelector('.sm-pill-num');
						if (!num) {
							num = document.createElement('span');
							num.className = 'sm-pill-num';
							pill.appendChild(num);
						}
						num.textContent = '(' + n + ')';
					}
					renderResults(input.value);
				})
				.catch(() => {
					loadPromise = null; // allow a retry on the next open
				});
			return loadPromise;
		};
		const warm = () => {
			loadIndex();
		};
		if ('requestIdleCallback' in window) requestIdleCallback(warm, { timeout: 3000 });
		else setTimeout(warm, 1500);

		// Placeholder sync with site lang. The two buttons' labels use the same
		// data-* pair as ToolShell's syncLangUI, but that helper only exists on tool
		// pages — this modal also renders inside the blog Header — so the swap lives
		// here, next to the observer that already watches the attribute.
		const syncPlaceholder = () => {
			const isZh = document.documentElement.dataset.lang === 'zh';
			const ph = isZh ? input.dataset.placeholderZh : input.dataset.placeholderEn;
			if (ph) input.placeholder = ph;
			// The dialog itself carries a data-aria pair; querySelectorAll on the
			// modal never includes the modal root, so swap it explicitly first.
			const dlg = (isZh ? modal.dataset.ariaZh : modal.dataset.ariaEn) || modal.dataset.ariaEn;
			if (dlg) modal.setAttribute('aria-label', dlg);
			for (const el of modal.querySelectorAll('[data-aria-en]')) {
				const v = (isZh ? el.dataset.ariaZh : el.dataset.ariaEn) || el.dataset.ariaEn;
				if (v) el.setAttribute('aria-label', v);
			}
		};
		syncPlaceholder();
		// The result rows are built as an HTML string, so they cannot carry
		// .i18n-en/.i18n-zh spans: re-render them when the language changes.
		const onLang = () => {
			syncPlaceholder();
			if (modal.style.display !== 'none') renderResults(input.value);
		};
		new MutationObserver(onLang).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ['data-lang'],
		});
		window.addEventListener('site:lang-change', onLang);

		function openModal(defaultQuery = '') {
			lastFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
			modal.style.display = 'block';
			modal.setAttribute('aria-hidden', 'false');
			document.body.style.overflow = 'hidden';
			if (defaultQuery) {
				input.value = defaultQuery;
			}
			input.focus();
			input.select();
			loadIndex();
			renderResults(input.value);
		}

		function closeModal() {
			modal.style.display = 'none';
			modal.setAttribute('aria-hidden', 'true');
			document.body.style.overflow = '';
			// .focus() lands on document.activeElement synchronously, so the
			// shortcut below never sees the focus this modal just orphaned. It is
			// also the dialog contract: a screen reader user pressing Esc should
			// land back on the trigger, not on an element that stopped rendering.
			if (lastFocused && document.contains(lastFocused)) lastFocused.focus();
		}

		// Expose global open helper for buttons across site
		window.openSiteSearchModal = openModal;

		if (backdrop) backdrop.addEventListener('click', closeModal);
		if (closeBtn) closeBtn.addEventListener('click', closeModal);
		if (clearBtn) clearBtn.addEventListener('click', () => {
			input.value = '';
			clearBtn.style.display = 'none';
			renderResults('');
			input.focus();
		});

		filterPills.forEach((pill) => {
			pill.addEventListener('click', () => {
				filterPills.forEach((p) => p.classList.remove('sm-filter-active'));
				pill.classList.add('sm-filter-active');
				selectedCat = pill.getAttribute('data-cat') || 'all';
				renderResults(input.value);
			});
		});

		// Tab stays inside the dialog while it is open — without this the tab
		// order falls through to the links behind the overlay. The result rows
		// re-render on every keystroke, so the focusable set is gathered on
		// demand; hidden rows/buttons are skipped via offsetParent.
		modal.addEventListener('keydown', (e) => {
			if (e.key !== 'Tab' || modal.style.display === 'none') return;
			const focusables = Array.from(
				modal.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'),
			).filter((el) => el.offsetParent !== null || el === document.activeElement);
			if (focusables.length === 0) return;
			const first = focusables[0];
			const last = focusables[focusables.length - 1];
			if (e.shiftKey && (document.activeElement === first || document.activeElement === modal)) {
				e.preventDefault();
				last.focus();
			} else if (!e.shiftKey && document.activeElement === last) {
				e.preventDefault();
				first.focus();
			}
		});

		function searchItems(query, cat) {
			const q = (query || '').trim().toLowerCase();
			let pool = idx || [];
			if (cat && cat !== 'all') {
				pool = pool.filter((t) => t.category === cat);
			}

			if (!q) {
				// Return first 10 items if query is empty
				return pool.slice(0, 10);
			}

			const tokens = q.split(/\s+/).filter(Boolean);

			// Relevance: a slug/name hit outranks a description mention, so typing
			// "uuid" puts the UUID guide on top even though a password article also
			// says "UUID" in its blurb. Each token must match (AND), but where it
			// lands decides the order. Equal scores keep insertion order, so the
			// ranking is deterministic and never reorders an otherwise-tied pool.
			const score = (item) => {
				const lo = (s) => (s || '').toLowerCase();
				const slug = lo(item.slug);
				const name = lo(item.name);
				const nameZh = lo(item.nameZh);
				const kw = lo(item.keywords);
				const desc = lo(item.desc);
				const descZh = lo(item.descZh);
				const ci = CAT_MAP[item.category];
				const catEn = ci ? ci.labelEn.toLowerCase() : '';
				const catZh = ci ? ci.labelZh.toLowerCase() : '';
				let total = 0;
				for (const token of tokens) {
					if (slug === token) total += 12;
					else if (slug.startsWith(token)) total += 9;
					else if (slug.includes(token)) total += 6;
					if (name === token) total += 6;
					else if (name.startsWith(token)) total += 4;
					else if (name.includes(token)) total += 3;
					if (nameZh && nameZh !== name) {
						if (nameZh === token) total += 6;
						else if (nameZh.startsWith(token)) total += 4;
						else if (nameZh.includes(token)) total += 3;
					}
					// The category key and both its labels match like keywords.
					if ((item.category && item.category === token) || catEn.includes(token) || catZh.includes(token)) total += 2;
					if (kw && kw.includes(token)) total += 2;
					// Description mentions rank last: the haystack still finds
					// them, but a sidebar remark must not beat the real article.
					if (desc && desc.includes(token)) total += 1;
					if (descZh && descZh !== desc && descZh.includes(token)) total += 1;
				}
				return total;
			};

			return pool
				.filter((item) => {
					const ci = CAT_MAP[item.category];
					const catText = ci ? ci.labelEn + ' ' + ci.labelZh : '';
					const full = `${item.slug || ''} ${item.category} ${item.name} ${item.nameZh || ''} ${item.desc} ${item.descZh || ''} ${item.keywords || ''} ${catText}`.toLowerCase();
					return tokens.every((token) => full.includes(token));
				})
				.map((item, idx) => ({ item, score: score(item), idx }))
				.sort((a, b) => b.score - a.score || a.idx - b.idx)
				.map((r) => r.item);
		}

		function renderResults(query) {
			const q = (query || '').trim();
			if (clearBtn) clearBtn.style.display = q ? 'inline-flex' : 'none';

			// Rows still loading (or a failed fetch pending retry): say so in the
			// list instead of flashing "no results", which would read as a lie.
			if (!idx) {
				resultsList.innerHTML =
					'<div class="sm-loading">' +
					'<span class="i18n-en">Loading search index…</span>' +
					'<span class="i18n-zh">正在加载搜索索引…</span>' +
					'</div>';
				emptyEl.style.display = 'none';
				return;
			}

			currentItems = searchItems(q, selectedCat);
			activeIndex = 0;

			if (currentItems.length === 0) {
				resultsList.innerHTML = '';
				emptyQSpans.forEach((el) => { el.textContent = q; });
				emptyEl.style.display = 'block';
				return;
			}

			emptyEl.style.display = 'none';
			const isZh = document.documentElement.dataset.lang === 'zh';

			// Match highlighting: the row text is build-time data, but escape it
			// anyway so a stray < cannot break out of the span, and escape the
			// query tokens separately or a "/" would act as pattern syntax.
			// CJK queries match per-character, which the plain includes() filter
			// above already guaranteed, so the regex only mirrors it visually.
			const esc = (s) => String(s || '').replace(/[&<>"']/g, (c) => ({
				'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
			})[c]);
			const tokens = (query || '').trim().toLowerCase().split(/\s+/).filter(Boolean);
			const hl = tokens.length
				? new RegExp('(' + tokens.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')).join('|') + ')', 'gi')
				: null;
			const mark = (text) => {
				const safe = esc(text);
				return hl ? safe.replace(hl, '<mark class="sm-hl">$1</mark>') : safe;
			};

			resultsList.innerHTML = currentItems
				.map((item, idx) => {
					const ci = CAT_MAP[item.category] || { labelEn: item.category, labelZh: item.category };
					const catLabel = isZh ? ci.labelZh : ci.labelEn;
					const title = isZh && item.nameZh ? item.nameZh : item.name;
					const desc = isZh && item.descZh ? item.descZh : item.desc;
					return `
					<a href="${item.href}" class="sm-item ${idx === 0 ? 'sm-item-active' : ''}" data-index="${idx}">
						<div class="sm-item-body">
							<div class="sm-item-title-row">
								<span class="sm-item-title">${mark(title)}</span>
								<span class="sm-item-badge">${esc(catLabel)}</span>
							</div>
							<div class="sm-item-desc">${mark(desc)}</div>
						</div>
					</a>
				`;
				})
				.join('');

			// Bind hover to active item
			const renderedItems = resultsList.querySelectorAll('.sm-item');
			renderedItems.forEach((el) => {
				el.addEventListener('mouseenter', () => {
					renderedItems.forEach((item) => item.classList.remove('sm-item-active'));
					el.classList.add('sm-item-active');
					activeIndex = Number(el.getAttribute('data-index') || 0);
				});
			});
		}

		function highlightActive() {
			const items = resultsList.querySelectorAll('.sm-item');
			items.forEach((el, idx) => {
				if (idx === activeIndex) {
					el.classList.add('sm-item-active');
					el.scrollIntoView({ block: 'nearest' });
				} else {
					el.classList.remove('sm-item-active');
				}
			});
		}

		input.addEventListener('compositionstart', () => { isComposing = true; });
		input.addEventListener('compositionend', () => {
			isComposing = false;
			renderResults(input.value);
		});
		input.addEventListener('input', () => {
			if (!isComposing) renderResults(input.value);
		});

		// Keyboard navigation inside modal
		input.addEventListener('keydown', (e) => {
			if (currentItems.length === 0) {
				if (e.key === 'Escape') closeModal();
				return;
			}

			if (e.key === 'ArrowDown') {
				e.preventDefault();
				activeIndex = (activeIndex + 1) % currentItems.length;
				highlightActive();
			} else if (e.key === 'ArrowUp') {
				e.preventDefault();
				activeIndex = (activeIndex - 1 + currentItems.length) % currentItems.length;
				highlightActive();
			} else if (e.key === 'Enter') {
				e.preventDefault();
				if (currentItems[activeIndex]) {
					window.location.href = currentItems[activeIndex].href;
				}
			} else if (e.key === 'Escape') {
				e.preventDefault();
				closeModal();
			}
		});

		// Global shortcut listener: '/' and 'Ctrl+K' / 'Cmd+K'
		window.addEventListener('keydown', (e) => {
			const tag = document.activeElement ? document.activeElement.tagName : '';
			const isEditing = ['INPUT', 'TEXTAREA', 'SELECT'].includes(tag) || (document.activeElement && document.activeElement.isContentEditable);

			// If modal is open, let its own handlers work
			if (modal.style.display !== 'none') {
				if (e.key === 'Escape') {
					closeModal();
				}
				return;
			}

			// If there is an on-page input (like on /tools/), prioritize it
			const pageInput = document.getElementById('tool-search-input');

			if (e.key === '/' && !isEditing) {
				e.preventDefault();
				if (pageInput && document.contains(pageInput)) {
					pageInput.focus();
					pageInput.select();
				} else {
					openModal();
				}
			} else if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
				e.preventDefault();
				if (pageInput && document.contains(pageInput)) {
					pageInput.focus();
					pageInput.select();
				} else {
					openModal();
				}
			}
		});

		// Check if URL has ?search= or ?modal=1
		const urlParams = new URLSearchParams(window.location.search);
		if (urlParams.get('modal') === '1') {
			openModal(urlParams.get('q') || '');
		}
	})();
</script>

