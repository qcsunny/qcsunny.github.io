---
// Shared dynamic tool page body for the category routes that have no static
// page of their own. Every registry entry resolves here: ToolShell wraps the
// tool, main.ts finds and hydrates it. The text-config branch (textarea +
// transforms) is what the form-only categories (finance/converters) do not
// need, so those keep their own thin [slug].astro; this component serves the
// text-heavy categories (devtools, office, security, text, media, color, seo,
// fun, daily).
//
// The dispatcher <script>import '../../scripts/tools/main'</script> is kept in
// the 12 route files on purpose, NOT here: Vite names a single-owner inline
// script after the .astro file that contains it, and only dedupes *identical
// owners* into one shared chunk — that dedupe is what names it main.<hash>.js.
// Pulled into this component the chunk was renamed after it and lost its
// modulepreload hint, so the first interactive byte went back on the entry →
// chunk → engine chain. perf-budget.spec pins both halves.
import ToolShell from './ToolShell.astro';
import { type ToolCategory, type ToolEntry, type TextConfig } from '../../tools/registry';

interface Props {
	entry: ToolEntry;
	category: ToolCategory;
}

const { entry, category } = Astro.props;
const redirect = entry.kind === 'redirect' ? entry.config.target : undefined;
const textConfig = entry.kind === 'text' ? (entry.config as TextConfig) : undefined;
---

<ToolShell
	title={entry.name}
	description={entry.description}
	entry={redirect ? undefined : entry}
	category={category}
	redirectTo={redirect}
>
	{
		!redirect && (
			<>
				<div id="t-root">
					{textConfig && (
						<>
							<textarea
								class={textConfig.mono ? 't-textarea t-mono' : 't-textarea'}
								rows="6"
								spellcheck="false"
								data-role="input"
								placeholder={textConfig.placeholder}
								data-placeholder-en={textConfig.placeholder}
								data-placeholder-zh={textConfig.placeholderZh}
								aria-label="Text input"
								data-aria-en="Text input"
								data-aria-zh="文本输入"
							>{textConfig.def ?? ''}</textarea>
							{textConfig.stats && (
								<>
									<span class="t-label t-stats-label">
										<span class="i18n-en">Statistics</span>
										<span class="i18n-zh">统计数据</span>
									</span>
									<div class="t-results" />
								</>
							)}
							{textConfig.transforms && textConfig.transforms.length > 0 && (
								<>
									<div class="t-btnrow">
										{textConfig.transforms.map((t) => (
										<button type="button" class="t-btn" disabled>
											{t.labelZh && t.labelZh !== t.label ? (
												<>
													<span class="i18n-en">{t.label}</span>
													<span class="i18n-zh">{t.labelZh}</span>
												</>
											) : (
												// identical in both languages: a bare text node, NOT a lone
												// .i18n-en span — the global CSS hides .i18n-en in the Chinese
												// view, which left these buttons blank (csv-json-converter).
												t.label
											)}
										</button>
									))}
									</div>
									<span class="t-label t-out-label">
										<span class="i18n-en">Output</span>
										<span class="i18n-zh">转换输出</span>
									</span>
									<textarea
										class="t-textarea t-mono t-out"
										rows="8"
										readonly
										data-role="output"
										aria-label="Output"
										data-aria-en="Output"
										data-aria-zh="输出"
									/>
									<p class="t-error" />
								</>
							)}
						</>
					)}
				</div>
			</>
		)
	}
</ToolShell>
