---
// Shared lightweight shell for every tool page and tool index:
//  - minimal top bar: site name → home, breadcrumb (Tools › Category › Page), theme toggle
//  - three-state theme (light / dark / auto) with pre-paint inline script,
//    persisted under the shared key "site:theme"
//  - t-prefixed global styles (runtime-built DOM never gets the scoped
//    data-astro-cid attribute, so is:global is required)
import BaseHead from '../BaseHead.astro';
import { ADSENSE_CLIENT, AD_SLOTS, SITE_TITLE } from '../../consts';
import {
	CALCULATOR_FEATURED,
	REGISTRY,
	categoryLabel,
	type ToolCategory,
	type ToolContent,
	type ToolEntry,
} from '../../tools/registry';

interface Props {
	title: string;
	description: string;
	/** registry entry (tool pages); omit for index pages */
	entry?: ToolEntry;
	/** breadcrumb category link; omit on the Tools hub */
	category?: ToolCategory;
	/** when set, renders a meta-refresh redirect page instead of the shell body */
	redirectTo?: string;
	/** editorial content (SEO); defaults to the entry's own content */
	content?: ToolContent;
}

const { title, description, entry, category, redirectTo } = Astro.props;
const kind = entry?.kind;
const crumbName = entry ? entry.name : title;
const content = Astro.props.content ?? entry?.content;
const pageTitle = entry
	? (entry.nameZh ? `${entry.name} (${entry.nameZh})` : entry.name)
	: title;

// --- related tools: same category, real pages only, never self ---
// entry-less pages (standard/graph) fall back to the category prop.
const relatedCategory = entry?.category ?? category;
const relatedPool = relatedCategory
	? [...CALCULATOR_FEATURED, ...REGISTRY].filter(
			(e) => e.category === relatedCategory && e.kind !== 'redirect' && e.slug !== entry?.slug,
		)
	: [];
const related = relatedPool.slice(0, 4);

// --- JSON-LD structured data ---
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd: object[] = [];
{
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		name: pageTitle,
		alternateName: entry?.nameZh,
		description: entry ? entry.description : description,
		url: pageUrl,
		applicationCategory: 'UtilitiesApplication',
		operatingSystem: 'Web browser',
		browserRequirements: 'Requires JavaScript',
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	});
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Tools', item: new URL('/tools/', Astro.site).href },
			...(category
				? [
						{
							'@type': 'ListItem',
							position: 2,
							name: categoryLabel(category),
							item: new URL(`/${category}/`, Astro.site).href,
						},
					]
				: []),
			{ '@type': 'ListItem', position: category ? 3 : 2, name: crumbName, item: pageUrl },
		],
	});
	if (content?.faq?.length) {
		jsonLd.push({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: content.faq.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		});
	}
}
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-tool-kind={kind} data-tool-category={category} data-tool-slug={entry?.slug}>
	<head>
		<BaseHead
			title={pageTitle}
			description={description}
			canonical={redirectTo ?? undefined}
		/>
		{redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
		{ADSENSE_CLIENT && (
			<script
				async
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
				crossorigin="anonymous"
			></script>
		)}
		{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
		<script is:inline>
			// Apply theme before first paint to avoid a flash.
			// Shared across all tool pages via one preference key.
			const saved = localStorage.getItem('site:theme');
			const mode = saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
			document.documentElement.dataset.themeMode = mode;
			document.documentElement.dataset.theme =
				mode === 'auto'
					? matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light'
					: mode;

			// Language pre-paint initialization
			const savedLang = localStorage.getItem('site:lang') || (navigator.language.startsWith('zh') ? 'zh' : 'en');
			document.documentElement.dataset.lang = savedLang;
			document.documentElement.lang = savedLang === 'zh' ? 'zh-CN' : 'en';
		</script>
		<style is:global>
			/* theme tokens (--bg/--fg/…) are defined globally in global.css,
			   shared with the blog side; html[data-theme] drives dark mode */
			* {
				margin: 0;
				padding: 0;
			}
			body {
				background: var(--bg);
				color: var(--fg);
				min-height: 100dvh;
				font-family:
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					'Helvetica Neue',
					Arial,
					'PingFang SC',
					'Microsoft YaHei',
					'Noto Sans CJK SC',
					sans-serif;
				-webkit-font-smoothing: antialiased;
				font-size: 16px;
				line-height: 1.5;
			}

			/* --- top bar --- */
			.t-topbar {
				display: flex;
				align-items: center;
				gap: 1em;
				min-height: 3.25em;
				padding: 0 1em;
				border-bottom: 1px solid var(--gridline);
				flex-wrap: wrap;
			}
			.t-site {
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--fg);
				text-decoration: none;
				padding: 0.6em 0;
			}
			.t-site:hover {
				color: var(--accent);
			}
			.t-crumbs {
				display: flex;
				align-items: center;
				gap: 0.45em;
				font-size: 0.85rem;
				color: var(--dim);
				min-width: 0;
			}
			.t-crumbs a {
				color: var(--dim);
				text-decoration: none;
			}
			.t-crumbs a:hover {
				color: var(--accent);
			}
			.t-crumbs .t-crumb-sep {
				opacity: 0.6;
			}
			.t-crumbs [aria-current='page'] {
				color: var(--fg);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.t-topbar-actions {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.t-lang {
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--dim);
				background: transparent;
				border: 1px solid var(--gridline);
				border-radius: 6px;
				font-family: inherit;
				cursor: pointer;
				padding: 0.25em 0.55em;
				line-height: 1.2;
				transition:
					opacity 0.15s ease,
					border-color 0.15s ease,
					color 0.15s ease;
			}
			.t-lang:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.t-lang:focus-visible {
				outline: 2px solid currentColor;
			}
			.t-theme {
				font-size: 0.95rem;
				opacity: 0.5;
				color: var(--fg);
				background: none;
				border: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0.4em 0.6em;
			}
			.t-theme:hover {
				opacity: 1;
			}
			.t-theme:focus-visible {
				outline: 2px solid currentColor;
				opacity: 1;
			}

			/* --- bilingual content display --- */
			html[data-lang='zh'] .t-content-en {
				display: none;
			}
			html[data-lang='en'] .t-content-zh {
				display: none;
			}
			html[data-lang='zh'] .t-content:not(:has(.t-content-zh)) .t-content-en {
				display: block !important;
			}

			/* --- content --- */
			.t-main {
				width: min(720px, 100% - 2em);
				margin: 0 auto;
				padding: 1.75em 0 3.5em;
			}
			/* global.css colors every h1 near-black — override explicitly */
			.t-title {
				color: var(--fg);
				font-size: clamp(1.4rem, 4vw, 1.9rem);
				font-weight: 700;
				margin-bottom: 0.4em;
			}
			.t-title-zh {
				font-size: 0.8em;
				font-weight: 500;
				opacity: 0.85;
				margin-left: 0.25em;
			}
			.t-intro {
				color: var(--dim);
				font-size: 0.92rem;
				margin-bottom: 1.25em;
			}

			/* --- forms --- */
			.t-form {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 0.9em 1.1em;
				margin-bottom: 1.25em;
			}
			.t-field {
				display: flex;
				flex-direction: column;
				gap: 0.3em;
			}
			.t-field > label {
				font-size: 0.82rem;
				color: var(--dim);
			}
			.t-field .t-suffix {
				opacity: 0.7;
			}
			.t-field input,
			.t-field select {
				font: inherit;
				font-size: 0.95rem;
				padding: 0.45em 0.6em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-field input:focus-visible,
			.t-field select:focus-visible,
			.t-check:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-field .t-hint {
				font-size: 0.75rem;
				color: var(--dim);
			}
			.t-field.t-wide {
				grid-column: 1 / -1;
			}
			.t-field input[type='checkbox'],
			.t-check {
				width: 1.05em;
				height: 1.05em;
				accent-color: var(--accent);
			}
			.t-checkrow {
				display: flex;
				align-items: center;
				gap: 0.45em;
				font-size: 0.9rem;
				color: var(--fg);
			}
			.t-btn {
				font: inherit;
				font-size: 0.92rem;
				padding: 0.45em 1em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
				cursor: pointer;
			}
			.t-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.t-btn:focus-visible {
				outline: 2px solid var(--accent);
			}
			.t-btn.t-primary {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--on-accent);
				font-weight: 600;
			}
			.t-btn.t-primary:hover {
				opacity: 0.9;
				color: var(--on-accent);
			}
			.t-btnrow {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-bottom: 1em;
			}

			/* --- results --- */
			.t-results {
				border: 1px solid var(--gridline);
				border-radius: 10px;
				padding: 0.9em 1.1em;
				display: flex;
				flex-direction: column;
				gap: 0.45em;
			}
			.t-results:empty {
				display: none;
			}
			.t-row {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				font-size: 0.95rem;
			}
			.t-row .t-row-label {
				color: var(--dim);
			}
			.t-row .t-row-value {
				font-variant-numeric: tabular-nums;
				font-weight: 600;
				text-align: right;
				overflow-wrap: anywhere;
			}
			.t-row.t-emph {
				font-size: 1.05rem;
			}
			.t-row.t-emph .t-row-label {
				color: var(--fg);
			}
			.t-row.t-emph .t-row-value {
				color: var(--accent);
				font-size: 1.25rem;
			}
			.t-note {
				font-size: 0.85rem;
				color: var(--dim);
				margin-top: 0.5em;
			}
			.t-tablewrap {
				overflow-x: auto;
				margin-top: 1.25em;
			}
			.t-table {
				border-collapse: collapse;
				width: 100%;
				font-size: 0.88rem;
				font-variant-numeric: tabular-nums;
			}
			.t-table th,
			.t-table td {
				text-align: right;
				padding: 0.4em 0.6em;
				border-top: 1px solid var(--gridline);
				white-space: nowrap;
			}
			.t-table th:first-child,
			.t-table td:first-child {
				text-align: left;
			}
			.t-table thead th {
				border-top: none;
				color: var(--dim);
				font-weight: 600;
			}

			/* --- text tools --- */
			.t-textarea {
				width: 100%;
				box-sizing: border-box;
				font: inherit;
				font-size: 0.95rem;
				padding: 0.6em 0.75em;
				border: 1px solid var(--gridline);
				border-radius: 10px;
				background: var(--bg);
				color: var(--fg);
				resize: vertical;
			}
			.t-textarea:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-textarea.t-mono,
			.t-out {
				font-family:
					ui-monospace,
					'SFMono-Regular',
					Consolas,
					Menlo,
					'PingFang SC',
					'Microsoft YaHei',
					monospace;
				font-size: 0.88rem;
			}
			.t-out {
				min-height: 6em;
				white-space: pre;
				overflow-wrap: normal;
				overflow-x: auto;
			}
			.t-error {
				font-size: 0.85rem;
				color: var(--accent);
				margin-top: 0.5em;
			}
			.t-label {
				display: block;
				font-size: 0.82rem;
				color: var(--dim);
				margin: 1em 0 0.35em;
			}

			/* --- converter (two-sided unit conversion + live keyword search) --- */
			.t-conv {
				display: flex;
				flex-direction: column;
				gap: 0.75em;
				margin-bottom: 1.5em;
			}
			.t-conv-row {
				display: flex;
				gap: 0.6em;
				align-items: center;
			}
			.t-conv-row label {
				flex: none;
				width: 3.4em;
				font-size: 0.82rem;
				color: var(--dim);
			}
			.t-conv-row .t-conv-val {
				flex: 1 1 130px;
				min-width: 0;
				font: inherit;
				font-size: 0.95rem;
				padding: 0.45em 0.6em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
				font-variant-numeric: tabular-nums;
			}
			.t-conv-picker {
				flex: 2 1 250px;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 0.3em;
			}
			.t-conv-search-box {
				position: relative;
				display: flex;
				align-items: center;
			}
			.t-conv-search-input {
				width: 100%;
				font: inherit;
				font-size: 0.82rem;
				padding: 0.32em 1.8em 0.32em 0.6em;
				border: 1px dashed var(--gridline);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-conv-search-input:focus {
				outline: none;
				border-color: var(--accent);
				border-style: solid;
			}
			.t-conv-search-clear {
				position: absolute;
				right: 0.35em;
				background: none;
				border: none;
				color: var(--dim);
				cursor: pointer;
				font-size: 0.95rem;
				padding: 0.1em 0.3em;
				line-height: 1;
			}
			.t-conv-search-clear:hover {
				color: var(--fg);
			}
			.t-conv-select {
				width: 100%;
				font: inherit;
				font-size: 0.92rem;
				padding: 0.45em 0.5em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-conv-select:focus-visible,
			.t-conv-row .t-conv-val:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-conv-swap {
				align-self: flex-start;
				margin-left: 4em;
			}
			.t-conv-note {
				font-size: 0.84rem;
				color: var(--dim);
				padding: 0.2em 0;
			}
			@media (max-width: 560px) {
				.t-conv-row {
					flex-wrap: wrap;
				}
				.t-conv-row label {
					width: 100%;
				}
				.t-conv-picker {
					width: 100%;
				}
				.t-conv-swap {
					margin-left: 0;
				}
			}

			/* --- all-units live conversion grid with search filter --- */
			.t-conv-live {
				margin-top: 1.5em;
				border: 1px solid var(--gridline);
				border-radius: 10px;
				padding: 1.1em 1.25em;
				background: var(--bg);
			}
			.t-conv-live-header {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.8em;
				margin-bottom: 1em;
			}
			.t-conv-live-title {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--fg);
			}
			.t-conv-live-searchbox {
				position: relative;
				display: flex;
				align-items: center;
				flex: 1 1 240px;
				max-width: 360px;
			}
			.t-conv-live-filter {
				width: 100%;
				font: inherit;
				font-size: 0.86rem;
				padding: 0.4em 1.8em 0.4em 0.7em;
				border: 1px solid var(--gridline);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-conv-live-filter:focus {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-conv-live-clear {
				position: absolute;
				right: 0.4em;
				background: none;
				border: none;
				color: var(--dim);
				cursor: pointer;
				font-size: 0.95rem;
				padding: 0 0.3em;
				line-height: 1;
			}
			.t-conv-live-clear:hover {
				color: var(--fg);
			}
			.t-conv-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 0.75em;
			}
			.t-conv-card {
				border: 1px solid var(--gridline);
				border-radius: 8px;
				padding: 0.7em 0.85em;
				background: var(--bg);
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				transition: border-color 0.15s, box-shadow 0.15s;
			}
			.t-conv-card:hover {
				border-color: var(--accent);
			}
			.t-conv-card.is-active-from {
				border-color: var(--accent);
				box-shadow: 0 0 0 1px var(--accent);
			}
			.t-conv-card.is-active-to {
				border-color: #10b981;
				box-shadow: 0 0 0 1px #10b981;
			}
			.t-conv-card-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 0.5em;
				font-size: 0.8rem;
				color: var(--dim);
			}
			.t-conv-card-name {
				font-weight: 500;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.t-conv-card-short {
				font-family: var(--font-mono, monospace);
				font-size: 0.75rem;
				opacity: 0.85;
				flex-shrink: 0;
			}
			.t-conv-card-val {
				font-size: 1.12rem;
				font-weight: 600;
				color: var(--fg);
				font-variant-numeric: tabular-nums;
				word-break: break-all;
			}
			.t-conv-card-actions {
				display: flex;
				gap: 0.45em;
				margin-top: 0.2em;
			}
			.t-conv-act-btn {
				font: inherit;
				font-size: 0.72rem;
				padding: 0.25em 0.55em;
				border: 1px solid var(--gridline);
				border-radius: 4px;
				background: transparent;
				color: var(--dim);
				cursor: pointer;
				transition: all 0.12s;
			}
			.t-conv-act-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.t-conv-empty {
				grid-column: 1 / -1;
				text-align: center;
				color: var(--dim);
				font-size: 0.88rem;
				padding: 2em 1em;
			}

			/* --- generators (password / uuid / random) --- */
.t-lenrow {
	display: flex;
	align-items: center;
	gap: 0.8em;
	margin-bottom: 0.9em;
}
.t-lenrow input[type='range'] {
	flex: 1;
	accent-color: var(--accent);
}
.t-lenrow output {
	min-width: 2.4em;
	text-align: right;
	font-weight: 600;
	font-variant-numeric: tabular-nums;
}
.t-checkrow-group {
	display: flex;
	flex-wrap: wrap;
	gap: 0.4em 1.2em;
	margin-bottom: 0.9em;
}
.t-passout {
	width: 100%;
	box-sizing: border-box;
	font-family:
					ui-monospace,
					'SFMono-Regular',
					Consolas,
					Menlo,
					'PingFang SC',
					'Microsoft YaHei',
					monospace;
	font-size: 1.05rem;
	padding: 0.55em 0.7em;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	background: var(--bg);
	color: var(--fg);
	letter-spacing: 0.03em;
	margin-bottom: 0.9em;
}
.t-passout:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -1px;
}
.t-btnwrap {
	display: inline-flex;
	align-items: center;
	gap: 0.55em;
}
.t-copy-hint {
	font-size: 0.82rem;
	color: var(--dim);
}
.t-countlabel {
	font-size: 0.82rem;
	color: var(--dim);
	align-self: center;
}
.t-countlabel + input {
	width: 6em;
}

/* --- color converter --- */
.t-colorgroups {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
	gap: 0.9em 1.1em;
	margin-bottom: 1.25em;
}
.t-colorfield {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
}
.t-colorgrouplabel {
	font-size: 0.82rem;
	color: var(--dim);
}
.t-colorrow {
	display: flex;
	gap: 0.5em;
}
.t-colorcell {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 0.15em;
	font-size: 0.75rem;
	color: var(--dim);
	text-align: center;
}
.t-colorcell input {
	width: 100%;
	box-sizing: border-box;
	font: inherit;
	font-size: 0.95rem;
	padding: 0.45em 0.3em;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	background: var(--bg);
	color: var(--fg);
	text-align: center;
	font-variant-numeric: tabular-nums;
}
.t-colorcell input:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -1px;
}
.t-swatchrow {
	display: flex;
	gap: 1em;
	margin-bottom: 1.25em;
}
.t-swatchwrap {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
	font-size: 0.82rem;
	color: var(--dim);
}
.t-swatch {
	width: 100px;
	height: 68px;
	border: 1px solid var(--gridline);
	border-radius: 10px;
}

/* --- QR generator --- */
.t-qrsettings {
	display: grid;
	grid-template-columns: 2fr 1fr;
	gap: 0.9em 1.1em;
	margin-bottom: 0.6em;
}
.t-eccfield select {
	font: inherit;
	font-size: 0.95rem;
	padding: 0.45em 0.5em;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	background: var(--bg);
	color: var(--fg);
	width: 100%;
	box-sizing: border-box;
}
.t-qr-canvas {
	max-width: 100%;
	height: auto;
	display: block;
	margin: 0.6em 0;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	image-rendering: pixelated;
}
@media (max-width: 560px) {
	.t-qrsettings {
		grid-template-columns: 1fr;
	}
}

/* --- Workbench layout (JSON, SQL, JWT, URL, XML, CSS, HTML) --- */
html[data-tool-kind='json'] .t-main,
html[data-tool-kind='sql'] .t-main,
html[data-tool-kind='jwt'] .t-main,
html[data-tool-kind='url'] .t-main,
html[data-tool-kind='xml'] .t-main,
html[data-tool-kind='css'] .t-main,
html[data-tool-kind='html'] .t-main {
	width: min(1040px, 100% - 2em);
}
.t-json-wrap {
	display: flex;
	flex-direction: column;
	gap: 0.85em;
	margin-bottom: 2em;
}
.t-json-toolbar {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5em;
	align-items: center;
	padding: 0.6em 0.8em;
	background: var(--bg);
	border: 1px solid var(--gridline);
	border-radius: 10px;
}
.t-json-toolbar .t-sep {
	width: 1px;
	height: 1.5em;
	background: var(--gridline);
	margin: 0 0.25em;
}
.t-json-status {
	display: flex;
	align-items: center;
	padding: 0.6em 0.9em;
	border-radius: 8px;
	font-size: 0.85rem;
	font-family: ui-monospace, 'SFMono-Regular', Consolas, Menlo, monospace;
	border: 1px solid var(--gridline);
	background: var(--bg);
	color: var(--dim);
	transition: all 0.2s ease;
	line-height: 1.4;
}
.t-json-status.is-valid {
	border-color: #10b981;
	color: #059669;
	background: rgba(16, 185, 129, 0.08);
}
.t-json-status.is-error {
	border-color: #ef4444;
	color: #dc2626;
	background: rgba(239, 68, 68, 0.08);
}
.t-json-panels {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1em;
}
@media (max-width: 768px) {
	.t-json-panels {
		grid-template-columns: 1fr;
	}
}
.t-json-panel {
	display: flex;
	flex-direction: column;
	gap: 0.45em;
}
.t-json-panel-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-size: 0.85rem;
	color: var(--dim);
}
.t-json-editor {
	width: 100%;
	height: 440px;
	box-sizing: border-box;
	font-family: ui-monospace, 'SFMono-Regular', Consolas, Menlo, monospace;
	font-size: 0.9rem;
	line-height: 1.5;
	padding: 0.75em;
	border: 1px solid var(--gridline);
	border-radius: 10px;
	background: var(--bg);
	color: var(--fg);
	resize: vertical;
	tab-size: 2;
}
.t-json-editor:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -1px;
}

/* --- index cards --- */
			.t-cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 0.9em;
			}
			.t-card {
				display: block;
				padding: 0.9em 1em;
				border: 1px solid var(--gridline);
				border-radius: 10px;
				text-decoration: none;
				color: var(--fg);
				background: var(--bg);
			}
			.t-card:hover {
				border-color: var(--accent);
			}
			.t-card:focus-visible {
				outline: 2px solid var(--accent);
			}
			.t-card h2,
			.t-card h3 {
				color: var(--fg);
				font-size: 1rem;
				font-weight: 600;
				margin-bottom: 0.25em;
			}
			.t-card p {
				color: var(--dim);
				font-size: 0.82rem;
				line-height: 1.45;
			}
			.t-section {
				margin-top: 2.25em;
			}
			.t-section:first-of-type {
				margin-top: 1.5em;
			}
			.t-section > h2 {
				color: var(--fg);
				font-size: 1.2rem;
				font-weight: 700;
				margin-bottom: 0.35em;
			}
			.t-section > .t-section-blurb {
				color: var(--dim);
				font-size: 0.88rem;
				margin-bottom: 0.9em;
			}

			/* --- moved (redirect) page --- */
			.t-moved {
				padding: 3em 1em;
				text-align: center;
			}
			.t-moved p {
				color: var(--dim);
				margin-bottom: 1em;
			}
			.t-moved a {
				color: var(--accent);
			}

			/* --- related links --- */
			.t-related {
				margin-top: 2.5em;
				font-size: 0.85rem;
				color: var(--dim);
			}
			.t-related a {
				color: var(--accent);
			}

			/* --- editorial content (SEO, bilingual) --- */
			.t-content {
				margin-top: 2.5em;
				font-size: 0.95rem;
				line-height: 1.65;
			}
			.t-content > p {
				margin-bottom: 0.9em;
			}
			.t-content h2,
			.t-faq h2,
			.t-faq h3,
			.t-content-zh h2,
			.t-related-page h2 {
				color: var(--fg);
				font-size: 1.15rem;
				font-weight: 700;
				margin: 1.4em 0 0.5em;
			}
			.t-faq details {
				border: 1px solid var(--gridline);
				border-radius: 8px;
				margin-bottom: 0.5em;
				padding: 0.55em 0.9em;
			}
			.t-faq summary {
				cursor: pointer;
				font-weight: 600;
				color: var(--fg);
			}
			.t-faq summary:hover {
				color: var(--accent);
			}
			.t-faq details p {
				margin-top: 0.5em;
				color: var(--dim);
				font-size: 0.9rem;
				line-height: 1.8;
			}

			/* --- Chinese section: taller rhythm, justified, CJK-aware --- */
			.t-content-zh {
				margin-top: 1.8em;
				padding-top: 0.4em;
				border-top: 1px dashed var(--gridline);
				line-height: 1.9;
				text-align: justify;
				hanging-punctuation: first;
			}
			.t-content-zh h2,
			.t-content-zh h3 {
				font-size: 1.1rem;
				letter-spacing: 0.04em;
			}
			.t-content-zh summary {
				letter-spacing: 0.02em;
			}
			.t-content-zh details p {
				text-align: left;
			}

			/* --- page-level related tools (SEO internal links) --- */
			.t-related-page {
				margin-top: 2.5em;
				padding-top: 1.2em;
				border-top: 1px solid var(--gridline);
			}
			.t-related-page h2 {
				color: var(--fg);
				font-size: 1.15rem;
				font-weight: 700;
				margin: 0 0 0.6em;
			}
			.t-related-page ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 0.45em 1.2em;
			}
			.t-related-page a {
				color: var(--accent);
				text-decoration: none;
				font-size: 0.92rem;
			}
			.t-related-page a:hover {
				text-decoration: underline;
			}

			/* --- ad slots: fixed min-height reserves space, so a late-loading
			     ad never shifts the layout (CLS). Keep in sync with real units. --- */
			.t-ad {
				margin: 2em auto;
				min-height: 100px;
				display: flex;
				justify-content: center;
			}
			.t-ad-bottom {
				min-height: 120px;
			}
			.t-ad .adsbygoogle {
				width: 100%;
			}

			/* --- footer --- */
			.t-foot {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em 1.5em;
				padding: 1.2em 1em 2em;
				border-top: 1px solid var(--gridline);
				font-size: 0.82rem;
				color: var(--dim);
			}
			.t-foot nav {
				display: flex;
				gap: 1.2em;
			}
			.t-foot a {
				color: var(--dim);
				text-decoration: none;
			}
			.t-foot a:hover {
				color: var(--accent);
			}

			@media (max-width: 560px) {
				.t-crumbs {
					order: 3;
					flex-basis: 100%;
				}
				.t-theme {
					margin-left: auto;
				}
			}
		</style>
	</head>
	<body>
		{
			redirectTo ? (
				<main class="t-moved">
					<h1 class="t-title">{title} has moved</h1>
					<p>
						This page now lives at <a href={redirectTo}>{redirectTo}</a>. Redirecting…
					</p>
				</main>
			) : (
				<>
					<header class="t-topbar">
						<a class="t-site" href="/">{SITE_TITLE}</a>
						<nav class="t-crumbs" aria-label="Breadcrumb">
							<a href="/tools/"><span class="i18n-en">Tools</span><span class="i18n-zh">工具库</span></a>
							{category && (
								<>
									<span class="t-crumb-sep" aria-hidden="true">›</span>
									<a href={`/${category}/`}>{categoryLabel(category)}</a>
								</>
							)}
							{crumbName !== 'Tools' && (
								<>
									<span class="t-crumb-sep" aria-hidden="true">›</span>
									<span aria-current="page">{crumbName}</span>
								</>
							)}
						</nav>
						<div class="t-topbar-actions">
							<button class="t-lang" type="button" aria-label="切换中英文 / Switch language">中 / EN</button>
							<button class="t-theme" type="button" aria-label="Toggle light / dark theme">☾</button>
						</div>
					</header>
					<main class="t-main">
						<h1 class="t-title">{crumbName}{entry?.nameZh && <span class="t-title-zh">（{entry.nameZh}）</span>}</h1>
						{entry?.kind === 'form' && entry.config.intro && <p class="t-intro">{entry.config.intro}</p>}
						<slot />
						{ADSENSE_CLIENT && AD_SLOTS.mid && (
							<div class="t-ad t-ad-mid">
								<ins
									class="adsbygoogle"
									style="display:block"
									data-ad-client={ADSENSE_CLIENT}
									data-ad-slot={AD_SLOTS.mid}
									data-ad-format="auto"
									data-full-width-responsive="true"
								></ins>
								<script is:inline>
									(adsbygoogle = window.adsbygoogle || []).push({});
								</script>
							</div>
						)}
						{content && (content.about?.length || content.faq?.length || content.aboutZh?.length) && (
							<article class="t-content">
								<div class="t-content-en">
									{content.about?.map((para) => <p>{para}</p>)}
									{content.faq?.length ? (
										<section class="t-faq">
											<h2>Frequently asked questions</h2>
											{content.faq.map((f) => (
												<details>
													<summary>{f.q}</summary>
													<p>{f.a}</p>
												</details>
											))}
										</section>
									) : null}
								</div>
								{content.aboutZh?.length || content.faqZh?.length ? (
									<section class="t-content-zh" lang="zh-CN">
										<h2>中文说明</h2>
										{content.aboutZh?.map((para) => <p>{para}</p>)}
										{content.faqZh?.length ? (
											<section class="t-faq">
												<h3>常见问题</h3>
												{content.faqZh.map((f) => (
													<details>
														<summary>{f.q}</summary>
														<p>{f.a}</p>
													</details>
												))}
											</section>
										) : null}
									</section>
								) : null}
							</article>
						)}
						{related.length ? (
							<nav class="t-related-page" aria-label="Related tools">
								<h2>Related tools</h2>
								<ul>
									{related.map((e) => (
										<li>
											<a href={`/${e.category}/${e.slug}/`}>{e.name}</a>
										</li>
									))}
								</ul>
							</nav>
						) : null}
						{ADSENSE_CLIENT && AD_SLOTS.bottom && (
							<div class="t-ad t-ad-bottom">
								<ins
									class="adsbygoogle"
									style="display:block"
									data-ad-client={ADSENSE_CLIENT}
									data-ad-slot={AD_SLOTS.bottom}
									data-ad-format="auto"
									data-full-width-responsive="true"
								></ins>
								<script is:inline>
									(adsbygoogle = window.adsbygoogle || []).push({});
								</script>
							</div>
						)}
					</main>
					<footer class="t-foot">
						<span>&copy; {year} {SITE_TITLE}</span>
						<nav aria-label="Site">
							<a href="/">Blog</a>
							<a href="/tools/">Tools</a>
							<a href="/about/">About</a>
							<a href="/privacy/">Privacy</a>
						</nav>
					</footer>
				</>
			)
		}
		{
			!redirectTo && (
				<script is:inline>
					// Language toggle
					const langToggle = document.querySelector('.t-lang');
					function syncLangUI(l) {
						if (!langToggle) return;
						langToggle.textContent = l === 'zh' ? '中' : 'EN';
						langToggle.title = l === 'zh' ? '当前：中文 (点击切换为 English)' : 'Current: English (click for Chinese)';
						langToggle.setAttribute('aria-label', l === 'zh' ? '切换为 English' : '切换为 中文');
					}
					const currentLang = root.dataset.lang || 'en';
					syncLangUI(currentLang);
					langToggle?.addEventListener('click', () => {
						const next = root.dataset.lang === 'zh' ? 'en' : 'zh';
						root.dataset.lang = next;
						root.lang = next === 'zh' ? 'zh-CN' : 'en';
						try {
							localStorage.setItem('site:lang', next);
						} catch {}
						syncLangUI(next);
						window.dispatchEvent(new CustomEvent('site:lang-change', { detail: next }));
					});

					// Theme: three-state cycle light → dark → auto (auto = follow browser)
					const root = document.documentElement;
					const toggle = document.querySelector('.t-theme');
					const mql = matchMedia('(prefers-color-scheme: dark)');
					const ICONS = { light: '☀', dark: '☾', auto: '◐' };
					const LABELS = {
						light: 'Light theme',
						dark: 'Dark theme',
						auto: 'Auto theme (follows browser setting)',
					};
					const ORDER = ['light', 'dark', 'auto'];

					function syncIcon() {
						const mode = root.dataset.themeMode;
						toggle.textContent = ICONS[mode];
						toggle.title = LABELS[mode];
						toggle.setAttribute('aria-label', LABELS[mode]);
					}

					function applyMode(mode) {
						root.dataset.themeMode = mode;
						root.dataset.theme = mode === 'auto' ? (mql.matches ? 'dark' : 'light') : mode;
						try {
							localStorage.setItem('site:theme', mode);
						} catch {
							/* storage unavailable — mode just won't persist */
						}
						syncIcon();
					}

					toggle.addEventListener('click', () => {
						const current = root.dataset.themeMode;
						applyMode(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length]);
					});

					mql.addEventListener('change', () => {
						if (root.dataset.themeMode === 'auto') {
							root.dataset.theme = mql.matches ? 'dark' : 'light';
						}
					});

					syncIcon();
				</script>
			)
		}
	</body>
</html>
