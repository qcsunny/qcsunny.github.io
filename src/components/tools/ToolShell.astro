---
// Shared lightweight shell for every tool page and tool index:
//  - minimal top bar: site name → home, breadcrumb (Tools › Category › Page), theme toggle
//  - three-state theme (light / dark / auto) with pre-paint inline script,
//    persisted under the shared key "site:theme"
//  - t-prefixed global styles (runtime-built DOM never gets the scoped
//    data-astro-cid attribute, so is:global is required)
import BaseHead from '../BaseHead.astro';
import SiteLogo from '../SiteLogo.astro';
import ToolSearchModal from './ToolSearchModal.astro';
import { ADSENSE_CLIENT, AD_SLOTS, SITE_TITLE } from '../../consts';
import { TOOL_CONTENT } from '../../tools/content';
import {
	CALCULATOR_FEATURED,
	REGISTRY,
	categoryLabel,
	categoryLabelZh,
	type ToolCategory,
	type ToolContent,
	type ToolEntry,
} from '../../tools/registry';

interface Props {
	title: string;
	description: string;
	/** registry entry (tool pages); omit for index pages */
	entry?: ToolEntry;
	/** breadcrumb category link; omit on the Tools hub */
	category?: ToolCategory;
	/** when set, renders a meta-refresh redirect page instead of the shell body */
	redirectTo?: string;
	/** editorial content (SEO); defaults to the entry's own content */
	content?: ToolContent;
}

const { title, description, entry, category, redirectTo } = Astro.props;
const kind = entry?.kind;
const crumbName = entry ? entry.name : title;
// Looked up here rather than read off the entry: prose on a ToolEntry ends up in
// the client bundle every tool page loads (see src/tools/content.ts).
const content =
	Astro.props.content ?? (entry ? TOOL_CONTENT[`${entry.category}/${entry.slug}`] : undefined);
const pageTitle = entry
	? (entry.nameZh ? `${entry.name} (${entry.nameZh})` : entry.name)
	: title;

// --- related tools: same category, real pages only, never self ---
// entry-less pages (standard/graph/graph3d) fall back to the category prop, and
// identify themselves by the last path segment so they stay out of their own list.
const relatedCategory = entry?.category ?? category;
const selfSlug = entry?.slug ?? Astro.url.pathname.replace(/\/+$/, '').split('/').pop();
const relatedPool = relatedCategory
	? [...CALCULATOR_FEATURED, ...REGISTRY].filter(
			(e) => e.category === relatedCategory && e.kind !== 'redirect' && e.slug !== selfSlug,
		)
	: [];
const related = relatedPool.slice(0, 4);

// --- JSON-LD structured data ---
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd: object[] = [];
{
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'WebApplication',
		// The English name alone: alternateName below is where the Chinese one
		// belongs, and pageTitle bundles both (it feeds <title>, which cannot hold
		// a span pair and is deliberately bilingual for search).
		name: entry ? entry.name : title,
		alternateName: entry?.nameZh,
		description: entry ? entry.description : description,
		url: pageUrl,
		applicationCategory: 'UtilitiesApplication',
		operatingSystem: 'Web browser',
		browserRequirements: 'Requires JavaScript',
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
	});
	jsonLd.push({
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: 'Tools', item: new URL('/tools/', Astro.site).href },
			...(category
				? [
						{
							'@type': 'ListItem',
							position: 2,
							name: categoryLabel(category),
							item: new URL(`/${category}/`, Astro.site).href,
						},
					]
				: []),
			{ '@type': 'ListItem', position: category ? 3 : 2, name: crumbName, item: pageUrl },
		],
	});
	if (content?.faq?.length) {
		jsonLd.push({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: content.faq.map((f) => ({
				'@type': 'Question',
				name: f.q,
				acceptedAnswer: { '@type': 'Answer', text: f.a },
			})),
		});
	}
}
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-tool-kind={kind} data-tool-category={category} data-tool-slug={entry?.slug}>
	<head>
		<BaseHead
			title={pageTitle}
			description={description}
			canonical={redirectTo ?? undefined}
		/>
		{redirectTo && <meta http-equiv="refresh" content={`0;url=${redirectTo}`} />}
		{ADSENSE_CLIENT && (
			<script
				async
				src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
				crossorigin="anonymous"
			></script>
		)}
		{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
		<script is:inline>
			// Apply theme before first paint to avoid a flash.
			// Shared across all tool pages via one preference key.
			(() => {
				const saved = localStorage.getItem('site:theme');
				const mode = saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
				document.documentElement.dataset.themeMode = mode;
				const isDark =
					mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
				if (isDark) {
					document.documentElement.dataset.theme = 'dark';
				} else {
					document.documentElement.removeAttribute('data-theme');
				}

				// Language pre-paint initialization
				const savedLang = localStorage.getItem('site:lang') || (navigator.language.startsWith('zh') ? 'zh' : 'en');
				document.documentElement.dataset.lang = savedLang;
				document.documentElement.lang = savedLang === 'zh' ? 'zh-CN' : 'en';
			})();
		</script>
		<style is:global>
			/* theme tokens (--bg/--fg/…) are defined globally in global.css,
			   shared with the blog side; html[data-theme] drives dark mode */
			* {
				margin: 0;
				padding: 0;
			}
			body {
				background: var(--bg);
				color: var(--fg);
				min-height: 100dvh;
				font-family:
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					'Helvetica Neue',
					Arial,
					'PingFang SC',
					'Microsoft YaHei',
					'Noto Sans CJK SC',
					sans-serif;
				-webkit-font-smoothing: antialiased;
				font-size: 16px;
				line-height: 1.5;
			}

			/* --- top bar --- */
			.t-topbar {
				display: flex;
				align-items: center;
				gap: 1em;
				min-height: 3.25em;
				padding: 0 1em;
				border-bottom: 1px solid var(--gridline);
				flex-wrap: wrap;
			}
			.t-site {
				display: inline-flex;
				align-items: center;
				gap: 0.45rem;
				font-weight: 700;
				font-size: 0.95rem;
				color: var(--fg);
				text-decoration: none;
				padding: 0.6em 0;
			}
			.t-site:hover {
				color: var(--accent);
			}
			.t-crumbs {
				display: flex;
				align-items: center;
				gap: 0.45em;
				font-size: 0.85rem;
				color: var(--dim);
				min-width: 0;
			}
			.t-crumbs a {
				color: var(--dim);
				text-decoration: none;
			}
			.t-crumbs a:hover {
				color: var(--accent);
			}
			.t-crumbs .t-crumb-sep {
				opacity: 0.6;
			}
			.t-crumbs [aria-current='page'] {
				color: var(--fg);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.t-topbar-actions {
				margin-left: auto;
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.t-search-nav {
				font-size: 0.85rem;
				color: var(--dim);
				background: transparent;
				border: 1px solid var(--gridline);
				border-radius: 6px;
				padding: 0.25em 0.55em;
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				line-height: 1.2;
				transition:
					opacity 0.15s ease,
					border-color 0.15s ease,
					color 0.15s ease;
			}
			.t-search-nav:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.t-search-nav:focus-visible {
				outline: 2px solid currentColor;
			}
			.t-lang {
				font-size: 0.8rem;
				font-weight: 700;
				color: var(--dim);
				background: transparent;
				border: 1px solid var(--gridline);
				border-radius: 6px;
				font-family: inherit;
				cursor: pointer;
				padding: 0.25em 0.55em;
				line-height: 1.2;
				transition:
					opacity 0.15s ease,
					border-color 0.15s ease,
					color 0.15s ease;
			}
			.t-lang:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.t-lang:focus-visible {
				outline: 2px solid currentColor;
			}
			.t-theme {
				font-size: 0.95rem;
				opacity: 0.5;
				color: var(--fg);
				background: none;
				border: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0.4em 0.6em;
			}
			.t-theme:hover {
				opacity: 1;
			}
			.t-theme:focus-visible {
				outline: 2px solid currentColor;
				opacity: 1;
			}

			/* --- bilingual content display --- */
			html[data-lang='zh'] .t-content-en {
				display: none;
			}
			/* EN is the fallback when data-lang has not been written yet — no-JS
			   and the pre-hydration paint — matching the .i18n-zh rule in
			   global.css. Keyed on [data-lang='en'] alone, the Chinese prose used
			   to sit under the English one until the bootstrap script ran. */
			html:not([data-lang='zh']) .t-content-zh {
				display: none;
			}
			html[data-lang='zh'] .t-content:not(:has(.t-content-zh)) .t-content-en {
				display: block !important;
			}

			/* --- content --- */
			.t-main {
				width: min(var(--w-page), 100% - 2em);
				margin: 0 auto;
				padding: 1.75em 0 3.5em;
			}
			/* global.css colors every h1 near-black — override explicitly */
			.t-title {
				color: var(--fg);
				font-size: clamp(1.4rem, 4vw, 1.9rem);
				font-weight: 700;
				margin-bottom: 0.4em;
			}
			.t-title-zh {
				font-size: 0.8em;
				font-weight: 500;
				opacity: 0.85;
				margin-left: 0.25em;
			}
			.t-intro {
				color: var(--dim);
				font-size: 0.92rem;
				margin-bottom: 1.25em;
			}

			/* --- forms --- */
			.t-form {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
				gap: 0.9em 1.1em;
				margin-bottom: 1.25em;
			}
			/* Every field is a subgrid of the form's own rows — label band, control
			   band, hint band — so the inputs of a row line up even when one label
			   wraps to two lines and its neighbours do not. Before this, the wrapped
			   label pushed its own input 19px below the ones beside it, which is
			   visible on nine of the finance and calculator forms (the label of
			   `amount` on /finance/loan-payment/ is the widest offender).

			   The internal 0.3em is a margin rather than a row-gap because the third
			   band is empty on most rows, and a gap would still charge for it. */
			.t-field {
				display: grid;
				grid-template-rows: subgrid;
				grid-row: span 3;
				row-gap: 0;
				/* A grid item's automatic minimum size is its content's — and a
				   <select>'s content is its longest <option>. Without this, the mode
				   select on /finance/loan-payment/ was ~490px wide inside a 228px
				   column, painting underneath the two inputs beside it and showing
				   through the column gap as a stray glyph. */
				min-width: 0;
			}
			.t-field > label {
				font-size: 0.82rem;
				color: var(--dim);
				/* Bottom of the label band, so a one-line label sits against its own
				   control instead of floating above it. */
				align-self: end;
				margin-bottom: 0.3em;
			}
			/* Only ever holds a checkbox field, which has no separate label: place it
			   in the control band so it lines up with the inputs beside it. */
			.t-field > .t-checkrow {
				grid-row: 2;
			}
			.t-below {
				display: flex;
				flex-direction: column;
				align-self: start;
			}
			.t-field .t-suffix {
				opacity: 0.7;
				/* Keep the unit gloss together: "($ / ¥)" broke across lines as "($"
				   and "/ ¥)" whenever the label filled its first line. */
				white-space: nowrap;
			}
			.t-field input,
			.t-field select {
				font: inherit;
				font-size: 0.95rem;
				padding: 0.45em 0.6em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
				min-width: 0;
				max-width: 100%;
			}
			/* Long option text is the select's own problem to clip, not the layout's. */
			.t-field select {
				text-overflow: ellipsis;
			}
			.t-field input:focus-visible,
			.t-field select:focus-visible,
			.t-check:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-field input.t-invalid,
			.t-field select.t-invalid,
			.t-field textarea.t-invalid {
				border-color: #ef4444;
				background: rgba(239, 68, 68, 0.05);
			}
			.t-field input.t-invalid:focus-visible {
				outline: 2px solid #ef4444;
			}
			.t-req {
				color: #ef4444;
				font-weight: bold;
				margin-left: 0.2em;
			}
			.t-req-tip {
				font-size: 0.75rem;
				color: #ef4444;
				margin-top: 0.3em;
				font-weight: 500;
			}
			.t-field .t-hint {
				font-size: 0.75rem;
				color: var(--dim);
				margin-top: 0.3em;
			}
			.t-field.t-wide {
				grid-column: 1 / -1;
			}
			.t-field input[type='checkbox'],
			.t-check {
				width: 1.05em;
				height: 1.05em;
				accent-color: var(--accent);
			}
			.t-checkrow {
				display: flex;
				align-items: center;
				gap: 0.45em;
				font-size: 0.9rem;
				color: var(--fg);
			}
			.t-btn {
				font: inherit;
				font-size: 0.92rem;
				padding: 0.45em 1em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
				cursor: pointer;
			}
			.t-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.t-btn:focus-visible {
				outline: 2px solid var(--accent);
			}
			.t-btn.t-primary {
				background: var(--accent);
				border-color: var(--accent);
				color: var(--on-accent);
				font-weight: 600;
			}
			.t-btn.t-primary:hover {
				opacity: 0.9;
				color: var(--on-accent);
			}
			.t-btnrow {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-bottom: 1em;
			}

			/* --- export bar (print + PNG); shown only once results render --- */
			.t-export-bar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.6em;
				margin-top: 1em;
			}
			.t-export-btn {
				padding: 0.5em 1em;
				border: 1px solid var(--gridline);
				border-radius: 999px;
				background: var(--bg);
				color: var(--fg);
				font: inherit;
				font-size: 0.86rem;
				font-weight: 600;
				cursor: pointer;
				transition: border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
			}
			.t-export-btn:hover:not(:disabled) {
				border-color: var(--accent);
				color: var(--accent);
				transform: translateY(-2px);
			}
			.t-export-btn:disabled {
				opacity: 0.55;
				cursor: progress;
			}

			/* --- results --- */
			.t-results {
				border: 1px solid var(--gridline);
				border-radius: 10px;
				padding: 0.9em 1.1em;
				display: flex;
				flex-direction: column;
				gap: 0.45em;
			}
			.t-results:empty {
				display: none;
			}
			.t-row {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				font-size: 0.95rem;
			}
			.t-row .t-row-label {
				color: var(--dim);
			}
			.t-row .t-row-value {
				font-variant-numeric: tabular-nums;
				font-weight: 600;
				text-align: right;
				overflow-wrap: anywhere;
			}
			.t-row.t-emph {
				font-size: 1.05rem;
			}
			.t-row.t-emph .t-row-label {
				color: var(--fg);
			}
			.t-row.t-emph .t-row-value {
				color: var(--accent);
				font-size: 1.25rem;
			}
			.t-row.t-row-warn {
				background: rgba(245, 158, 11, 0.08);
				border-left: 3px solid #f59e0b;
				padding: 0.5em 0.8em;
				border-radius: 6px;
				margin-top: 0.5em;
			}
			.t-row.t-row-warn .t-row-label {
				color: #f59e0b;
				font-weight: 600;
			}
			.t-row.t-row-warn .t-row-value {
				color: var(--dim);
				font-size: 0.85rem;
				font-weight: normal;
			}
			.t-note {
				font-size: 0.85rem;
				color: var(--dim);
				margin-top: 0.5em;
			}
			.t-chartwrap {
				overflow-x: auto;
				margin-top: 1.25em;
				background: var(--card);
				border: 1px solid var(--gridline);
				border-radius: 12px;
				padding: 1em 1em 0.8em;
			}
			.t-chartwrap svg {
				display: block;
				width: 100%;
				height: auto;
				min-width: 620px;
			}
			.t-tablewrap {
				overflow-x: auto;
				margin-top: 1.25em;
			}
			.t-table {
				border-collapse: collapse;
				width: 100%;
				font-size: 0.88rem;
				font-variant-numeric: tabular-nums;
			}
			.t-table th,
			.t-table td {
				text-align: right;
				padding: 0.4em 0.6em;
				border-top: 1px solid var(--gridline);
				white-space: nowrap;
			}
			.t-table th:first-child,
			.t-table td:first-child {
				text-align: left;
			}
			.t-table thead th {
				border-top: none;
				color: var(--dim);
				font-weight: 600;
			}

			/* --- text tools --- */
			.t-textarea {
				width: 100%;
				box-sizing: border-box;
				font: inherit;
				font-size: 0.95rem;
				padding: 0.6em 0.75em;
				border: 1px solid var(--gridline);
				border-radius: 10px;
				background: var(--bg);
				color: var(--fg);
				resize: vertical;
			}
			.t-textarea:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-textarea.t-mono,
			.t-out {
				/* Tool output is mostly ASCII but not always — a JSON value or an
				   SQL string literal can be Chinese — so the CJK stack follows the
				   monospace one instead of letting those characters reach the
				   browser default. */
				font-family: var(--font-mono), var(--font-cjk);
				font-size: 0.88rem;
			}
			.t-out {
				min-height: 6em;
				white-space: pre;
				overflow-wrap: normal;
				overflow-x: auto;
			}
			.t-error {
				font-size: 0.85rem;
				color: var(--accent);
				margin-top: 0.5em;
			}
			.t-label {
				display: block;
				font-size: 0.82rem;
				color: var(--dim);
				margin: 1em 0 0.35em;
			}

			/* --- converter (two-sided unit conversion + live keyword search) --- */
			.t-conv {
				display: flex;
				flex-direction: column;
				gap: 0.75em;
				margin-bottom: 1.5em;
			}
			.t-conv-row {
				display: flex;
				gap: 0.6em;
				align-items: center;
			}
			.t-conv-row label {
				flex: none;
				width: 3.4em;
				font-size: 0.82rem;
				color: var(--dim);
			}
			.t-conv-row .t-conv-val {
				flex: 1 1 130px;
				min-width: 0;
				font: inherit;
				font-size: 0.95rem;
				padding: 0.45em 0.6em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
				font-variant-numeric: tabular-nums;
			}
			.t-conv-picker {
				flex: 2 1 250px;
				min-width: 0;
				display: flex;
				flex-direction: column;
				gap: 0.3em;
			}
			.t-conv-search-box {
				position: relative;
				display: flex;
				align-items: center;
			}
			.t-conv-search-input {
				width: 100%;
				font: inherit;
				font-size: 0.82rem;
				padding: 0.32em 1.8em 0.32em 0.6em;
				border: 1px dashed var(--gridline);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-conv-search-input:focus {
				outline: none;
				border-color: var(--accent);
				border-style: solid;
			}
			.t-conv-search-clear {
				position: absolute;
				right: 0.35em;
				background: none;
				border: none;
				color: var(--dim);
				cursor: pointer;
				font-size: 0.95rem;
				padding: 0.1em 0.3em;
				line-height: 1;
			}
			.t-conv-search-clear:hover {
				color: var(--fg);
			}
			.t-conv-select {
				width: 100%;
				font: inherit;
				font-size: 0.92rem;
				padding: 0.45em 0.5em;
				border: 1px solid var(--gridline);
				border-radius: 8px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-conv-select:focus-visible,
			.t-conv-row .t-conv-val:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-conv-swap {
				align-self: flex-start;
				margin-left: 4em;
			}
			.t-conv-note {
				font-size: 0.84rem;
				color: var(--dim);
				padding: 0.2em 0;
			}
			@media (max-width: 560px) {
				.t-conv-row {
					flex-wrap: wrap;
				}
				.t-conv-row label {
					width: 100%;
				}
				.t-conv-picker {
					width: 100%;
				}
				.t-conv-swap {
					margin-left: 0;
				}
			}

			/* --- all-units live conversion grid with search filter --- */
			.t-conv-live {
				margin-top: 1.5em;
				border: 1px solid var(--gridline);
				border-radius: 10px;
				padding: 1.1em 1.25em;
				background: var(--bg);
			}
			.t-conv-live-header {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: 0.8em;
				margin-bottom: 1em;
			}
			.t-conv-live-title {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--fg);
			}
			.t-conv-live-searchbox {
				position: relative;
				display: flex;
				align-items: center;
				flex: 1 1 240px;
				max-width: 360px;
			}
			.t-conv-live-filter {
				width: 100%;
				font: inherit;
				font-size: 0.86rem;
				padding: 0.4em 1.8em 0.4em 0.7em;
				border: 1px solid var(--gridline);
				border-radius: 6px;
				background: var(--bg);
				color: var(--fg);
			}
			.t-conv-live-filter:focus {
				outline: 2px solid var(--accent);
				outline-offset: -1px;
			}
			.t-conv-live-clear {
				position: absolute;
				right: 0.4em;
				background: none;
				border: none;
				color: var(--dim);
				cursor: pointer;
				font-size: 0.95rem;
				padding: 0 0.3em;
				line-height: 1;
			}
			.t-conv-live-clear:hover {
				color: var(--fg);
			}
			.t-conv-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 0.75em;
			}
			.t-conv-card {
				border: 1px solid var(--gridline);
				border-radius: 8px;
				padding: 0.7em 0.85em;
				background: var(--bg);
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				transition: border-color 0.15s, box-shadow 0.15s;
			}
			.t-conv-card:hover {
				border-color: var(--accent);
			}
			.t-conv-card.is-active-from {
				border-color: var(--accent);
				box-shadow: 0 0 0 1px var(--accent);
			}
			.t-conv-card.is-active-to {
				border-color: #10b981;
				box-shadow: 0 0 0 1px #10b981;
			}
			.t-conv-card-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 0.5em;
				font-size: 0.8rem;
				color: var(--dim);
			}
			.t-conv-card-name {
				font-weight: 500;
				overflow: hidden;
				text-overflow: ellipsis;
				white-space: nowrap;
			}
			.t-conv-card-short {
				font-family: var(--font-mono, monospace);
				font-size: 0.75rem;
				opacity: 0.85;
				flex-shrink: 0;
			}
			.t-conv-card-val {
				font-size: 1.12rem;
				font-weight: 600;
				color: var(--fg);
				font-variant-numeric: tabular-nums;
				word-break: break-all;
			}
			.t-conv-card-actions {
				display: flex;
				gap: 0.45em;
				margin-top: 0.2em;
			}
			.t-conv-act-btn {
				font: inherit;
				font-size: 0.72rem;
				padding: 0.25em 0.55em;
				border: 1px solid var(--gridline);
				border-radius: 4px;
				background: transparent;
				color: var(--dim);
				cursor: pointer;
				transition: all 0.12s;
			}
			.t-conv-act-btn:hover {
				border-color: var(--accent);
				color: var(--accent);
			}
			.t-conv-empty {
				grid-column: 1 / -1;
				text-align: center;
				color: var(--dim);
				font-size: 0.88rem;
				padding: 2em 1em;
			}

			/* --- generators (password / uuid / random) --- */
.t-lenrow {
	display: flex;
	align-items: center;
	gap: 0.8em;
	margin-bottom: 0.9em;
}
.t-lenrow input[type='range'] {
	flex: 1;
	accent-color: var(--accent);
}
.t-lenrow output {
	min-width: 2.4em;
	text-align: right;
	font-weight: 600;
	font-variant-numeric: tabular-nums;
}
.t-checkrow-group {
	display: flex;
	flex-wrap: wrap;
	gap: 0.4em 1.2em;
	margin-bottom: 0.9em;
}
.t-passout {
	width: 100%;
	box-sizing: border-box;
	font-family: var(--font-mono), var(--font-cjk);
	font-size: 1.05rem;
	padding: 0.55em 0.7em;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	background: var(--bg);
	color: var(--fg);
	letter-spacing: 0.03em;
	margin-bottom: 0.9em;
}
.t-passout:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -1px;
}
.t-btnwrap {
	display: inline-flex;
	align-items: center;
	gap: 0.55em;
}
.t-copy-hint {
	font-size: 0.82rem;
	color: var(--dim);
}
.t-countlabel {
	font-size: 0.82rem;
	color: var(--dim);
	align-self: center;
}
.t-countlabel + input {
	width: 6em;
}

/* --- color converter --- */
.t-colorgroups {
	display: grid;
	grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
	gap: 0.9em 1.1em;
	margin-bottom: 1.25em;
}
.t-colorfield {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
}
.t-colorgrouplabel {
	font-size: 0.82rem;
	color: var(--dim);
}
.t-colorrow {
	display: flex;
	gap: 0.5em;
}
.t-colorcell {
	flex: 1;
	display: flex;
	flex-direction: column;
	gap: 0.15em;
	font-size: 0.75rem;
	color: var(--dim);
	text-align: center;
}
.t-colorcell input {
	width: 100%;
	box-sizing: border-box;
	font: inherit;
	font-size: 0.95rem;
	padding: 0.45em 0.3em;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	background: var(--bg);
	color: var(--fg);
	text-align: center;
	font-variant-numeric: tabular-nums;
}
.t-colorcell input:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -1px;
}
.t-swatchrow {
	display: flex;
	gap: 1em;
	margin-bottom: 1.25em;
}
.t-swatchwrap {
	display: flex;
	flex-direction: column;
	gap: 0.3em;
	font-size: 0.82rem;
	color: var(--dim);
}
.t-swatch {
	width: 100px;
	height: 68px;
	border: 1px solid var(--gridline);
	border-radius: 10px;
}

/* --- QR generator --- */
.t-qrsettings {
	display: grid;
	grid-template-columns: 2fr 1fr;
	gap: 0.9em 1.1em;
	margin-bottom: 0.6em;
}
.t-eccfield select {
	font: inherit;
	font-size: 0.95rem;
	padding: 0.45em 0.5em;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	background: var(--bg);
	color: var(--fg);
	width: 100%;
	box-sizing: border-box;
}
.t-qr-canvas {
	max-width: 100%;
	height: auto;
	display: block;
	margin: 0.6em 0;
	border: 1px solid var(--gridline);
	border-radius: 8px;
	image-rendering: pixelated;
}
@media (max-width: 560px) {
	.t-qrsettings {
		grid-template-columns: 1fr;
	}
}

/* --- Workbench layout (JSON, SQL, JWT, URL, XML, CSS, HTML) --- */
html[data-tool-kind='json'] .t-main,
html[data-tool-kind='sql'] .t-main,
html[data-tool-kind='jwt'] .t-main,
html[data-tool-kind='url'] .t-main,
html[data-tool-kind='xml'] .t-main,
html[data-tool-kind='css'] .t-main,
html[data-tool-kind='html'] .t-main {
	width: min(var(--w-max), 100% - 2em);
}
.t-json-wrap {
	display: flex;
	flex-direction: column;
	gap: 0.85em;
	margin-bottom: 2em;
}
.t-json-toolbar {
	display: flex;
	flex-wrap: wrap;
	gap: 0.5em;
	align-items: center;
	padding: 0.6em 0.8em;
	background: var(--bg);
	border: 1px solid var(--gridline);
	border-radius: 10px;
}
.t-json-toolbar .t-sep {
	width: 1px;
	height: 1.5em;
	background: var(--gridline);
	margin: 0 0.25em;
}
.t-json-status {
	display: flex;
	align-items: center;
	padding: 0.6em 0.9em;
	border-radius: 8px;
	font-size: 0.85rem;
	font-family: var(--font-mono);
	border: 1px solid var(--gridline);
	background: var(--bg);
	color: var(--dim);
	transition: all 0.2s ease;
	line-height: 1.4;
}
.t-json-status.is-valid {
	border-color: #10b981;
	color: #059669;
	background: rgba(16, 185, 129, 0.08);
}
.t-json-status.is-error {
	border-color: #ef4444;
	color: #dc2626;
	background: rgba(239, 68, 68, 0.08);
}
.t-json-panels {
	display: grid;
	grid-template-columns: 1fr 1fr;
	gap: 1em;
}
@media (max-width: 768px) {
	.t-json-panels {
		grid-template-columns: 1fr;
	}
}
.t-json-panel {
	display: flex;
	flex-direction: column;
	gap: 0.45em;
}
.t-json-panel-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-size: 0.85rem;
	color: var(--dim);
}
.t-json-editor {
	width: 100%;
	height: 440px;
	box-sizing: border-box;
	/* Formatter input and output are mostly ASCII, but a JSON value or an SQL
	   string literal is often Chinese, so the CJK stack follows. */
	font-family: var(--font-mono), var(--font-cjk);
	font-size: 0.9rem;
	line-height: 1.5;
	padding: 0.75em;
	border: 1px solid var(--gridline);
	border-radius: 10px;
	background: var(--bg);
	color: var(--fg);
	resize: vertical;
	tab-size: 2;
}
.t-json-editor:focus-visible {
	outline: 2px solid var(--accent);
	outline-offset: -1px;
}

/* --- markdown live editor & previewer --- */
.t-md-container {
	display: flex;
	flex-direction: column;
	gap: 0.85em;
	margin: 0.5em 0 1.5em;
}
.t-md-toolbar {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	justify-content: space-between;
	gap: 0.6em;
	padding: 0.6em 0.85em;
	background: var(--card);
	border: 1px solid var(--gridline);
	border-radius: 12px;
}
.t-md-tool-group {
	display: flex;
	flex-wrap: wrap;
	align-items: center;
	gap: 0.35em;
}
.t-md-tool-btn {
	border: 1px solid var(--gridline);
	background: var(--bg);
	color: var(--fg);
	border-radius: 6px;
	padding: 0.35em 0.65em;
	font-size: 0.82rem;
	font-weight: 600;
	cursor: pointer;
	line-height: 1.2;
	transition: all 0.15s ease;
	display: inline-flex;
	align-items: center;
	justify-content: center;
}
.t-md-tool-btn:hover {
	border-color: var(--accent);
	color: var(--accent);
	background: rgba(var(--accent-rgb, 59, 130, 246), 0.08);
}
.t-md-view-btn.is-active {
	background: var(--accent);
	color: #ffffff;
	border-color: var(--accent);
}
.t-md-btn-primary {
	background: rgba(var(--accent-rgb, 59, 130, 246), 0.12);
	color: var(--accent);
	border-color: var(--accent);
}
.t-md-btn-primary:hover {
	background: var(--accent);
	color: #ffffff;
}
.t-md-panels {
	display: grid;
	gap: 1em;
	min-height: 520px;
}
.t-md-panels.t-md-split {
	grid-template-columns: 1fr 1fr;
}
.t-md-panels.t-md-preview-only {
	grid-template-columns: 1fr;
}
.t-md-panels.t-md-preview-only .t-md-panel-editor {
	display: none;
}
.t-md-panels.t-md-editor-only {
	grid-template-columns: 1fr;
}
.t-md-panels.t-md-editor-only .t-md-panel-preview {
	display: none;
}
@media (max-width: 820px) {
	.t-md-panels.t-md-split {
		grid-template-columns: 1fr;
	}
}
.t-md-panel {
	display: flex;
	flex-direction: column;
	gap: 0.45em;
	min-width: 0;
}
.t-md-panel-head {
	display: flex;
	justify-content: space-between;
	align-items: center;
	font-size: 0.84rem;
	font-weight: 600;
	color: var(--dim);
	padding: 0 0.25em;
}
.t-md-head-hint {
	font-weight: 400;
	font-size: 0.78rem;
}
.t-md-textarea {
	width: 100%;
	height: 560px;
	box-sizing: border-box;
	font-family: var(--font-mono);
	font-size: 0.92rem;
	line-height: 1.6;
	padding: 0.9em 1.1em;
	border: 1px solid var(--gridline);
	border-radius: 12px;
	background: var(--bg);
	color: var(--fg);
	resize: vertical;
	outline: none;
	tab-size: 2;
}
.t-md-textarea:focus {
	border-color: var(--accent);
	box-shadow: 0 0 0 3px rgba(var(--accent-rgb, 59, 130, 246), 0.15);
}
.t-md-preview-body {
	width: 100%;
	height: 560px;
	box-sizing: border-box;
	overflow-y: auto;
	padding: 1.2em 1.5em;
	border: 1px solid var(--gridline);
	border-radius: 12px;
	background: var(--card);
	color: var(--fg);
	line-height: 1.8;
	font-size: 0.96rem;
	word-break: break-word;
}
.t-md-preview-body h1 {
	font-size: 1.65rem;
	font-weight: 800;
	margin: 0.8em 0 0.5em;
	padding-bottom: 0.3em;
	border-bottom: 1px solid var(--gridline);
	color: var(--fg);
}
.t-md-preview-body h2 {
	font-size: 1.35rem;
	font-weight: 700;
	margin: 1.2em 0 0.5em;
	padding-bottom: 0.25em;
	border-bottom: 1px solid var(--gridline);
	color: var(--fg);
}
.t-md-preview-body h3 {
	font-size: 1.15rem;
	font-weight: 600;
	margin: 1.1em 0 0.4em;
	color: var(--fg);
}
.t-md-preview-body h4, .t-md-preview-body h5, .t-md-preview-body h6 {
	font-size: 1rem;
	font-weight: 600;
	margin: 1em 0 0.4em;
	color: var(--fg);
}
.t-md-preview-body p {
	margin: 0.8em 0;
}
.t-md-preview-body hr {
	border: none;
	border-top: 1px solid var(--gridline);
	margin: 1.8em 0;
}
.t-md-preview-body blockquote {
	border-left: 4px solid var(--accent);
	background: color-mix(in srgb, var(--accent) 5%, var(--bg));
	border-radius: 0 8px 8px 0;
	padding: 0.75em 1.1em;
	margin: 1em 0;
	color: var(--fg);
}
.t-md-preview-body .t-inline-code {
	font-family: var(--font-mono, monospace);
	font-size: 0.88em;
	padding: 0.15em 0.4em;
	background: color-mix(in srgb, var(--gridline) 60%, transparent);
	border-radius: 5px;
	color: var(--accent);
}
/* Formulas. markdown.ts emits `.t-math[data-tex]` holding the LaTeX source and
   renderMathIn() replaces the contents with KaTeX output, dropping data-tex —
   so the attribute selector is exactly the "not typeset yet" state: the moment
   between the paint and the KaTeX chunk arriving, a formula the parser saw but
   KaTeX rejected, and the offline case where the chunk never arrives at all.
   Styling it as code keeps all three legible instead of looking broken. */
.t-md-preview-body .t-math[data-tex] {
	font-family: var(--font-mono);
	font-size: 0.9em;
	padding: 0.1em 0.35em;
	background: rgba(234, 179, 8, 0.12);
	color: #b45309;
	border-radius: 4px;
}
.t-md-preview-body .t-math-error {
	background: rgba(239, 68, 68, 0.12);
	color: #b91c1c;
	/* The title attribute carries KaTeX's parse error. */
	cursor: help;
}
/* A display formula is a single unbreakable line, so one wider than the preview
   pane would otherwise stretch the pane and push the editor off-screen. Same
   remedy as the blog's .katex-display in global.css: scroll the formula. */
.t-md-preview-body .t-math-display {
	display: block;
	margin: 1.3em 0;
	overflow-x: auto;
	overflow-y: hidden;
	text-align: center;
}
.t-md-code-box {
	background: var(--bg);
	border: 1px solid var(--gridline);
	border-radius: 10px;
	margin: 1.2em 0;
	overflow: hidden;
}
.t-md-code-bar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	padding: 0.4em 0.85em;
	background: color-mix(in srgb, var(--gridline) 40%, transparent);
	font-size: 0.78rem;
	font-family: var(--font-mono, monospace);
	color: var(--dim);
}
.t-md-code-copy-btn {
	border: 1px solid var(--gridline);
	background: var(--card);
	color: var(--dim);
	border-radius: 4px;
	font-size: 0.72rem;
	padding: 0.15em 0.5em;
	cursor: pointer;
}
.t-md-code-copy-btn:hover {
	color: var(--accent);
	border-color: var(--accent);
}
.t-md-code-box pre {
	margin: 0;
	padding: 1em 1.2em;
	overflow-x: auto;
	font-family: var(--font-mono, monospace);
	font-size: 0.88rem;
	line-height: 1.55;
	background: transparent;
}
.t-md-table-wrap {
	width: 100%;
	overflow-x: auto;
	margin: 1.2em 0;
}
.t-md-table-wrap table {
	width: 100%;
	border-collapse: collapse;
	font-size: 0.92rem;
}
.t-md-table-wrap th, .t-md-table-wrap td {
	border: 1px solid var(--gridline);
	padding: 0.6em 0.85em;
}
.t-md-table-wrap th {
	background: color-mix(in srgb, var(--accent) 8%, var(--bg));
	font-weight: 700;
}
.t-md-table-wrap tr:nth-child(even) {
	background: color-mix(in srgb, var(--gridline) 20%, transparent);
}
.t-md-task-list {
	list-style: none;
	padding-left: 0.4em;
}
.t-md-task-item {
	display: flex;
	align-items: center;
	gap: 0.5em;
	margin: 0.4em 0;
}
.t-md-checkbox {
	width: 1.1em;
	height: 1.1em;
	cursor: default;
}
.t-md-alert {
	border-left: 4px solid;
	border-radius: 0 10px 10px 0;
	padding: 0.85em 1.15em;
	margin: 1.2em 0;
	background: var(--bg);
}
.t-md-alert-title {
	font-weight: 700;
	font-size: 0.92rem;
	margin-bottom: 0.35em;
	display: flex;
	align-items: center;
	gap: 0.4em;
}
.t-md-alert-note { border-color: #3b82f6; background: rgba(59, 130, 246, 0.08); }
.t-md-alert-tip { border-color: #10b981; background: rgba(16, 185, 129, 0.08); }
.t-md-alert-important { border-color: #8b5cf6; background: rgba(139, 92, 246, 0.08); }
.t-md-alert-warning { border-color: #f59e0b; background: rgba(245, 158, 11, 0.08); }
.t-md-alert-caution { border-color: #ef4444; background: rgba(239, 68, 68, 0.08); }
.t-md-img {
	max-width: 100%;
	border-radius: 8px;
	margin: 0.6em 0;
}
.t-md-link {
	color: var(--accent);
	text-decoration: underline;
	text-underline-offset: 2px;
}
.t-md-kbd {
	display: inline-block;
	font-family: var(--font-mono, monospace);
	font-size: 0.8em;
	padding: 0.1em 0.4em;
	background: var(--bg);
	border: 1px solid var(--gridline);
	border-radius: 4px;
	color: var(--dim);
}
.t-md-status-bar {
	display: flex;
	justify-content: space-between;
	align-items: center;
	flex-wrap: wrap;
	gap: 0.6em;
	padding: 0.6em 0.85em;
	background: var(--card);
	border: 1px solid var(--gridline);
	border-radius: 10px;
	font-size: 0.82rem;
	color: var(--dim);
}
.t-md-stats {
	display: flex;
	flex-wrap: wrap;
	gap: 0.85em;
	align-items: center;
}
.t-md-stats strong {
	color: var(--accent);
}
.t-md-engine {
	font-size: 0.78rem;
	color: var(--dim);
}

/* --- index cards --- */
			.t-cards {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
				gap: 0.9em;
			}
			.t-card {
				display: block;
				padding: 0.9em 1em;
				border: 1px solid var(--gridline);
				border-radius: 10px;
				text-decoration: none;
				color: var(--fg);
				background: var(--bg);
			}
			.t-card:hover {
				border-color: var(--accent);
			}
			.t-card:focus-visible {
				outline: 2px solid var(--accent);
			}
			.t-card h2,
			.t-card h3 {
				color: var(--fg);
				font-size: 1rem;
				font-weight: 600;
				margin-bottom: 0.25em;
			}
			.t-card p {
				color: var(--dim);
				font-size: 0.82rem;
				line-height: 1.45;
			}
			.t-section {
				margin-top: 2.25em;
			}
			.t-section:first-of-type {
				margin-top: 1.5em;
			}
			.t-section > h2 {
				color: var(--fg);
				font-size: 1.2rem;
				font-weight: 700;
				margin-bottom: 0.35em;
			}
			.t-section > .t-section-blurb {
				color: var(--dim);
				font-size: 0.88rem;
				margin-bottom: 0.9em;
			}

			/* --- moved (redirect) page --- */
			.t-moved {
				padding: 3em 1em;
				text-align: center;
			}
			.t-moved p {
				color: var(--dim);
				margin-bottom: 1em;
			}
			.t-moved a {
				color: var(--accent);
			}

			/* --- related links --- */
			.t-related {
				margin-top: 2.5em;
				font-size: 0.85rem;
				color: var(--dim);
			}
			.t-related a {
				color: var(--accent);
			}

			/* --- editorial content (SEO, bilingual) --- */
			.t-content {
				margin-top: 2.5em;
				font-size: 0.95rem;
				line-height: 1.65;
			}
			.t-content > p {
				margin-bottom: 0.9em;
			}
			.t-content h2,
			.t-faq h2,
			.t-faq h3,
			.t-content-zh h2,
			.t-related-page h2 {
				color: var(--fg);
				font-size: 1.15rem;
				font-weight: 700;
				margin: 1.4em 0 0.5em;
			}
			.t-faq details {
				border: 1px solid var(--gridline);
				border-radius: 8px;
				margin-bottom: 0.5em;
				padding: 0.55em 0.9em;
			}
			.t-faq summary {
				cursor: pointer;
				font-weight: 600;
				color: var(--fg);
			}
			.t-faq summary:hover {
				color: var(--accent);
			}
			.t-faq details p {
				margin-top: 0.5em;
				color: var(--dim);
				font-size: 0.9rem;
				line-height: 1.8;
			}

			/* --- Chinese section: taller rhythm, justified, CJK-aware --- */
			.t-content-zh {
				margin-top: 1.8em;
				padding-top: 0.4em;
				border-top: 1px dashed var(--gridline);
				line-height: 1.9;
				text-align: justify;
				hanging-punctuation: first;
			}
			.t-content-zh h2,
			.t-content-zh h3 {
				font-size: 1.1rem;
				letter-spacing: 0.04em;
			}
			.t-content-zh summary {
				letter-spacing: 0.02em;
			}
			.t-content-zh details p {
				text-align: left;
			}

			/* --- page-level related tools (SEO internal links) --- */
			.t-related-page {
				margin-top: 2.5em;
				padding-top: 1.2em;
				border-top: 1px solid var(--gridline);
			}
			.t-related-page h2 {
				color: var(--fg);
				font-size: 1.15rem;
				font-weight: 700;
				margin: 0 0 0.6em;
			}
			.t-related-page ul {
				list-style: none;
				margin: 0;
				padding: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
				gap: 0.45em 1.2em;
			}
			.t-related-page a {
				color: var(--accent);
				text-decoration: none;
				font-size: 0.92rem;
			}
			.t-related-page a:hover {
				text-decoration: underline;
			}

			/* --- ad slots: fixed min-height reserves space, so a late-loading
			     ad never shifts the layout (CLS). Keep in sync with real units. --- */
			.t-ad {
				margin: 2em auto;
				min-height: 100px;
				display: flex;
				justify-content: center;
			}
			.t-ad-bottom {
				min-height: 120px;
			}
			.t-ad .adsbygoogle {
				width: 100%;
			}

			/* --- footer --- */
			.t-foot {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em 1.5em;
				padding: 1.2em 1em 2em;
				border-top: 1px solid var(--gridline);
				font-size: 0.82rem;
				color: var(--dim);
			}
			.t-foot nav {
				display: flex;
				gap: 1.2em;
			}
			.t-foot a {
				color: var(--dim);
				text-decoration: none;
			}
			.t-foot a:hover {
				color: var(--accent);
			}

			@media (max-width: 560px) {
				.t-crumbs {
					order: 3;
					flex-basis: 100%;
				}
				.t-theme {
					margin-left: auto;
				}
			}
		</style>
	</head>
	<body>
		{
			redirectTo ? (
				<main class="t-moved">
					<h1 class="t-title">{title} has moved</h1>
					<p>
						This page now lives at <a href={redirectTo}>{redirectTo}</a>. Redirecting…
					</p>
				</main>
			) : (
				<>
					<header class="t-topbar">
						<a class="t-site" href="/">
							<SiteLogo size={20} />
							<span>{SITE_TITLE}</span>
						</a>
						<nav class="t-crumbs" aria-label="Breadcrumb">
							<a href="/tools/"><span class="i18n-en">Tools</span><span class="i18n-zh">工具库</span></a>
							{category && (
								<>
									<span class="t-crumb-sep" aria-hidden="true">›</span>
									<a href={`/${category}/`}>
										<span class="i18n-en">{categoryLabel(category)}</span>
										<span class="i18n-zh">{categoryLabelZh(category)}</span>
									</a>
								</>
							)}
							{crumbName !== 'Tools' && (
								<>
									<span class="t-crumb-sep" aria-hidden="true">›</span>
									<span aria-current="page">
										<span class="i18n-en">{entry ? entry.name : crumbName}</span>
										<span class="i18n-zh">{entry?.nameZh || crumbName}</span>
									</span>
								</>
							)}
						</nav>
						<div class="t-topbar-actions">
							<button class="t-search-nav" type="button" title="Search tools (/ or Ctrl+K)" aria-label="Search tools"
								data-title-en="Search tools (/ or Ctrl+K)" data-title-zh="搜索工具 (快捷键 / 或 Ctrl+K)"
								data-aria-en="Search tools" data-aria-zh="搜索工具">🔍</button>
							<button class="t-lang" type="button" aria-label="Switch language">中 / EN</button>
							<button class="t-theme" type="button" aria-label="Toggle light / dark theme">☾</button>
						</div>
					</header>
					<main class="t-main">
						<h1 class="t-title">
							<span class="i18n-en">{entry ? entry.name : crumbName}</span>
							<span class="i18n-zh">{entry?.nameZh || crumbName}</span>
						</h1>
						{entry?.kind === 'form' && entry.config.intro && (
							<p class="t-intro">
								<span class="i18n-en">{entry.config.intro}</span>
								{entry.config.introZh && <span class="i18n-zh">{entry.config.introZh}</span>}
							</p>
						)}
						<slot />
						{ADSENSE_CLIENT && AD_SLOTS.mid && (
							<div class="t-ad t-ad-mid">
								<ins
									class="adsbygoogle"
									style="display:block"
									data-ad-client={ADSENSE_CLIENT}
									data-ad-slot={AD_SLOTS.mid}
									data-ad-format="auto"
									data-full-width-responsive="true"
								></ins>
								<script is:inline>
									(adsbygoogle = window.adsbygoogle || []).push({});
								</script>
							</div>
						)}
						{content && (content.about?.length || content.faq?.length || content.aboutZh?.length) && (
							<article class="t-content">
								<div class="t-content-en">
									{content.about?.map((para) => <p>{para}</p>)}
									{content.faq?.length ? (
										<section class="t-faq">
											<h2>Frequently asked questions</h2>
											{content.faq.map((f) => (
												<details>
													<summary>{f.q}</summary>
													<p>{f.a}</p>
												</details>
											))}
										</section>
									) : null}
								</div>
								{content.aboutZh?.length || content.faqZh?.length ? (
									<section class="t-content-zh" lang="zh-CN">
										<h2>中文说明</h2>
										{content.aboutZh?.map((para) => <p>{para}</p>)}
										{content.faqZh?.length ? (
											<section class="t-faq">
												<h3>常见问题</h3>
												{content.faqZh.map((f) => (
													<details>
														<summary>{f.q}</summary>
														<p>{f.a}</p>
													</details>
												))}
											</section>
										) : null}
									</section>
								) : null}
							</article>
						)}
						{related.length ? (
							<nav class="t-related-page" aria-label="Related tools">
								<h2>
									<span class="i18n-en">Related tools</span>
									<span class="i18n-zh">相关工具</span>
								</h2>
								<ul>
									{related.map((e) => (
										<li>
											<a href={`/${e.category}/${e.slug}/`}>
												<span class="i18n-en">{e.name}</span>
												<span class="i18n-zh">{e.nameZh || e.name}</span>
											</a>
										</li>
									))}
								</ul>
							</nav>
						) : null}
						{ADSENSE_CLIENT && AD_SLOTS.bottom && (
							<div class="t-ad t-ad-bottom">
								<ins
									class="adsbygoogle"
									style="display:block"
									data-ad-client={ADSENSE_CLIENT}
									data-ad-slot={AD_SLOTS.bottom}
									data-ad-format="auto"
									data-full-width-responsive="true"
								></ins>
								<script is:inline>
									(adsbygoogle = window.adsbygoogle || []).push({});
								</script>
							</div>
						)}
					</main>
					<footer class="t-foot">
						<span>&copy; {year} {SITE_TITLE}</span>
						<nav aria-label="Site">
							<a href="/"><span class="i18n-en">Blog</span><span class="i18n-zh">博客</span></a>
							<a href="/tools/"><span class="i18n-en">Tools</span><span class="i18n-zh">工具箱</span></a>
							<a href="/about/"><span class="i18n-en">About</span><span class="i18n-zh">关于</span></a>
							<a href="/privacy/"><span class="i18n-en">Privacy</span><span class="i18n-zh">隐私政策</span></a>
							<a href="mailto:admin@qcsunny.org">admin@qcsunny.org</a>
						</nav>
					</footer>
				</>
			)
		}
		{
			!redirectTo && (
				<script is:inline>
					(() => {
						const root = document.documentElement;

						// Language toggle
						const langToggle = document.querySelector('.t-lang');
						function syncLangUI(l) {
							const zh = l === 'zh';
							for (const el of document.querySelectorAll('[data-aria-en]')) {
								const v = (zh ? el.dataset.ariaZh : el.dataset.ariaEn) || el.dataset.ariaEn;
								if (v) el.setAttribute('aria-label', v);
							}
							for (const el of document.querySelectorAll('[data-title-en]')) {
								const v = (zh ? el.dataset.titleZh : el.dataset.titleEn) || el.dataset.titleEn;
								if (v) el.title = v;
							}
							// An <option> cannot hold the .i18n-en / .i18n-zh span pair, so its two
							// texts ride on the element and get swapped here (see Graph3DTab.astro).
							for (const el of document.querySelectorAll('[data-text-en]')) {
								const v = (zh ? el.dataset.textZh : el.dataset.textEn) || el.dataset.textEn;
								if (v) el.textContent = v;
							}
							if (!langToggle) return;
							langToggle.textContent = l === 'zh' ? '中' : 'EN';
							langToggle.title = l === 'zh' ? '当前：中文 (点击切换为 English)' : 'Current: English (click for Chinese)';
							langToggle.setAttribute('aria-label', l === 'zh' ? '切换为 English' : 'Switch to Chinese');
						}
						const currentLang = root.dataset.lang || localStorage.getItem('site:lang') || (navigator.language.startsWith('zh') ? 'zh' : 'en');
						root.dataset.lang = currentLang;
						root.lang = currentLang === 'zh' ? 'zh-CN' : 'en';
						syncLangUI(currentLang);

						langToggle?.addEventListener('click', () => {
							const next = root.dataset.lang === 'zh' ? 'en' : 'zh';
							root.dataset.lang = next;
							root.lang = next === 'zh' ? 'zh-CN' : 'en';
							try {
								localStorage.setItem('site:lang', next);
							} catch {}
							syncLangUI(next);
							window.dispatchEvent(new CustomEvent('site:lang-change', { detail: next }));
						});

						// Quick search trigger
						document.querySelector('.t-search-nav')?.addEventListener('click', (e) => {
							e.preventDefault();
							const searchInput = document.getElementById('tool-search-input');
							if (searchInput && document.contains(searchInput)) {
								searchInput.focus();
								searchInput.select();
							} else if (typeof window.openSiteSearchModal === 'function') {
								window.openSiteSearchModal();
							} else {
								window.location.href = '/tools/?focus=1';
							}
						});

						// Theme: three-state cycle auto → light → dark
						const themeToggle = document.querySelector('.t-theme');
						const mql = matchMedia('(prefers-color-scheme: dark)');
						const ICONS = { auto: '◐', light: '☀', dark: '☾' };
						// aria-label and title hold plain text, so they cannot carry a span
						// pair either: syncLangUI calls syncThemeUI on every switch.
						const LABELS = {
							en: {
								auto: 'Auto theme (follows the browser)',
								light: 'Light theme',
								dark: 'Dark theme',
							},
							zh: {
								auto: '主题跟随系统',
								light: '浅色模式',
								dark: '深色模式',
							},
						};
						const ORDER = ['auto', 'light', 'dark'];

						function syncThemeUI() {
							if (!themeToggle) return;
							const mode = root.dataset.themeMode || 'auto';
							const labels = LABELS[root.dataset.lang === 'zh' ? 'zh' : 'en'];
							themeToggle.textContent = ICONS[mode] || '☾';
							themeToggle.title = labels[mode] || labels.dark;
							themeToggle.setAttribute('aria-label', labels[mode] || labels.dark);
						}

						function applyMode(mode) {
							root.dataset.themeMode = mode;
							const isDark = mode === 'dark' || (mode === 'auto' && mql.matches);
							if (isDark) {
								root.dataset.theme = 'dark';
							} else {
								root.removeAttribute('data-theme');
							}
							try {
								localStorage.setItem('site:theme', mode);
							} catch {}
							syncThemeUI();
						}

						themeToggle?.addEventListener('click', () => {
							const current = root.dataset.themeMode || 'auto';
							const next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
							applyMode(next);
						});

						// .t-lang is not the only writer of data-lang (BaseHead's blocking
						// script sets it pre-paint, and a second tab can too), so the passes
						// above follow the attribute rather than the click.
						new MutationObserver(() => {
							syncLangUI(root.dataset.lang === 'zh' ? 'zh' : 'en');
							syncThemeUI();
						}).observe(root, { attributes: true, attributeFilter: ['data-lang'] });

						mql.addEventListener('change', () => {
							if (root.dataset.themeMode === 'auto') {
								if (mql.matches) {
									root.dataset.theme = 'dark';
								} else {
									root.removeAttribute('data-theme');
								}
							}
						});

						// Initialize theme state & icon
						const initialMode = localStorage.getItem('site:theme') || root.dataset.themeMode || 'auto';
						applyMode(initialMode);
					})();
				</script>
				<ToolSearchModal />
			)
		}
	</body>
</html>
