---
// Two keypad modes sharing one display/engine/history:
//  - standard: plain 4-column calculator
//  - scientific: 6-column grid, left 2 columns of scientific keys
// `ins` inserts text at the cursor; `action` triggers a behaviour in basic.ts.
type Key = { label: string; ins?: string; action?: string; cls?: string };

const standardKeys: Key[] = [
	{ label: 'C', action: 'clear', cls: 'k-fn' },
	{ label: '⌫', action: 'back', cls: 'k-fn' },
	{ label: '%', ins: '%' },
	{ label: '÷', ins: '/', cls: 'k-op' },

	{ label: '7', ins: '7' },
	{ label: '8', ins: '8' },
	{ label: '9', ins: '9' },
	{ label: '×', ins: '*', cls: 'k-op' },

	{ label: '4', ins: '4' },
	{ label: '5', ins: '5' },
	{ label: '6', ins: '6' },
	{ label: '−', ins: '-', cls: 'k-op' },

	{ label: '1', ins: '1' },
	{ label: '2', ins: '2' },
	{ label: '3', ins: '3' },
	{ label: '+', ins: '+', cls: 'k-op' },

	{ label: '/', ins: '/', cls: 'k-op' },
	{ label: '0', ins: '0' },
	{ label: '.', ins: '.' },
	{ label: '=', action: 'equals', cls: 'k-eq' },
];

const scientificKeys: Key[] = [
	{ label: 'sin', ins: 'sin(', cls: 'k-sci' },
	{ label: 'cos', ins: 'cos(', cls: 'k-sci' },
	{ label: 'C', action: 'clear', cls: 'k-fn' },
	{ label: '⌫', action: 'back', cls: 'k-fn' },
	{ label: '%', ins: '%' },
	{ label: '÷', ins: '/', cls: 'k-op' },

	{ label: 'tan', ins: 'tan(', cls: 'k-sci' },
	{ label: '√', ins: 'sqrt(', cls: 'k-sci' },
	{ label: '7', ins: '7' },
	{ label: '8', ins: '8' },
	{ label: '9', ins: '9' },
	{ label: '×', ins: '*', cls: 'k-op' },

	{ label: 'ln', ins: 'ln(', cls: 'k-sci' },
	{ label: 'log', ins: 'log(', cls: 'k-sci' },
	{ label: '4', ins: '4' },
	{ label: '5', ins: '5' },
	{ label: '6', ins: '6' },
	{ label: '−', ins: '-', cls: 'k-op' },

	{ label: 'π', ins: 'pi', cls: 'k-sci' },
	{ label: 'e', ins: 'e', cls: 'k-sci' },
	{ label: '1', ins: '1' },
	{ label: '2', ins: '2' },
	{ label: '3', ins: '3' },
	{ label: '+', ins: '+', cls: 'k-op' },

	{ label: 'x^y', ins: '^', cls: 'k-sci' },
	{ label: 'n!', ins: '!', cls: 'k-sci' },
	{ label: '/', ins: '/', cls: 'k-op' },
	{ label: '0', ins: '0' },
	{ label: '.', ins: '.' },
	{ label: '=', action: 'equals', cls: 'k-eq' },

	{ label: '(', ins: '(', cls: 'k-sci' },
	{ label: ')', ins: ')', cls: 'k-sci' },
	{ label: 'ans', action: 'ans' },
	{ label: 'DEG', action: 'deg', cls: 'k-mode' },
	{ label: 'φ', ins: 'phi', cls: 'k-sci' },
	{ label: 'a/b', action: 'frac', cls: 'k-sci' },
];
---

<div class="calc-basic">
	<label class="sr-only" for="calc-display"
		><span class="i18n-en">Expression</span><span class="i18n-zh">表达式</span></label
	>
	<input
		id="calc-display"
		class="calc-display"
		type="text"
		autocomplete="off"
		spellcheck="false"
		placeholder="Type an expression, e.g. 2+3*4 or a=2"
	/>
	<div
		id="calc-formula"
		class="calc-formula"
		aria-label="Formula rendering"
		data-aria-en="Formula rendering"
		data-aria-zh="公式排版渲染"
	></div>
	<div id="calc-preview" class="calc-preview" aria-live="polite"></div>

	<div id="calc-vars" class="calc-vars"></div>

	<div
		class="calc-mode-toggle"
		role="group"
		aria-label="Keypad mode"
		data-aria-en="Keypad mode"
		data-aria-zh="键盘模式"
	>
		<button type="button" id="calc-mode-standard" data-calc-mode="standard" aria-pressed="true">
			<span class="i18n-en">Standard</span><span class="i18n-zh">标准</span>
		</button>
		<button type="button" id="calc-mode-scientific" data-calc-mode="scientific" aria-pressed="false">
			<span class="i18n-en">Scientific</span><span class="i18n-zh">科学</span>
		</button>
	</div>

	<div
		class="calc-keypad calc-keypad-standard"
		role="group"
		aria-label="Calculator keys"
		data-aria-en="Calculator keys"
		data-aria-zh="计算器按键"
	>
		{
			standardKeys.map((k) => (
				<button type="button" class={k.cls ?? 'k-num'} data-ins={k.ins} data-action={k.action}>
					{k.label}
				</button>
			))
		}
	</div>

	<div
		class="calc-keypad calc-keypad-sci"
		role="group"
		aria-label="Scientific calculator keys"
		data-aria-en="Scientific calculator keys"
		data-aria-zh="科学计算器按键"
		hidden
	>
		{
			scientificKeys.map((k) =>
				k.cls === 'k-blank' ? (
					<span class="k-blank" aria-hidden="true"></span>
				) : (
					<button
						type="button"
						class={k.cls ?? 'k-num'}
						data-ins={k.ins}
						data-action={k.action}
					>
						{k.label}
					</button>
				),
			)
		}
	</div>

	<section class="calc-history">
		<h2><span class="i18n-en">History</span><span class="i18n-zh">历史记录</span></h2>
		<ul id="calc-history-list"></ul>
		<p id="calc-history-empty" class="calc-history-empty">
			<span class="i18n-en">No calculations yet.</span><span class="i18n-zh">还没有计算记录。</span>
		</p>
		<button id="calc-history-clear" type="button" class="k-fn"
			><span class="i18n-en">Clear history</span><span class="i18n-zh">清空历史</span></button
		>
	</section>
</div>

<style is:global>
	/* is:global: chips and history rows are created at runtime and would not
	   receive the scoped data-astro-cid attribute */
	.calc-display {
		width: 100%;
		box-sizing: border-box;
		font-family: var(--font-mono);
		font-size: clamp(1.15rem, 3.5vw, 1.5rem);
		text-align: right;
		padding: 0.65em 0.75em;
		border: 1px solid var(--gridline);
		border-radius: 10px;
		background: var(--bg);
		color: var(--fg);
	}
	.calc-display:focus {
		outline: 2px solid var(--accent);
		outline-offset: -1px;
	}
	.calc-formula {
		min-height: 2.2em;
		display: flex;
		align-items: center;
		justify-content: flex-end;
		margin: 0.35em 0.2em 0.15em;
		padding: 0.4em 0.75em;
		background: rgba(var(--gray), 6%);
		border: 1px dashed var(--gridline);
		border-radius: 8px;
		overflow-x: auto;
		color: var(--fg);
		font-size: clamp(1.15rem, 3.2vw, 1.4rem);
	}
	.calc-formula:empty {
		display: none;
	}
	.calc-formula math {
		font-family: 'KaTeX_Math', 'KaTeX_Main', 'Cambria Math', 'STIX Two Math', 'Latin Modern Math', math, serif;
		direction: ltr;
	}
	.calc-preview {
		min-height: 1.6em;
		margin: 0.35em 0.5em 0.75em;
		text-align: right;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		color: var(--dim);
	}
	.calc-preview.err {
		color: var(--accent);
	}
	.calc-vars {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4em;
		margin-bottom: 0.9em;
		min-height: 0;
	}
	.chip {
		display: inline-flex;
		align-items: center;
		gap: 0.15em;
		background: var(--bg);
		border: 1px solid var(--gridline);
		border-radius: 999px;
		box-shadow: 0 1px 3px rgba(var(--gray), 20%);
		overflow: hidden;
	}
	.chip > button:first-child {
		border: none;
		background: none;
		font: inherit;
		font-size: 0.85rem;
		font-family: var(--font-mono);
		padding: 0.25em 0.3em 0.25em 0.75em;
		cursor: pointer;
		color: var(--fg);
	}
	.chip > button:first-child:hover {
		color: var(--accent);
	}
	.chip-del {
		border: none;
		background: none;
		font-size: 0.9rem;
		line-height: 1;
		padding: 0.25em 0.6em 0.25em 0.3em;
		cursor: pointer;
		color: var(--dim);
	}
	.chip-del:hover {
		color: var(--accent);
	}
	.calc-mode-toggle {
		display: inline-flex;
		border: 1px solid var(--gridline);
		border-radius: 8px;
		overflow: hidden;
		margin-bottom: 0.75em;
	}
	.calc-mode-toggle button {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.4em 1em;
		border: none;
		background: var(--bg);
		color: var(--dim);
		cursor: pointer;
	}
	.calc-mode-toggle button[aria-pressed='true'] {
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
	}
	.calc-mode-toggle button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: -2px;
	}
	/* The keypad is a hand-width widget: .t-main is the site-wide 1140 frame now,
	   and a 4-column keypad stretched across it would put the = key a forearm's
	   reach from the digits. 40em is the 720px measure the calculator was laid
	   out for; centred so the widget reads as a focused tool, not a ragged
	   left-aligned strip. */
	.calc-basic {
		max-width: 40em;
		margin: 0 auto;
	}
	.calc-keypad[hidden] {
		display: none;
	}
	.calc-keypad {
		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: clamp(4px, 1vw, 8px);
	}
	.calc-keypad-standard {
		grid-template-columns: repeat(4, 1fr);
	}
	.calc-keypad-standard button {
		font-size: clamp(1rem, 3.2vw, 1.2rem);
		padding: clamp(0.7em, 2.2vw, 0.95em) 0.1em;
	}
	.calc-keypad button {
		font: inherit;
		font-size: clamp(0.85rem, 2.6vw, 1.05rem);
		padding: clamp(0.55em, 1.8vw, 0.75em) 0.1em;
		border: none;
		border-radius: 8px;
		background: var(--gridline);
		color: var(--fg);
		cursor: pointer;
		transition: background 0.1s ease;
	}
	.calc-keypad button:hover {
		filter: brightness(0.95);
	}
	.calc-keypad button:active {
		transform: scale(0.96);
	}
	.calc-keypad button:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 1px;
	}
	.k-op {
		color: var(--accent);
		font-weight: 600;
	}
	.k-sci {
		background: var(--bg);
		border: 1px solid var(--gridline);
	}
	.k-fn {
		background: var(--bg);
		border: 1px solid var(--gridline);
		font-weight: 600;
	}
	.k-mode {
		background: var(--bg);
		border: 1px solid var(--accent);
		color: var(--accent);
		font-weight: 600;
		font-size: clamp(0.75rem, 2.2vw, 0.9rem);
	}
	.k-eq {
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 700;
	}
	.k-blank {
		visibility: hidden;
	}
	.calc-history {
		margin-top: 2em;
	}
	.calc-history h2 {
		/* global.css colors headings near-black — override for the tool theme */
		color: var(--fg);
		font-size: 1.25em;
		margin-bottom: 0.5em;
	}
	.calc-history ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.calc-history li + li {
		border-top: 1px solid var(--gridline);
	}
	.calc-history li button {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		width: 100%;
		border: none;
		background: none;
		font: inherit;
		font-size: 0.9rem;
		padding: 0.45em 0.3em;
		cursor: pointer;
		text-align: left;
	}
	.calc-history li button:hover {
		background: var(--gridline);
		border-radius: 6px;
	}
	.calc-history .h-expr {
		font-family: var(--font-mono);
		color: var(--fg);
		overflow-wrap: anywhere;
	}
	.calc-history .h-res {
		font-family: var(--font-mono);
		color: var(--dim);
		white-space: nowrap;
	}
	.calc-history-empty {
		color: var(--dim);
		font-size: 0.9rem;
	}
	.calc-history .k-fn {
		font-size: 0.85rem;
		padding: 0.4em 0.9em;
		border-radius: 6px;
	}
</style>
