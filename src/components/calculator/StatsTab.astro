<div class="stats-tab">
	<label for="stats-input" class="stats-label">
		Data — separated by spaces, commas, semicolons or new lines
	</label>
	<textarea
		id="stats-input"
		rows="4"
		spellcheck="false"
		placeholder="e.g. 12  15  15  9  27&#10;or 12, 15, 15, 9, 27"
	></textarea>
	<p id="stats-invalid" class="stats-invalid" hidden></p>
	<table class="stats-table">
		<tbody id="stats-body"></tbody>
	</table>
	<p class="stats-empty" id="stats-empty">Enter numbers above to see statistics.</p>
</div>

<style>
	.stats-label {
		display: block;
		font-size: 0.9rem;
		color: rgb(var(--gray));
		margin-bottom: 0.35em;
	}
	#stats-input {
		width: 100%;
		box-sizing: border-box;
		font-family: ui-monospace, 'SFMono-Regular', Consolas, Menlo, monospace;
		font-size: 1rem;
		padding: 0.6em 0.75em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: white;
		color: rgb(var(--black));
		resize: vertical;
	}
	#stats-input:focus {
		outline: 2px solid var(--accent);
		outline-offset: -1px;
	}
	.stats-invalid {
		font-size: 0.85rem;
		color: var(--accent-dark);
		margin: 0.5em 0 0;
	}
	.stats-table {
		width: 100%;
		border-collapse: collapse;
		margin-top: 1.25em;
	}
	.stats-table tr + tr td,
	.stats-table tr + tr th {
		border-top: 1px solid rgb(var(--gray-light));
	}
	.stats-table th {
		text-align: left;
		font-weight: normal;
		color: rgb(var(--gray));
		padding: 0.5em 0.4em;
		font-size: 0.92rem;
	}
	.stats-table td {
		text-align: right;
		font-family: ui-monospace, 'SFMono-Regular', Consolas, Menlo, monospace;
		color: rgb(var(--black));
		padding: 0.5em 0.4em;
		font-size: 0.95rem;
	}
	.stats-empty {
		color: rgb(var(--gray));
		font-size: 0.9rem;
		margin-top: 1.25em;
	}
</style>
