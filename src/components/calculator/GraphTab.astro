<div class="graph-tab">
	<div class="graph-toolbar">
		<button type="button" data-graph-zoom="in" title="Zoom in" data-title-en="Zoom in" data-title-zh="放大"
			>+</button
		>
		<button type="button" data-graph-zoom="out" title="Zoom out" data-title-en="Zoom out" data-title-zh="缩小"
			>−</button
		>
		<button
			type="button"
			data-graph-zoom="reset"
			title="Reset view"
			data-title-en="Reset view"
			data-title-zh="重置视图"
			><span class="i18n-en">Reset</span><span class="i18n-zh">重置</span></button
		>
		<label class="graph-select">
			<span class="i18n-en">Mode</span><span class="i18n-zh">模式</span>
			<select id="graph-mode">
				<option value="cartesian" selected data-text-en="Curves (y=f(x) & Implicit)" data-text-zh="曲线模式 (函数与隐方程)">Curves (y=f(x) & Implicit)</option>
				<option value="complex" data-text-en="Complex Domain (f(z))" data-text-zh="复变函数域着色 (f(z))">Complex Domain (f(z))</option>
				<option value="vector" data-text-en="Vector Field (dy/dx)" data-text-zh="向量场与相位图 (dy/dx)">Vector Field (dy/dx)</option>
			</select>
		</label>
		<button
			type="button"
			id="graph-fs"
			title="Toggle fullscreen"
			data-title-en="Toggle fullscreen"
			data-title-zh="全屏展示"
			aria-label="Toggle fullscreen"
			data-aria-en="Toggle fullscreen"
			data-aria-zh="全屏展示"
			><span class="i18n-en">Fullscreen</span><span class="i18n-zh">全屏</span></button
		>
		<span class="graph-hint">
			<span class="i18n-en">scroll to zoom · drag to pan · pinch on touch</span><span class="i18n-zh"
				>滚轮缩放 · 拖动平移 · 触屏双指缩放</span
			>
		</span>
	</div>
	<div class="graph-viewport">
		<canvas id="graph-gl" class="graph-canvas-gl" aria-hidden="true"></canvas>
		<canvas
			id="graph-canvas"
			class="graph-canvas-2d"
			aria-label="Function graph plot"
			data-aria-en="Function graph plot"
			data-aria-zh="函数图像画布"></canvas>
	</div>
	<div id="graph-rows" class="graph-rows"></div>
	<button id="graph-add" type="button" class="graph-add"
		><span class="i18n-en">+ Add function</span><span class="i18n-zh">+ 添加函数</span></button
	>
</div>

<style is:global>
	/* is:global: function rows are created at runtime and would not receive
	   the scoped data-astro-cid attribute */
	.graph-toolbar {
		display: flex;
		align-items: center;
		gap: 0.4em;
		margin-bottom: 0.75em;
		flex-wrap: wrap;
	}
	.graph-toolbar button {
		font: inherit;
		font-size: 0.9rem;
		min-width: 2.2em;
		padding: 0.35em 0.7em;
		border: 1px solid var(--gridline);
		border-radius: 6px;
		background: var(--bg);
		color: var(--fg);
		cursor: pointer;
	}
	.graph-toolbar button:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
	.graph-toolbar button:focus-visible {
		outline: 2px solid var(--accent);
	}
	.graph-hint {
		margin-left: auto;
		font-size: 0.8rem;
		color: var(--dim);
	}
	.graph-select {
		display: inline-flex;
		align-items: center;
		gap: 0.35em;
		font-size: 0.8rem;
		color: var(--dim);
	}
	.graph-select select {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.3em 0.5em;
		border: 1px solid var(--gridline);
		border-radius: 6px;
		background: var(--bg);
		color: var(--fg);
	}
	.graph-select select:focus-visible {
		outline: 2px solid var(--accent);
	}
	.graph-viewport {
		position: relative;
		width: 100%;
		height: clamp(280px, 55vw, 480px);
		border: 1px solid var(--gridline);
		border-radius: 10px;
		background: var(--bg);
		overflow: hidden;
		touch-action: none;
		cursor: crosshair;
	}
	.graph-tab:fullscreen,
	.graph-tab.is-fullscreen {
		position: fixed;
		inset: 0;
		width: 100vw;
		height: 100vh;
		max-width: 100vw;
		z-index: 1000;
		background: var(--bg);
		padding: 1.25rem 2rem;
		box-sizing: border-box;
		display: flex;
		flex-direction: column;
		overflow-y: auto;
	}
	.graph-tab:fullscreen .graph-viewport,
	.graph-tab.is-fullscreen .graph-viewport {
		flex: 1 1 auto;
		min-height: 360px;
		height: calc(100vh - 240px);
	}
	#graph-gl,
	#graph-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	#graph-gl {
		z-index: 1;
		pointer-events: none;
	}
	#graph-canvas {
		z-index: 2;
		background: transparent;
		touch-action: none;
		cursor: crosshair;
	}
	.graph-rows {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
		margin-top: 1em;
	}
	.graph-row {
		display: flex;
		align-items: center;
		gap: 0.6em;
	}
	.graph-swatch {
		flex: none;
		width: 14px;
		height: 14px;
		border-radius: 50%;
	}
	.graph-row input[type='text'] {
		flex: 1;
		font-family: var(--font-mono);
		font-size: 0.95rem;
		padding: 0.45em 0.7em;
		border: 1px solid var(--gridline);
		border-radius: 8px;
		background: var(--bg);
		color: var(--fg);
	}
	.graph-row input[type='text']:focus {
		outline: 2px solid var(--accent);
		outline-offset: -1px;
	}
	.graph-row input[type='checkbox'] {
		flex: none;
		width: 1.1em;
		height: 1.1em;
		accent-color: var(--accent);
	}
	.graph-row .row-error {
		flex: none;
		font-size: 0.78rem;
		color: var(--accent);
		max-width: 40%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.graph-row .row-remove {
		flex: none;
		border: none;
		background: none;
		font-size: 1.1rem;
		line-height: 1;
		padding: 0.2em 0.4em;
		color: var(--dim);
		cursor: pointer;
	}
	.graph-row .row-remove:hover {
		color: var(--accent);
	}
	.graph-add {
		margin-top: 0.6em;
		font: inherit;
		font-size: 0.9rem;
		padding: 0.4em 1em;
		border: 1px dashed var(--dim);
		border-radius: 8px;
		background: none;
		color: var(--fg);
		cursor: pointer;
	}
	.graph-add:hover:not(:disabled) {
		border-color: var(--accent);
		color: var(--accent);
	}
	.graph-add:disabled {
		opacity: 0.4;
		cursor: not-allowed;
	}
</style>
