---
import HeaderLink from './HeaderLink.astro';
import SiteLogo from './SiteLogo.astro';
import ToolSearchModal from './tools/ToolSearchModal.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="nav-left">
			<h2>
				<a href="/" class="site-branding">
					<SiteLogo size={24} />
					<span>{SITE_TITLE}</span>
				</a>
			</h2>
			<div class="nav-links">
				<HeaderLink href="/"><span class="i18n-en">Home</span><span class="i18n-zh">首页</span></HeaderLink>
				<HeaderLink href="/blog"><span class="i18n-en">Blog</span><span class="i18n-zh">博客</span></HeaderLink>
				<HeaderLink href="/calculators/standard"><span class="i18n-en">Calculator</span><span class="i18n-zh">计算器</span></HeaderLink>
				<HeaderLink href="/clock"><span class="i18n-en">Clock</span><span class="i18n-zh">时钟</span></HeaderLink>
				<HeaderLink href="/calendar"><span class="i18n-en">Calendar</span><span class="i18n-zh">日历</span></HeaderLink>
				<HeaderLink href="/tools"><span class="i18n-en">Tools</span><span class="i18n-zh">工具箱</span></HeaderLink>
				<HeaderLink href="/about"><span class="i18n-en">About</span><span class="i18n-zh">关于</span></HeaderLink>
			</div>
		</div>
		<div class="nav-right">
			<button class="search-modal-btn" type="button" id="header-search-btn" aria-label="Search tools / 搜索工具 (快捷键 /)" title="搜索工具 (快捷键 / 或 Ctrl+K)">
				<span class="search-btn-icon" aria-hidden="true">🔍</span>
				<span class="search-btn-text"><span class="i18n-en">Search</span><span class="i18n-zh">搜索</span></span>
				<kbd class="search-btn-kbd">/</kbd>
			</button>
			<button class="lang-toggle" type="button" aria-label="Toggle language / 切换语言">中 / EN</button>
			<button class="theme-toggle" type="button" aria-label="Toggle light / dark theme">☾</button>
			<a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener" class="header-github-link">
				<span class="sr-only">Source code on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
			<button class="mobile-menu-btn" type="button" id="mobile-menu-toggle" aria-label="Toggle navigation menu / 打开菜单" aria-expanded="false" aria-controls="mobile-nav-panel">
				<span class="hamburger-box" aria-hidden="true">
					<span class="bar bar-top"></span>
					<span class="bar bar-mid"></span>
					<span class="bar bar-bot"></span>
				</span>
			</button>
		</div>
	</nav>

	<!-- Mobile Navigation Drawer -->
	<div class="mobile-nav-panel" id="mobile-nav-panel" aria-hidden="true">
		<div class="mobile-nav-inner">
			<div class="mobile-nav-links">
				<HeaderLink href="/" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">🏠</span>
					<span class="i18n-en">Home</span><span class="i18n-zh">首页</span>
				</HeaderLink>
				<HeaderLink href="/blog" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">📝</span>
					<span class="i18n-en">Blog</span><span class="i18n-zh">博客文章</span>
				</HeaderLink>
				<HeaderLink href="/calculators/standard" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">🧮</span>
					<span class="i18n-en">Calculator</span><span class="i18n-zh">科学计算器</span>
				</HeaderLink>
				<HeaderLink href="/clock" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">⏱️</span>
					<span class="i18n-en">Clock</span><span class="i18n-zh">全屏时钟</span>
				</HeaderLink>
				<HeaderLink href="/calendar" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">📅</span>
					<span class="i18n-en">Calendar</span><span class="i18n-zh">全屏日历</span>
				</HeaderLink>
				<HeaderLink href="/tools" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">🛠️</span>
					<span class="i18n-en">Tools Hub</span><span class="i18n-zh">实用工具箱</span>
				</HeaderLink>
				<HeaderLink href="/about" class="mobile-nav-item">
					<span class="mobile-nav-icon" aria-hidden="true">👤</span>
					<span class="i18n-en">About</span><span class="i18n-zh">关于本站</span>
				</HeaderLink>
			</div>
			<div class="mobile-nav-footer">
				<a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener" class="mobile-github-link">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="18" height="18" fill="currentColor">
						<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path>
					</svg>
					<span>GitHub Source</span>
				</a>
			</div>
		</div>
	</div>
	<ToolSearchModal />
</header>

<script>
	// Language toggle (localStorage "site:lang")
	const langBtn = document.querySelector<HTMLButtonElement>('.lang-toggle');
	const updateLangUI = (lang: string) => {
		langBtn?.setAttribute(
			'aria-label',
			lang === 'zh' ? '当前语言: 中文 (点击切换至 English)' : 'Current language: English (click for Chinese)'
		);
		if (langBtn) {
			langBtn.textContent = lang === 'zh' ? '中' : 'EN';
			langBtn.title = lang === 'zh' ? '切换为 English' : '切换为 中文';
		}
	};
	const curLang = localStorage.getItem('site:lang') || (navigator.language.startsWith('zh') ? 'zh' : 'en');
	updateLangUI(curLang);

	langBtn?.addEventListener('click', () => {
		const current = localStorage.getItem('site:lang') || (navigator.language.startsWith('zh') ? 'zh' : 'en');
		const next = current === 'zh' ? 'en' : 'zh';
		localStorage.setItem('site:lang', next);
		document.documentElement.dataset.lang = next;
		document.documentElement.lang = next === 'zh' ? 'zh-CN' : 'en';
		updateLangUI(next);
		window.dispatchEvent(new CustomEvent('site:lang-change', { detail: next }));
	});

	// three-state theme cycle shared with the tool pages (localStorage "site:theme")
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const order = ['auto', 'light', 'dark'] as const;
	const glyphs = { auto: '◐', light: '☀', dark: '☾' } as const;
	const apply = (mode: string): void => {
		// "auto" tracks the system preference, same as the anti-flash script in BaseHead
		document.documentElement.dataset.themeMode = mode;
		const dark =
			mode === 'dark' || (mode === 'auto' && matchMedia('(prefers-color-scheme: dark)').matches);
		if (dark) document.documentElement.dataset.theme = 'dark';
		else document.documentElement.removeAttribute('data-theme');
		button?.setAttribute('aria-label', `Theme: ${mode} (click to change)`);
	};
	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
		if ((localStorage.getItem('site:theme') ?? 'auto') === 'auto') apply('auto');
	});
	const stored = localStorage.getItem('site:theme') ?? 'auto';
	if (stored !== 'auto') apply(stored);
	button?.addEventListener('click', () => {
		const current = localStorage.getItem('site:theme') ?? 'auto';
		const next = order[(order.indexOf(current as (typeof order)[number]) + 1) % order.length];
		localStorage.setItem('site:theme', next);
		apply(next);
		button && (button.textContent = glyphs[next]);
	});
	const initial = localStorage.getItem('site:theme') ?? 'auto';
	button && (button.textContent = glyphs[initial as keyof typeof glyphs]);

	// Search modal trigger
	const searchBtn = document.getElementById('header-search-btn');
	searchBtn?.addEventListener('click', () => {
		if (typeof (window as any).openSiteSearchModal === 'function') {
			(window as any).openSiteSearchModal();
		}
	});

	// Mobile navigation drawer toggle
	const menuBtn = document.getElementById('mobile-menu-toggle');
	const navPanel = document.getElementById('mobile-nav-panel');

	const toggleMenu = (open?: boolean) => {
		const willOpen = open !== undefined ? open : !menuBtn?.classList.contains('is-open');
		if (willOpen) {
			menuBtn?.classList.add('is-open');
			menuBtn?.setAttribute('aria-expanded', 'true');
			navPanel?.classList.add('is-open');
			navPanel?.setAttribute('aria-hidden', 'false');
		} else {
			menuBtn?.classList.remove('is-open');
			menuBtn?.setAttribute('aria-expanded', 'false');
			navPanel?.classList.remove('is-open');
			navPanel?.setAttribute('aria-hidden', 'true');
		}
	};

	menuBtn?.addEventListener('click', (e) => {
		e.stopPropagation();
		toggleMenu();
	});

	// Close mobile menu when clicking any mobile nav link
	navPanel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => toggleMenu(false));
	});

	// Close on Escape key
	window.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && menuBtn?.classList.contains('is-open')) {
			toggleMenu(false);
		}
	});

	// Close on click outside header
	document.addEventListener('click', (e) => {
		const header = document.querySelector('header');
		if (menuBtn?.classList.contains('is-open') && header && !header.contains(e.target as Node)) {
			toggleMenu(false);
		}
	});

	// Automatically close mobile menu when resizing to desktop width
	window.addEventListener('resize', () => {
		if (window.innerWidth > 768 && menuBtn?.classList.contains('is-open')) {
			toggleMenu(false);
		}
	});
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in srgb, var(--bg) 82%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--gridline);
	}
	nav {
		/* --w-max, not --w-wide: the home page container is --w-max, so at 960px
		   the nav's content edge sat 40px inside the page's own edge — a step
		   that is invisible at 1440px and obvious on an ultrawide, where it also
		   made the page frame jump between routes. The gutter is folded into the
		   width expression like every other container, so box-sizing stays
		   irrelevant. */
		width: min(var(--w-max), 100% - 2.5em);
		margin: 0 auto;
		padding: 0.7em 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.nav-left {
		display: flex;
		align-items: baseline;
		gap: 1.75em;
		min-width: 0;
	}
	h2 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		white-space: nowrap;
	}
	h2 a,
	h2 a.active {
		color: var(--fg);
		text-decoration: none;
	}
	.site-branding {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
	}
	h2 a:hover {
		color: var(--accent);
		text-decoration: none;
	}
	.nav-links {
		display: flex;
		align-items: baseline;
		gap: 1.1em;
		overflow-x: auto;
		scrollbar-width: none;
	}
	.nav-links::-webkit-scrollbar {
		display: none;
	}
	.nav-right {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.search-modal-btn {
		border: 1px solid var(--gridline);
		background: transparent;
		color: var(--dim);
		border-radius: 8px;
		height: 34px;
		padding: 0 0.65em;
		font-size: 13px;
		font-weight: 600;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.search-modal-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
		background: rgba(var(--accent-rgb, 59, 130, 246), 0.08);
	}
	.search-btn-icon {
		font-size: 13px;
	}
	.search-btn-text {
		font-size: 12.5px;
	}
	.search-btn-kbd {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-family: var(--font-mono, monospace);
		font-size: 11px;
		font-weight: 700;
		padding: 0.05rem 0.3rem;
		border-radius: 4px;
		background: var(--bg);
		color: var(--dim);
		border: 1px solid var(--gridline);
		margin-left: 0.15rem;
	}
	.lang-toggle {
		border: 1px solid var(--gridline);
		background: transparent;
		color: var(--dim);
		border-radius: 8px;
		height: 34px;
		padding: 0 0.6em;
		font-size: 12.5px;
		font-weight: 700;
		cursor: pointer;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.lang-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.theme-toggle {
		border: 1px solid var(--gridline);
		background: transparent;
		color: var(--dim);
		border-radius: 8px;
		width: 34px;
		height: 34px;
		font-size: 15px;
		line-height: 1;
		cursor: pointer;
		display: grid;
		place-items: center;
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.theme-toggle:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.nav-right a {
		color: var(--dim);
		display: grid;
		place-items: center;
		width: 34px;
		height: 34px;
		border-radius: 8px;
		border: 1px solid var(--gridline);
		transition:
			color 0.15s ease,
			border-color 0.15s ease;
	}
	.nav-right a:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
	/* Mobile menu button */
	.mobile-menu-btn {
		display: none;
		border: 1px solid var(--gridline);
		background: transparent;
		color: var(--dim);
		border-radius: 8px;
		width: 34px;
		height: 34px;
		cursor: pointer;
		padding: 0;
		align-items: center;
		justify-content: center;
		transition:
			color 0.15s ease,
			border-color 0.15s ease,
			background 0.15s ease;
	}
	.mobile-menu-btn:hover {
		color: var(--accent);
		border-color: var(--accent);
	}
	.hamburger-box {
		width: 16px;
		height: 12px;
		position: relative;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
	}
	.hamburger-box .bar {
		display: block;
		width: 100%;
		height: 2px;
		background: currentColor;
		border-radius: 2px;
		transition:
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.2s ease;
		transform-origin: center;
	}
	.mobile-menu-btn.is-open .bar-top {
		transform: translateY(5px) rotate(45deg);
	}
	.mobile-menu-btn.is-open .bar-mid {
		opacity: 0;
		transform: scaleX(0);
	}
	.mobile-menu-btn.is-open .bar-bot {
		transform: translateY(-5px) rotate(-45deg);
	}

	/* Mobile drawer panel */
	.mobile-nav-panel {
		display: none;
		max-height: 0;
		opacity: 0;
		overflow: hidden;
		transition:
			max-height 0.32s cubic-bezier(0.16, 1, 0.3, 1),
			opacity 0.22s ease;
		background: color-mix(in srgb, var(--bg) 96%, transparent);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid var(--gridline);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.08);
	}
	.mobile-nav-panel.is-open {
		max-height: 85vh;
		opacity: 1;
		overflow-y: auto;
	}
	.mobile-nav-inner {
		padding: 0.85rem 1.25rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}
	.mobile-nav-links {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.35rem;
	}
	.mobile-nav-item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.65rem 0.85rem;
		border-radius: 8px;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--fg);
		background: transparent;
		transition:
			background 0.15s ease,
			color 0.15s ease;
	}
	.mobile-nav-item:hover,
	.mobile-nav-item:active {
		background: rgba(var(--accent-rgb, 59, 130, 246), 0.08);
		color: var(--accent);
	}
	.mobile-nav-item.active {
		background: rgba(var(--accent-rgb, 59, 130, 246), 0.12);
		color: var(--accent);
		font-weight: 700;
	}
	.mobile-nav-icon {
		font-size: 1.15rem;
		width: 1.5rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
	}
	.mobile-nav-footer {
		padding-top: 0.75rem;
		border-top: 1px solid var(--gridline);
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
	.mobile-github-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--dim);
		text-decoration: none;
		padding: 0.4rem 0.6rem;
		border-radius: 6px;
		transition: color 0.15s ease;
	}
	.mobile-github-link:hover {
		color: var(--accent);
	}

	@media (max-width: 768px) {
		nav {
			width: min(var(--w-max), 100% - 2em);
			padding: 0.6em 0;
		}
		.nav-left {
			gap: 0.75em;
		}
		.nav-links {
			display: none; /* Hidden on mobile; cleanly moved to mobile-nav-panel drawer */
		}
		.mobile-menu-btn {
			display: inline-flex;
		}
		.mobile-nav-panel {
			display: block;
		}
	}

	@media (max-width: 600px) {
		.search-btn-text,
		.search-btn-kbd {
			display: none;
		}
		.search-modal-btn {
			width: 34px;
			padding: 0;
			justify-content: center;
		}
		.header-github-link {
			display: none; /* Moved inside mobile drawer */
		}
		.nav-right {
			gap: 0.4rem;
		}
		h2 {
			font-size: 0.95rem;
		}
		.site-branding {
			gap: 0.45rem;
		}
	}
</style>
