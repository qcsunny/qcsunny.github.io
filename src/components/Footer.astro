---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	&copy; {today.getFullYear()} {SITE_TITLE}
	<nav class="footer-links">
		<a href="/">博客</a>
		<a href="/tools/">工具</a>
		<a href="/about/">关于</a>
		<a href="/privacy/">隐私政策</a>
		<a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener">GitHub</a>
	</nav>
</footer>
<style>
	footer {
		padding: 2.5em 1em 5em;
		background: var(--bg);
		color: var(--dim);
		text-align: center;
		border-top: 1px solid var(--gridline);
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.4em 1.2em;
		margin-top: 1em;
	}
	.footer-links a {
		text-decoration: none;
		color: var(--dim);
		transition: color 0.15s ease;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
</style>
