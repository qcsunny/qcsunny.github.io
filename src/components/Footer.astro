---
import { SITE_TITLE } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-copy">&copy; {today.getFullYear()} {SITE_TITLE}</div>
	<nav class="footer-links">
		<a href="/"><span class="i18n-en">Blog</span><span class="i18n-zh">博客</span></a>
		<a href="/tools/"><span class="i18n-en">Tools</span><span class="i18n-zh">工具箱</span></a>
		<a href="/about/"><span class="i18n-en">About</span><span class="i18n-zh">关于</span></a>
		<a href="/privacy/"><span class="i18n-en">Privacy</span><span class="i18n-zh">隐私政策</span></a>
		<a href="mailto:admin@qcsunny.org" class="footer-email">admin@qcsunny.org</a>
		<a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener">GitHub</a>
	</nav>
</footer>
<style>
	footer {
		padding: 2.5em 1em 5em;
		background: var(--bg);
		color: var(--dim);
		text-align: center;
		border-top: 1px solid var(--gridline);
		font-size: 0.95rem;
	}
	.footer-copy {
		margin-bottom: 0.5em;
	}
	.footer-links {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 0.4em 1.2em;
		margin-top: 0.8em;
	}
	.footer-links a {
		text-decoration: none;
		color: var(--dim);
		transition: color 0.15s ease;
	}
	.footer-links a:hover {
		color: var(--accent);
	}
	.footer-email {
		font-family: var(--font-mono, monospace);
		font-size: 0.9em;
		opacity: 0.9;
	}
</style>
