---
import DynamicToolPage from '../../components/tools/DynamicToolPage.astro';
import { REGISTRY, type ToolEntry } from '../../tools/registry';

export function getStaticPaths() {
	return REGISTRY
		.filter((e) => e.category === 'media')
		.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props as { entry: ToolEntry };
---

<DynamicToolPage entry={entry} category="media" />

<script>
	import '../../scripts/tools/main';
</script>
