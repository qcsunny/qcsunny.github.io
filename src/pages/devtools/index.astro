---
// devtools hub: the single-category view for developer tools. Title, Chinese
// title and blurb come from CATEGORIES so the copy lives in one place; only
// the search placeholder is bespoke to this page. The breadcrumb on a
// /devtools/<slug>/ page links here, mirroring how finance, calculators and
// converters each have their own category hub.
import ToolShell from '../../components/tools/ToolShell.astro';
import ToolSearchBar from '../../components/tools/ToolSearchBar.astro';
import { CATEGORIES, REGISTRY } from '../../tools/registry';

const cat = CATEGORIES.find((c) => c.id === 'devtools')!;
const entries = REGISTRY.filter((e) => e.category === 'devtools' && e.kind !== 'redirect');
---

<ToolShell title={cat.label} titleZh={cat.labelZh} description={cat.blurb}>
	<ToolSearchBar category="devtools" placeholder="Search developer tools (e.g. JSON, SQL, YAML, base64, UUID, QR)..." placeholderZh="搜索开发调试工具 (如 JSON、SQL、YAML、Base64、UUID、二维码)..." totalCount={entries.length} />
	<div class="t-cards">
		{
			entries.map((e) => (
				<a class="t-card" href={`/${e.category}/${e.slug}/`} data-slug={e.slug} data-cat={e.category}>
					<h2>
						<span class="i18n-en">{e.name}</span>
						<span class="i18n-zh">{e.nameZh || e.name}</span>
					</h2>
					<p>
						<span class="i18n-en">{e.description}</span>
						{e.descriptionZh && <span class="i18n-zh">{e.descriptionZh}</span>}
					</p>
				</a>
			))
		}
	</div>
</ToolShell>
