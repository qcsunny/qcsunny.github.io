---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About — ${SITE_TITLE}`} description="About QCSunny: a personal blog and a collection of 34 free browser-based tools." />
	</head>
	<body>
		<Header />
		<main class="about-main">
			<h1>About</h1>
			<p>
				I'm QCSunny — a developer who writes about web development, tooling and the small
				utilities that make everyday computing easier. This site has two halves: a
				<a href="/">blog</a> and a growing set of <a href="/tools/">free online tools</a>.
			</p>
			<p>
				The tools — scientific calculator, unit converters, finance calculators, QR code
				generator, password/UUID generators and more — are all hand-written with zero tracking
				script weight. Every calculation runs entirely in your browser: nothing you type is
				uploaded, stored or logged, and the pages keep working offline once loaded.
			</p>
			<section lang="zh-CN">
				<h2>关于本站</h2>
				<p>
					我是 QCSunny，一名开发者，关注 Web 开发、工具链以及让日常计算更省事的小工具。本站分为两部分：
					<a href="/">博客</a>与一套持续扩充的<a href="/tools/">免费在线工具</a>。
				</p>
				<p>
					工具部分——科学计算器、单位换算、金融计算器、二维码生成器、密码/UUID 生成器等——全部手写实现，
					不加载任何追踪脚本。所有计算均在浏览器本地完成：你输入的内容不会被上传、存储或记录，页面加载后离线也能继续使用。
				</p>
			</section>
			<p>
				Source code and issue reports live on
				<a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener">GitHub</a>.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.about-main {
		/* min() keeps the column inside small viewports (global main's
		   max-width would otherwise be overridden by this rule) */
		max-width: min(42rem, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 2.5rem 1.25rem;
		font-size: 1.05rem;
		line-height: 1.75;
	}
	h1 {
		color: var(--fg);
		font-size: 1.8rem;
	}
	h2 {
		color: var(--fg);
	}
	a {
		color: var(--accent);
	}
	section[lang="zh-CN"] {
		line-height: 1.9;
	}
</style>
