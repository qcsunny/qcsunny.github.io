---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SupportBox from '../components/SupportBox.astro';
import { getCollection } from 'astro:content';
import { SITE_TITLE } from '../consts';
import { CALCULATOR_FEATURED, REGISTRY } from '../tools/registry';

// About-page numbers are computed, not typed: the same union the homepage and
// ToolShell use, minus the redirect stubs that only carry legacy URLs.
const realTools = [...CALCULATOR_FEATURED, ...REGISTRY].filter((e) => e.kind !== 'redirect');
const toolTotal = realTools.length;
const postTotal = (await getCollection('blog')).length;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About / 关于本站 — ${SITE_TITLE}`}
			description={`About QCSunny Lab: an engineering blog and a collection of ${toolTotal} free, client-side, zero-telemetry browser tools.`}
		/>
	</head>
	<body>
		<Header />
		<main class="about-main">
			<div class="i18n-en">
				<h1>About QCSunny Lab</h1>
				<p class="about-lead">I’m <strong>QCSunny</strong>, a software engineer focused on modern web
				technology, algorithm design, and developer-productivity tools. QCSunny Lab is where I hand-build
				browser-native utilities and then write up how they actually behave — one address for each tool and
				the engineering notes behind it.</p>
			
				<h2>What This Site Actually Is</h2>
				<p>A dependency-free static site holding <strong>{toolTotal} in-browser tools</strong> and
				<strong>{postTotal} engineering posts</strong>. The tools run on hand-written, vanilla-TypeScript
				code — no runtime framework — and the engines behind them (the calculator parser, the SQL
				tokenizer, Reed–Solomon error correction) are first-party rather than imported. Each post is the
				engineering record of that work.</p>
				<p>Data you type into a tool stays on the page: there is no backend to receive it, by
				construction. The whole source is public and rebuilt from CI on every push.</p>
			
				<h2>Built from Scratch, Then Measured</h2>
				<ul class="about-list">
					<li><strong>Hand-written engines:</strong> the QR encoder is ~400 lines of self-authored
					Reed–Solomon; Markdown parsing, the SQL tokenizer and the calculator engine are first-party code,
					not library wrappers.</li>
					<li><strong>Measured, not assumed:</strong> posts cite numbers taken from the running site — a 3-D
					surface plot spends 18 ms of a 181 ms frame on rasterization; this homepage ships 50 KB, 58% of it
					fonts; KaTeX ships as stylesheet only, with no CDN script left to break.</li>
					<li><strong>Gated by tests:</strong> every deploy waits on a browser E2E suite of 150+ cases,
					which is what catches a dead calculator button or a two-language label leak before it ships.</li>
				</ul>
			
				<h2>Design Decisions, With Reasons</h2>
				<div class="about-features">
					<div class="about-feature-card">
						<div class="feature-icon">🔒</div>
						<div class="feature-content">
							<strong>Privacy is structural, not a setting</strong>
							<p>Tools run entirely inside the page, so input never reaches a server — nothing to configure, nothing to leak, and it works offline once loaded.</p>
						</div>
					</div>
					<div class="about-feature-card">
						<div class="feature-icon">⚡</div>
						<div class="feature-content">
							<strong>No dependency left to go stale</strong>
							<p>Hand-written engines over imported ones, and the trade-offs are measured and written up rather than assumed.</p>
						</div>
					</div>
					<div class="about-feature-card">
						<div class="feature-icon">🌐</div>
						<div class="feature-content">
							<strong>Shipping runs a gauntlet</strong>
							<p>A browser-test suite must pass before any build reaches the live edge; a red build blocks the deploy.</p>
						</div>
					</div>
					<div class="about-feature-card">
						<div class="feature-icon">🌍</div>
						<div class="feature-content">
							<strong>Bilingual at writing time</strong>
							<p>Every page is written in English and Simplified Chinese together, never translated after the fact; one attribute flips the whole site, tool errors and chart legends included.</p>
						</div>
					</div>
				</div>
			
				<h2>Inside the Notebook</h2>
				<ul class="about-list">
					<li><a href="/blog/qr-code-reed-solomon-encoder/">QR Reed–Solomon error correction, ~400 lines, dependency-free</a></li>
					<li><a href="/blog/markdown-parser-and-katex-math/">Writing a Markdown parser, and why you should not write a LaTeX renderer</a></li>
					<li><a href="/blog/uuid-v4-vs-v7-database-guide/">Why modern database primary keys are moving to UUID v7</a></li>
					<li><a href="/blog/static-site-byte-ledger/">The byte ledger of this very site</a></li>
					<li><a href="/blog/hidden-cost-of-installments-and-irr/">What a 3% “handling fee” loan really costs — the IRR math</a></li>
				</ul>
				<p>All {postTotal} posts live under <a href="/blog/">/blog/</a>.</p>
			
				<h2>Open Source &amp; Contact</h2>
				<p>The source code for this site is open and hosted on <a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener">GitHub</a>. Bug reports, feature requests, and suggestions are always welcome via <a href="https://github.com/qcsunny/qcsunny.github.io/issues" target="_blank" rel="noopener">GitHub Issues</a>.</p>
				<p>For general inquiries, collaboration, or feedback, you can reach me directly by email at: <a href="mailto:admin@qcsunny.org">admin@qcsunny.org</a>.</p>
			</div>

			<div class="i18n-zh">
				<h1>关于本站 (QCSunny Lab)</h1>
				<p class="about-lead">我是 <strong>QCSunny</strong>，一名专注于现代 Web 技术、算法设计与开发者效率工具的
				软件工程师。这个站是我亲手实现浏览器端工具、再把它们的真实行为写出来的地方——每个工具和它背后的工程
				手记，在同一个地址下。</p>
			
				<h2>这个站到底是什么</h2>
				<p>一个零依赖的静态站，放着 <strong>{toolTotal} 款纯浏览器工具</strong>与 <strong>{postTotal} 篇工程手记</strong>。
				工具都是为本站手写的原生 TypeScript——不依赖运行时框架；背后的引擎（计算器解析器、SQL 分词器、
				Reed–Solomon 纠错）全是第一方实现，不是套壳。每篇手记就是这些工作的工程档案。</p>
				<p>你在任何工具里输入的数据都只留在当前页面——结构上就没有后端去接收它。全部源码公开，每次推送由
				CI 重新构建发布。</p>
			
				<h2>从零手写，再拿数据验证</h2>
				<ul class="about-list">
					<li><strong>引擎都是自己写的：</strong>二维码编码器约 400 行自写 Reed–Solomon；Markdown 解析、SQL 分词器、
					计算器引擎都是第一方代码，不是库的壳。</li>
					<li><strong>先测量再下结论：</strong>手记引用的是跑在真站上的数字——三维曲面一帧 181ms 里只有 18ms
					在光栅化；这份首页 50KB 里 58% 是字体；KaTeX 只发样式表，没有会失效的 CDN 脚本。</li>
					<li><strong>用测试守门：</strong>每次部署前要跑 150+ 条浏览器 E2E，计算器按键静默失效、双语标签泄漏
					这类回归，就是靠它在上线前拦下来的。</li>
				</ul>
			
				<h2>每条设计决策都有理由</h2>
				<div class="about-features">
					<div class="about-feature-card">
						<div class="feature-icon">🔒</div>
						<div class="feature-content">
							<strong>隐私是结构性的，不是一个开关</strong>
							<p>所有工具都在页面内运行，输入根本不会到服务器——没什么可配置，也没什么可泄漏，载入后断网可用。</p>
						</div>
					</div>
					<div class="about-feature-card">
						<div class="feature-icon">⚡</div>
						<div class="feature-content">
							<strong>不留依赖去腐烂</strong>
							<p>能自己写的就自己写，代价用测量和文章讲清楚，而不是靠假设。</p>
						</div>
					</div>
					<div class="about-feature-card">
						<div class="feature-icon">🌐</div>
						<div class="feature-content">
							<strong>上线要过一道闸</strong>
							<p>浏览器测试全绿才允许部署，出现红就直接阻断发布。</p>
						</div>
					</div>
					<div class="about-feature-card">
						<div class="feature-icon">🌍</div>
						<div class="feature-content">
							<strong>双语是写出来的，不是翻出来的</strong>
							<p>每页同时用中文与英文创作，而非发布后翻译；单一属性切换全站，计算器报错与图表图例一起切。</p>
						</div>
					</div>
				</div>
			
				<h2>手记里都有什么</h2>
				<ul class="about-list">
					<li><a href="/blog/qr-code-reed-solomon-encoder/">二维码 Reed–Solomon 纠错：约 400 行、零依赖手写</a></li>
					<li><a href="/blog/markdown-parser-and-katex-math/">手写 Markdown 解析器，与一个不该自己写的 LaTeX 排版器</a></li>
					<li><a href="/blog/uuid-v4-vs-v7-database-guide/">为什么现代数据库主键推荐 UUID v7</a></li>
					<li><a href="/blog/static-site-byte-ledger/">这份站自己的字节账：首屏成本实测</a></li>
					<li><a href="/blog/hidden-cost-of-installments-and-irr/">3% 手续费的分期，真实年化（IRR）有多高</a></li>
				</ul>
				<p>全部 {postTotal} 篇都在 <a href="/blog/">博客</a>。</p>
			
				<h2>开源与联系</h2>
				<p>本站源码完全公开开源，托管于 <a href="https://github.com/qcsunny/qcsunny.github.io" target="_blank" rel="noopener">GitHub</a>。若在使用过程中发现任何问题或有新工具需求，非常欢迎在 <a href="https://github.com/qcsunny/qcsunny.github.io/issues" target="_blank" rel="noopener">GitHub Issues</a> 中提交反馈。</p>
				<p>商务合作、技术交流或建议咨询，可通过电子邮箱直接与我联系：<a href="mailto:admin@qcsunny.org">admin@qcsunny.org</a>。</p>
			</div>

			<!-- Bilingual, so it sits outside both language blocks -->
			<SupportBox />
		</main>
<Footer />

		<script is:inline>
			(() => {
				const titles = {
					en: 'About — QCSunny Lab',
					zh: '关于本站 — QCSunny Lab'
				};
				function syncTitle(lang) {
					document.title = titles[lang] || titles.zh;
				}
				const cur = document.documentElement.dataset.lang || localStorage.getItem('site:lang') || 'zh';
				syncTitle(cur);
				window.addEventListener('site:lang-change', (e) => {
					syncTitle(e.detail);
				});
			})();
		</script>
	</body>
</html>

<style>
	.about-main {
		/* --w-shell, the site-wide 1140 frame the nav, home, /blog/ and the tool
		   pages all take. The prose inside keeps the --w-prose reading measure,
		   hanging off the frame's left edge like a blog post's text column —
		   18px prose stretched across 1140px would put ~63 CJK glyphs on a line,
		   past the comfortable range the measure exists to protect. */
		width: min(var(--w-shell), 100% - 2.5rem);
		margin: 0 auto;
		padding: 2.5rem 0 4rem;
		/* 18px: this page is its own reading size (blog posts moved to 16px with
		   their 820px column). --w-prose is shared, so the measure agrees across
		   the long-form pages even where the type does not. */
		font-size: 1.125rem;
		line-height: 1.8;
		color: var(--fg);
	}
	/* prose children keep the 820 reading column inside the 1140 frame. The
	   feature-card grid now does too — four cards in a 2×2 grid fill that same
	   column, so the section sits inside the measure the text above and below it
	   uses, instead of stretching across the whole 1140 frame like the old
	   three-across did. */
	.about-main :where(.i18n-en, .i18n-zh) > * {
		max-width: var(--w-prose);
	}
	/* SupportBox renders its own component root, so the scope attribute never
	   reaches it — match it globally. It rides the reading column. */
	.about-main > :global(.support-box) {
		max-width: var(--w-prose);
	}
	h1 {
		color: var(--fg);
		font-size: clamp(1.8rem, 4vw, 2.3rem);
		font-weight: 800;
		margin-bottom: 0.8em;
	}
	h2 {
		color: var(--fg);
		font-size: 1.35rem;
		font-weight: 700;
		margin-top: 2em;
		margin-bottom: 0.8em;
		padding-bottom: 0.3em;
		border-bottom: 1px solid var(--gridline);
	}
	.about-lead {
		font-size: 1.12rem;
		line-height: 1.85;
		margin-bottom: 1.5em;
	}
	a {
		color: var(--accent);
		text-decoration: underline;
		text-underline-offset: 3px;
	}
	a:hover {
		opacity: 0.85;
	}
	.about-features {
		display: grid;
		/* 2×2: four cards across the 820 reading column, two per row. Each card
		   lands near 397px — wide enough for the icon-plus-prose layout, narrow
		   enough to read as a card rather than a stretched panel. Below 640px
		   even one card no longer fits the column, so it collapses to one row. */
		grid-template-columns: repeat(2, 1fr);
		gap: 1rem;
		margin: 1.2em 0 1.8em;
	}
	@media (max-width: 640px) {
		.about-features {
			grid-template-columns: 1fr;
		}
	}
	.about-feature-card {
		display: flex;
		gap: 1rem;
		align-items: flex-start;
		background: rgba(125, 144, 255, 0.05);
		border: 1px solid var(--gridline);
		border-radius: 10px;
		padding: 1rem 1.25rem;
	}
	.feature-icon {
		font-size: 1.6rem;
		line-height: 1;
		padding-top: 0.1em;
	}
	.feature-content strong {
		display: block;
		font-size: 1.05rem;
		margin-bottom: 0.3em;
		color: var(--fg);
	}
	.feature-content p {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.65;
		color: var(--dim);
	}
	.about-list {
		padding-left: 1.4rem;
		margin: 1.2em 0 1.8em;
	}
	.about-list li {
		margin-bottom: 0.8em;
		line-height: 1.7;
	}
	.about-list strong {
		color: var(--fg);
	}
</style>
