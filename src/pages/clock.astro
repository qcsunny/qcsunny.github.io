---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Clock" description="A minimal fullscreen local clock: weekday, date and 24-hour time." />
		<script is:inline>
			// Apply theme before first paint to avoid a flash
			// Modes: light / dark / auto (auto follows the browser theme)
			const saved = localStorage.getItem('clock:theme');
			const mode = saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
			document.documentElement.dataset.themeMode = mode;
			document.documentElement.dataset.theme =
				mode === 'auto'
					? matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light'
					: mode;
			// Restore the seconds toggle (affects the time font size)
			document.documentElement.dataset.seconds =
				localStorage.getItem('clock:seconds') === 'off' ? 'off' : 'on';
		</script>
		<style>
			:root {
				--bg: #ffffff;
				--fg: #000000;
				color-scheme: light;
			}
			html[data-theme='dark'] {
				--bg: #000000;
				--fg: #ffffff;
				color-scheme: dark;
			}
			* {
				margin: 0;
				padding: 0;
			}
			body {
				background: var(--bg);
				color: var(--fg);
				height: 100dvh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				font-family:
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					'Helvetica Neue',
					Arial,
					sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			.clock {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.2em;
				padding: 0 0.25em;
			}
			.weekday {
				font-size: clamp(1.25rem, 5vw, 3rem);
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.date {
				font-size: clamp(1rem, 4vw, 2.25rem);
				font-weight: 400;
				letter-spacing: 0.08em;
				color: var(--fg);
				opacity: 0.75;
			}
			.time {
				font-size: min(17vw, 30dvh);
				line-height: 1.1;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
				letter-spacing: 0.02em;
				white-space: nowrap;
			}
			/* seconds hidden: HH:MM is 5 chars instead of 8, let it fill more width */
			html[data-seconds='off'] .time {
				font-size: min(27vw, 30dvh);
			}
			.corner-group {
				position: fixed;
				top: 1em;
				right: 1em;
				display: flex;
				gap: 0.15em;
			}
			.corner-group.left {
				right: auto;
				left: 1em;
			}
			.corner {
				font-size: 0.95rem;
				opacity: 0.45;
				text-decoration: none;
				color: var(--fg);
				background: none;
				border: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0.4em 0.6em;
			}
			.corner:hover {
				opacity: 1;
			}
			/* seconds visible = button in its active state */
			.seconds-toggle[aria-pressed='true'] {
				opacity: 0.9;
			}
			.seconds-toggle[aria-pressed='true']:hover {
				opacity: 1;
			}
			.corner:focus-visible {
				outline: 2px solid currentColor;
				opacity: 1;
			}
			/* "EN" is two characters and "中" is one — a fixed width keeps the row of
			   corner buttons from shifting when the language changes. */
			.lang-toggle {
				min-width: 2.6em;
				text-align: center;
			}
			.pomodoro-toggle {
				font-variant-numeric: tabular-nums;
				min-width: 3.2em;
				text-align: center;
			}
			.pomodoro-toggle.running {
				opacity: 0.85;
			}
			.pomodoro-toggle.paused {
				opacity: 0.5;
				font-style: italic;
			}
			.pomodoro-line {
				font-size: clamp(0.9rem, 3vw, 1.6rem);
				font-weight: 500;
				letter-spacing: 0.25em;
				text-transform: uppercase;
				font-variant-numeric: tabular-nums;
				opacity: 0.55;
				white-space: nowrap;
			}
			.pomodoro-line[hidden] {
				display: none;
			}
		</style>
	</head>
	<body>
		<div class="corner-group left">
			<button class="corner pomodoro-toggle" type="button" aria-label="Start Pomodoro timer (25 minutes)">🍅</button>
			<button class="corner pomodoro-reset" type="button" aria-label="Reset Pomodoro timer" hidden>✕</button>
		</div>
		<div class="corner-group">
			<button class="corner lang-toggle" type="button" aria-label="Switch language">EN</button>
			<button class="corner seconds-toggle" type="button" aria-label="Hide seconds" aria-pressed="true">
				:ss
			</button>
			<button class="corner theme-toggle" type="button" aria-label="Toggle light / dark theme">☾</button>
		</div>
		<main class="clock" aria-live="off">
			<div class="weekday" id="clock-weekday"></div>
			<div class="date" id="clock-date"></div>
			<div class="time" id="clock-time"></div>
			<div class="pomodoro-line" id="clock-pomodoro" hidden></div>
		</main>
		<script>
			import '../scripts/clock';
		</script>
	</body>
</html>
