---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Clock" description="A minimal fullscreen local clock: weekday, date and 24-hour time." />
		<script is:inline>
			// Apply theme before first paint to avoid a flash
			// Modes: light / dark / auto (auto follows the browser theme)
			const saved = localStorage.getItem('clock:theme');
			const mode = saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
			document.documentElement.dataset.themeMode = mode;
			document.documentElement.dataset.theme =
				mode === 'auto'
					? matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light'
					: mode;
			// Restore the seconds toggle (affects the time font size)
			document.documentElement.dataset.seconds =
				localStorage.getItem('clock:seconds') === 'off' ? 'off' : 'on';
		</script>
		<style>
			:root {
				--bg: #ffffff;
				--fg: #000000;
				color-scheme: light;
			}
			html[data-theme='dark'] {
				--bg: #000000;
				--fg: #ffffff;
				color-scheme: dark;
			}
			* {
				margin: 0;
				padding: 0;
			}
			body {
				background: var(--bg);
				color: var(--fg);
				height: 100dvh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				font-family:
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					'Helvetica Neue',
					Arial,
					sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			.clock {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.2em;
				padding: 0 0.25em;
			}
			.weekday {
				font-size: clamp(1.25rem, 5vw, 3rem);
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.date {
				font-size: clamp(1rem, 4vw, 2.25rem);
				font-weight: 400;
				letter-spacing: 0.08em;
				color: var(--fg);
				opacity: 0.75;
			}
			.time {
				font-size: min(17vw, 30dvh);
				line-height: 1.1;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
				letter-spacing: 0.02em;
				white-space: nowrap;
			}
			/* seconds hidden: HH:MM is 5 chars instead of 8, let it fill more width */
			html[data-seconds='off'] .time {
				font-size: min(27vw, 30dvh);
			}
			.corner-group {
				position: fixed;
				top: 1em;
				right: 1em;
				display: flex;
				gap: 0.15em;
			}
			.corner-group.left {
				right: auto;
				left: 1em;
			}
			.corner {
				font-size: 0.95rem;
				opacity: 0.45;
				text-decoration: none;
				color: var(--fg);
				background: none;
				border: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0.4em 0.6em;
			}
			.corner:hover {
				opacity: 1;
			}
			/* seconds visible = button in its active state */
			.seconds-toggle[aria-pressed='true'] {
				opacity: 0.9;
			}
			.seconds-toggle[aria-pressed='true']:hover {
				opacity: 1;
			}
			.corner:focus-visible {
				outline: 2px solid currentColor;
				opacity: 1;
			}
			.pomodoro-toggle {
				font-variant-numeric: tabular-nums;
				min-width: 3.2em;
				text-align: center;
			}
			.pomodoro-toggle.running {
				opacity: 0.85;
			}
			.pomodoro-toggle.paused {
				opacity: 0.5;
				font-style: italic;
			}
			.pomodoro-line {
				font-size: clamp(0.9rem, 3vw, 1.6rem);
				font-weight: 500;
				letter-spacing: 0.25em;
				text-transform: uppercase;
				font-variant-numeric: tabular-nums;
				opacity: 0.55;
				white-space: nowrap;
			}
			.pomodoro-line[hidden] {
				display: none;
			}
		</style>
	</head>
	<body>
		<div class="corner-group left">
			<button class="corner pomodoro-toggle" type="button" aria-label="Start Pomodoro timer (25 minutes)">🍅</button>
			<button class="corner pomodoro-reset" type="button" aria-label="Reset Pomodoro timer" hidden>✕</button>
		</div>
		<div class="corner-group">
			<button class="corner seconds-toggle" type="button" aria-label="Hide seconds" aria-pressed="true">
				:ss
			</button>
			<button class="corner theme-toggle" type="button" aria-label="Toggle light / dark theme">☾</button>
		</div>
		<main class="clock" aria-live="off">
			<div class="weekday" id="clock-weekday"></div>
			<div class="date" id="clock-date"></div>
			<div class="time" id="clock-time"></div>
			<div class="pomodoro-line" id="clock-pomodoro" hidden></div>
		</main>
		<script is:inline>
			const weekdayEl = document.getElementById('clock-weekday');
			const dateEl = document.getElementById('clock-date');
			const timeEl = document.getElementById('clock-time');
			const root = document.documentElement;

			function render() {
				const now = new Date();
				weekdayEl.textContent = now.toLocaleDateString('en-US', { weekday: 'long' });
				dateEl.textContent = now.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				});
				const p = (n) => String(n).padStart(2, '0');
				const showSeconds = () => document.documentElement.dataset.seconds !== 'off';
				timeEl.textContent = showSeconds()
					? `${p(now.getHours())}:${p(now.getMinutes())}:${p(now.getSeconds())}`
					: `${p(now.getHours())}:${p(now.getMinutes())}`;
			}

			render();

			// Seconds toggle: show / hide the seconds part of the time
			const secondsToggle = document.querySelector('.seconds-toggle');

			function syncSecondsButton() {
				const off = root.dataset.seconds === 'off';
				secondsToggle.setAttribute('aria-pressed', String(!off));
				secondsToggle.setAttribute('aria-label', off ? 'Show seconds' : 'Hide seconds');
			}

			secondsToggle.addEventListener('click', () => {
				root.dataset.seconds = root.dataset.seconds === 'off' ? 'on' : 'off';
				try {
					localStorage.setItem('clock:seconds', root.dataset.seconds);
				} catch {
					/* storage unavailable — choice just won't persist */
				}
				syncSecondsButton();
				render();
			});

			syncSecondsButton();

			// Pomodoro: 🍅 click starts a 25-min focus countdown, then a 5-min
			// break. While running: click pauses/resumes, ✕ resets. State is
			// stored as timestamps so a page refresh resumes the countdown.
			const POMO_KEY = 'clock:pomodoro';
			const FOCUS_MS = 25 * 60_000;
			const BREAK_MS = 5 * 60_000;
			const pomoToggle = document.querySelector('.pomodoro-toggle');
			const pomoReset = document.querySelector('.pomodoro-reset');
			const pomoLine = document.getElementById('clock-pomodoro');
			const baseTitle = document.title;
			/** @type {{phase: 'focus'|'break', endAt: number, paused: boolean, pausedRemaining: number} | null} */
			let pomo = null;

			function loadPomo() {
				try {
					const raw = localStorage.getItem(POMO_KEY);
					if (!raw) return null;
					const p = JSON.parse(raw);
					if (!p || (p.phase !== 'focus' && p.phase !== 'break')) return null;
					// a timer that expired while the page was closed is simply gone
					if (!p.paused && Date.now() >= p.endAt) return null;
					return p;
				} catch {
					return null;
				}
			}
			function savePomo() {
				try {
					localStorage.setItem(POMO_KEY, pomo ? JSON.stringify(pomo) : '');
				} catch {
					/* ignore */
				}
			}

			// one short triple beep, synthesised — no audio files
			let audioCtx = null;
			// must be called from a user gesture, or the browser keeps audio suspended
			function initAudio() {
				try {
					audioCtx ??= new (window.AudioContext || window.webkitAudioContext)();
					audioCtx.resume();
				} catch {
					/* audio unavailable */
				}
			}
			function beep() {
				try {
					audioCtx ??= new (window.AudioContext || window.webkitAudioContext)();
					const t = audioCtx.currentTime;
					for (const off of [0, 0.22, 0.44]) {
						const osc = audioCtx.createOscillator();
						const gain = audioCtx.createGain();
						osc.frequency.value = 880;
						osc.connect(gain);
						gain.connect(audioCtx.destination);
						gain.gain.setValueAtTime(0.0001, t + off);
						gain.gain.exponentialRampToValueAtTime(0.2, t + off + 0.02);
						gain.gain.exponentialRampToValueAtTime(0.0001, t + off + 0.18);
						osc.start(t + off);
						osc.stop(t + off + 0.2);
					}
				} catch {
					/* audio unavailable — silent fallback */
				}
			}

			function startPhase(phase, duration) {
				pomo = { phase, endAt: Date.now() + duration, paused: false, pausedRemaining: duration };
				savePomo();
				syncPomo();
			}

			function syncPomo() {
				let remaining = null;
				if (pomo) {
					remaining = pomo.paused ? pomo.pausedRemaining : Math.max(0, pomo.endAt - Date.now());
				}
				const fmt = (ms) => {
					const s = Math.ceil(ms / 1000);
					return `${String(Math.floor(s / 60)).padStart(2, '0')}:${String(s % 60).padStart(2, '0')}`;
				};
				if (pomo && remaining !== null) {
					const label = pomo.phase === 'focus' ? 'Focus' : 'Break';
					pomoToggle.textContent = fmt(remaining);
					pomoToggle.classList.toggle('running', !pomo.paused);
					pomoToggle.classList.toggle('paused', pomo.paused);
					pomoToggle.setAttribute(
						'aria-label',
						`${pomo.paused ? 'Resume' : 'Pause'} Pomodoro ${label.toLowerCase()} (${fmt(remaining)})`,
					);
					pomoReset.hidden = false;
					pomoLine.hidden = false;
					pomoLine.textContent = `${label} ${fmt(remaining)}${pomo.paused ? ' · paused' : ''}`;
					document.title = remaining > 0 ? `${fmt(remaining)} · ${label}` : baseTitle;
				} else {
					pomoToggle.textContent = '🍅';
					pomoToggle.classList.remove('running', 'paused');
					pomoToggle.setAttribute('aria-label', 'Start Pomodoro timer (25 minutes)');
					pomoReset.hidden = true;
					pomoLine.hidden = true;
					document.title = baseTitle;
				}
			}

			function tickPomo() {
				if (!pomo || pomo.paused) return;
				if (Date.now() >= pomo.endAt) {
					beep();
					if (pomo.phase === 'focus') {
						startPhase('break', BREAK_MS);
					} else {
						pomo = null;
						savePomo();
					}
				}
				syncPomo();
			}

			pomoToggle.addEventListener('click', () => {
				initAudio();
				if (!pomo) {
					startPhase('focus', FOCUS_MS);
				} else if (pomo.paused) {
					pomo.endAt = Date.now() + pomo.pausedRemaining;
					pomo.paused = false;
					savePomo();
				} else {
					pomo.pausedRemaining = Math.max(0, pomo.endAt - Date.now());
					pomo.paused = true;
					savePomo();
				}
				syncPomo();
			});

			pomoReset.addEventListener('click', () => {
				pomo = null;
				savePomo();
				syncPomo();
			});

			pomo = loadPomo();
			syncPomo();
			// sync to the next whole second, then tick clock + pomodoro together
			const tickAll = () => {
				render();
				tickPomo();
			};
			setTimeout(() => {
				tickAll();
				setInterval(tickAll, 1000);
			}, 1000 - (Date.now() % 1000));

			// Theme: light / dark / auto (auto = follow browser)
			const toggle = document.querySelector('.theme-toggle');
			const mql = matchMedia('(prefers-color-scheme: dark)');
			const ICONS = { light: '☀', dark: '☾', auto: '◐' };
			const LABELS = {
				light: 'Light theme',
				dark: 'Dark theme',
				auto: 'Auto theme (follows browser setting)',
			};
			const ORDER = ['light', 'dark', 'auto'];

			function syncIcon() {
				const mode = root.dataset.themeMode;
				toggle.textContent = ICONS[mode];
				toggle.title = LABELS[mode];
				toggle.setAttribute('aria-label', LABELS[mode]);
			}

			function applyMode(mode) {
				root.dataset.themeMode = mode;
				root.dataset.theme = mode === 'auto' ? (mql.matches ? 'dark' : 'light') : mode;
				try {
					localStorage.setItem('clock:theme', mode);
				} catch {
					/* storage unavailable — mode just won't persist */
				}
				syncIcon();
			}

			toggle.addEventListener('click', () => {
				const current = root.dataset.themeMode;
				applyMode(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length]);
			});

			// In auto mode, react live when the browser theme changes
			mql.addEventListener('change', () => {
				if (root.dataset.themeMode === 'auto') {
					root.dataset.theme = mql.matches ? 'dark' : 'light';
				}
			});

			syncIcon();
		</script>
	</body>
</html>
