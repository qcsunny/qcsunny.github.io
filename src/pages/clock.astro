---
import BaseHead from '../components/BaseHead.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Clock" description="A minimal fullscreen local clock: weekday, date and 24-hour time." />
		<script is:inline>
			// Apply theme before first paint to avoid a flash
			// Modes: light / dark / auto (auto follows the browser theme)
			const saved = localStorage.getItem('clock:theme');
			const mode = saved === 'light' || saved === 'dark' || saved === 'auto' ? saved : 'auto';
			document.documentElement.dataset.themeMode = mode;
			document.documentElement.dataset.theme =
				mode === 'auto'
					? matchMedia('(prefers-color-scheme: dark)').matches
						? 'dark'
						: 'light'
					: mode;
			// Restore the seconds toggle (affects the time font size)
			document.documentElement.dataset.seconds =
				localStorage.getItem('clock:seconds') === 'off' ? 'off' : 'on';
		</script>
		<style>
			:root {
				--bg: #ffffff;
				--fg: #000000;
				color-scheme: light;
			}
			html[data-theme='dark'] {
				--bg: #000000;
				--fg: #ffffff;
				color-scheme: dark;
			}
			* {
				margin: 0;
				padding: 0;
			}
			body {
				background: var(--bg);
				color: var(--fg);
				height: 100dvh;
				display: flex;
				align-items: center;
				justify-content: center;
				overflow: hidden;
				font-family:
					system-ui,
					-apple-system,
					'Segoe UI',
					Roboto,
					'Helvetica Neue',
					Arial,
					sans-serif;
				-webkit-font-smoothing: antialiased;
			}
			.clock {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.2em;
				padding: 0 0.25em;
			}
			.weekday {
				font-size: clamp(1.25rem, 5vw, 3rem);
				font-weight: 600;
				letter-spacing: 0.12em;
				text-transform: uppercase;
			}
			.date {
				font-size: clamp(1rem, 4vw, 2.25rem);
				font-weight: 400;
				letter-spacing: 0.08em;
				color: var(--fg);
				opacity: 0.75;
			}
			.time {
				font-size: min(17vw, 30dvh);
				line-height: 1.1;
				font-weight: 700;
				font-variant-numeric: tabular-nums;
				letter-spacing: 0.02em;
				white-space: nowrap;
			}
			/* seconds hidden: HH:MM is 5 chars instead of 8, let it fill more width */
			html[data-seconds='off'] .time {
				font-size: min(27vw, 30dvh);
			}
			.corner-group {
				position: fixed;
				top: 1em;
				right: 1em;
				display: flex;
				gap: 0.15em;
			}
			.corner {
				font-size: 0.95rem;
				opacity: 0.45;
				text-decoration: none;
				color: var(--fg);
				background: none;
				border: none;
				font-family: inherit;
				cursor: pointer;
				padding: 0.4em 0.6em;
			}
			.corner:hover {
				opacity: 1;
			}
			/* seconds visible = button in its active state */
			.seconds-toggle[aria-pressed='true'] {
				opacity: 0.9;
			}
			.seconds-toggle[aria-pressed='true']:hover {
				opacity: 1;
			}
			.corner:focus-visible {
				outline: 2px solid currentColor;
				opacity: 1;
			}
		</style>
	</head>
	<body>
		<div class="corner-group">
			<button class="corner seconds-toggle" type="button" aria-label="Hide seconds" aria-pressed="true">
				:ss
			</button>
			<button class="corner theme-toggle" type="button" aria-label="Toggle light / dark theme">☾</button>
		</div>
		<main class="clock" aria-live="off">
			<div class="weekday" id="clock-weekday"></div>
			<div class="date" id="clock-date"></div>
			<div class="time" id="clock-time"></div>
		</main>
		<script is:inline>
			const weekdayEl = document.getElementById('clock-weekday');
			const dateEl = document.getElementById('clock-date');
			const timeEl = document.getElementById('clock-time');
			const root = document.documentElement;

			function render() {
				const now = new Date();
				weekdayEl.textContent = now.toLocaleDateString('en-US', { weekday: 'long' });
				dateEl.textContent = now.toLocaleDateString('en-US', {
					year: 'numeric',
					month: 'long',
					day: 'numeric',
				});
				const p = (n) => String(n).padStart(2, '0');
				const showSeconds = () => document.documentElement.dataset.seconds !== 'off';
				timeEl.textContent = showSeconds()
					? `${p(now.getHours())}:${p(now.getMinutes())}:${p(now.getSeconds())}`
					: `${p(now.getHours())}:${p(now.getMinutes())}`;
			}

			render();
			// sync to the next whole second, then tick every second
			setTimeout(() => {
				render();
				setInterval(render, 1000);
			}, 1000 - (Date.now() % 1000));

			// Seconds toggle: show / hide the seconds part of the time
			const secondsToggle = document.querySelector('.seconds-toggle');

			function syncSecondsButton() {
				const off = root.dataset.seconds === 'off';
				secondsToggle.setAttribute('aria-pressed', String(!off));
				secondsToggle.setAttribute('aria-label', off ? 'Show seconds' : 'Hide seconds');
			}

			secondsToggle.addEventListener('click', () => {
				root.dataset.seconds = root.dataset.seconds === 'off' ? 'on' : 'off';
				try {
					localStorage.setItem('clock:seconds', root.dataset.seconds);
				} catch {
					/* storage unavailable — choice just won't persist */
				}
				syncSecondsButton();
				render();
			});

			syncSecondsButton();

			// Theme: three-state cycle light → dark → auto (auto = follow browser)
			const toggle = document.querySelector('.theme-toggle');
			const mql = matchMedia('(prefers-color-scheme: dark)');
			const ICONS = { light: '☀', dark: '☾', auto: '◐' };
			const LABELS = {
				light: 'Light theme',
				dark: 'Dark theme',
				auto: 'Auto theme (follows browser setting)',
			};
			const ORDER = ['light', 'dark', 'auto'];

			function syncIcon() {
				const mode = root.dataset.themeMode;
				toggle.textContent = ICONS[mode];
				toggle.title = LABELS[mode];
				toggle.setAttribute('aria-label', LABELS[mode]);
			}

			function applyMode(mode) {
				root.dataset.themeMode = mode;
				root.dataset.theme = mode === 'auto' ? (mql.matches ? 'dark' : 'light') : mode;
				try {
					localStorage.setItem('clock:theme', mode);
				} catch {
					/* storage unavailable — mode just won't persist */
				}
				syncIcon();
			}

			toggle.addEventListener('click', () => {
				const current = root.dataset.themeMode;
				applyMode(ORDER[(ORDER.indexOf(current) + 1) % ORDER.length]);
			});

			// In auto mode, react live when the browser theme changes
			mql.addEventListener('change', () => {
				if (root.dataset.themeMode === 'auto') {
					root.dataset.theme = mql.matches ? 'dark' : 'light';
				}
			});

			syncIcon();
		</script>
	</body>
</html>
