---
// converters hub — a single-category view of the Tools hub. Title, Chinese
// title and blurb come from CATEGORIES so the copy lives in one place; only
// the search placeholder is bespoke to this page.
import ToolShell from '../../components/tools/ToolShell.astro';
import ToolSearchBar from '../../components/tools/ToolSearchBar.astro';
import { CATEGORIES, REGISTRY } from '../../tools/registry';

const cat = CATEGORIES.find((c) => c.id === 'converters')!;
const entries = REGISTRY.filter((e) => e.category === 'converters' && e.kind !== 'redirect');
---

<ToolShell title={cat.label} titleZh={cat.labelZh} description={cat.blurb}>
	<ToolSearchBar category="converters" placeholder="Search converters (e.g. weight, length, speed, temperature)..." placeholderZh="搜索换算器 (如 重量、长度、速度、温度、面积、数据)..." totalCount={entries.length} />
	<div class="t-cards">
		{
			entries.map((e) => (
				<a class="t-card" href={`/${e.category}/${e.slug}/`} data-slug={e.slug} data-cat={e.category}>
					<h2>
						<span class="i18n-en">{e.name}</span>
						<span class="i18n-zh">{e.nameZh || e.name}</span>
					</h2>
					<p>
						<span class="i18n-en">{e.description}</span>
						{e.descriptionZh && <span class="i18n-zh">{e.descriptionZh}</span>}
					</p>
				</a>
			))
		}
	</div>
</ToolShell>
