---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { CALCULATOR_FEATURED, REGISTRY } from '../tools/registry';

const all = [...CALCULATOR_FEATURED, ...REGISTRY];
const bySlug = (slug: string) => all.find((e) => e.slug === slug);
// hand-picked, cross-category favorites shown on the landing page
const featuredSlugs = [
	'standard',
	'qr-code-generator',
	'password-generator',
	'length',
	'compound-interest',
	'mortgage',
	'json-formatter',
	'average',
];
const featured = featuredSlugs.map(bySlug).filter((e) => e !== undefined).slice(0, 8);

const posts = (await getCollection('blog'))
	.sort((a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
	)
	.slice(0, 3);
const fmt = (d: Date) =>
	d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const siteJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: SITE_TITLE,
	url: Astro.site ? new URL('/', Astro.site).href : 'https://qcsunny.org/',
	description: SITE_DESCRIPTION,
	inLanguage: ['zh-CN', 'en'],
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script type="application/ld+json" set:html={JSON.stringify(siteJsonLd)} />
	</head>
	<body>
		<Header />
		<main>
			<h1>{SITE_TITLE}</h1>
			<p class="tagline">
				A personal blog and a growing set of <a href="/tools/">free online tools</a> — 34
				calculators, converters and generators that run entirely in your browser. No sign-up,
				no tracking of what you type.
			</p>
			<p class="tagline" lang="zh-CN">
				个人博客与免费在线工具集：科学计算器、单位换算、房贷与复利计算、二维码生成器等 34 个纯浏览器端工具——免注册，输入不上传。
			</p>

			<section class="home-tools">
				<h2>Popular tools</h2>
				<ul>
					{
						featured.map((e) => (
							<li>
								<a href={`/${e.category}/${e.slug}/`}>
									<strong>{e.name}{e.nameZh && <span class="t-sub-zh">（{e.nameZh}）</span>}</strong>
									<span>{e.description}</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="more">
					<a href="/tools/">Browse all 34 tools →</a>
				</p>
			</section>

			<section class="home-posts">
				<h2>Latest posts</h2>
				<ul>
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<time datetime={post.data.pubDate.toISOString()}>
									{fmt(post.data.pubDate)}
								</time>
							</li>
						))
					}
				</ul>
			</section>

			<section class="home-more">
				<h2>More on this site</h2>
				<ul>
					<li><a href="/calculators/standard/">Scientific calculator</a> — expressions, variables, history</li>
					<li><a href="/calculators/graph/">Function grapher</a> — plot up to 4 functions</li>
					<li><a href="/clock/">Clock</a> — full-screen minimal clock &amp; pomodoro</li>
					<li><a href="/calendar/">Calendar</a> — month and year views with ISO week numbers</li>
					<li><a href="/about/">About</a> / <a href="/privacy/">Privacy</a></li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding: 2rem 0 3rem;
	}
	h1 {
		color: var(--fg);
		font-size: 2rem;
		margin-bottom: 0.4em;
	}
	h2 {
		color: var(--fg);
		font-size: 1.25rem;
		margin: 2.2em 0 0.6em;
	}
	.tagline {
		font-size: 1.1rem;
	}
	.tagline + .tagline {
		margin-top: 0.8em;
	}
	[lang='zh-CN'] {
		line-height: 1.9;
	}
	.home-tools ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
		gap: 0.75em;
	}
	.home-tools li a {
		display: flex;
		flex-direction: column;
		gap: 0.25em;
		padding: 0.8em 1em;
		border: 1px solid var(--gridline);
		border-radius: 10px;
		text-decoration: none;
		height: 100%;
		box-sizing: border-box;
	}
	.home-tools li a:hover {
		border-color: var(--accent);
	}
	.home-tools strong {
		color: var(--fg);
		font-size: 0.98rem;
	}
	.home-tools span {
		color: var(--dim);
		font-size: 0.85rem;
		line-height: 1.5;
	}
	.more {
		margin-top: 1em;
	}
	.home-posts ul,
	.home-more ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.home-posts li {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		padding: 0.45em 0;
		border-bottom: 1px dashed var(--gridline);
	}
	.home-posts time {
		color: var(--dim);
		font-size: 0.85rem;
		white-space: nowrap;
	}
	.home-more li {
		padding: 0.3em 0;
		color: var(--dim);
	}
</style>
