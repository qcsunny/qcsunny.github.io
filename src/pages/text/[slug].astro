---
import DynamicToolPage from '../../components/tools/DynamicToolPage.astro';
import { REGISTRY, type ToolEntry } from '../../tools/registry';
import { katexCssHref } from '../../lib/katex-css';

export function getStaticPaths() {
	return REGISTRY
		.filter((e) => e.category === 'text')
		.map((e) => ({ params: { slug: e.slug }, props: { entry: e } }));
}

const { entry } = Astro.props as { entry: ToolEntry };
---

<DynamicToolPage entry={entry} category="text" />
{entry.kind === 'markdown' && <link rel="stylesheet" href={katexCssHref} data-katex />}

<script>
	import '../../scripts/tools/main';
</script>
