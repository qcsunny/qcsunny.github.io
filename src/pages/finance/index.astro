---
import ToolShell from '../../components/tools/ToolShell.astro';
import { REGISTRY } from '../../tools/registry';

const entries = [
	...REGISTRY.filter((e) => e.category === 'finance')
].filter((e) => e.kind !== 'redirect');
---
<ToolShell title="Finance" description="Compound interest, loans, mortgages, investments, ROI, discounts, salary and tax calculators.">
	<div class="t-cards">
		{
			entries.map((e) => (
				<a class="t-card" href={`/${e.category}/${e.slug}/`}>
					<h2>{e.name}</h2>
					<p>{e.description}</p>
				</a>
			))
		}
	</div>
</ToolShell>
