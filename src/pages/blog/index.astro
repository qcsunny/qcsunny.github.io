---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ReadingTime from '../../components/ReadingTime.astro';
import Header from '../../components/Header.astro';
import { readingMinutes } from '../../blog/blogMetadata';
import { BLOG_CATEGORIES, getBlogCategory } from '../../blog/blogMetadata';
import { buildBlogSearchConfig } from '../../components/tools/blogSearchConfig';
import { SITE_TITLE } from '../../consts';
import { TOOL_COUNT } from '../../tools/registry';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// The bottom CTA used to say "40+"; a hardcoded number ages into a lie as tools
// ship. TOOL_COUNT is the single registry-derived total (REAL_TOOLS minus the
// redirect stubs that only carry legacy URLs), so the copy shows this build's
// real number.
const toolTotal = TOOL_COUNT;

// Feeds the Header's search overlay: on the blog the button searches these
// articles instead of the tool registry.
const blogSearchConfig = buildBlogSearchConfig(posts);

// Filter chips carry a build-time count, and a category with zero posts does
// not get a chip at all — an empty filter result can then never happen, no
// runtime empty-state needed.
const countByCategory = new Map<string, number>();
for (const post of posts) {
	const key = getBlogCategory(post.data.category).key;
	countByCategory.set(key, (countByCategory.get(key) ?? 0) + 1);
}
const filterableCategories = BLOG_CATEGORIES.filter((c) => (countByCategory.get(c.key) ?? 0) > 0);

// Fine-grained topic chips for the second filter row: multi-select, so they
// carry build-time counts like the category chips and zero-count topics are
// left out entirely. Sorted by count so the frequent tags lead.
const countByTopic = new Map<string, number>();
for (const post of posts) {
	for (const topic of post.data.topics) {
		countByTopic.set(topic, (countByTopic.get(topic) ?? 0) + 1);
	}
}
const filterableTopics = [...countByTopic.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]));

// Year selector: every year that actually has posts, newest first.
const years = [...new Set(posts.map((post) => post.data.pubDate.getFullYear()))].sort((a, b) => b - a);

// The page reads as a magazine top and an archive tail: the newest posts get
// display space (featured 1+2, then a card grid), everything older collapses
// into per-year single-line rows. 47 identical two-column cards was a wall;
// the archive rows halve the page and make the years of writing visible.
const [hero, ...rest] = posts;
const minis = rest.slice(0, 2);
// Six recent cards fill a 3×2 grid exactly — four cards left a lonely corner
// (3+1) on the 1140px frame.
const recent = rest.slice(2, 8);
const archive = rest.slice(8);
const byYear = new Map<number, typeof posts>();
for (const post of archive) {
	const year = post.data.pubDate.getFullYear();
	const bucket = byYear.get(year) ?? [];
	bucket.push(post);
	byYear.set(year, bucket);
}
const yearGroups = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

// Short in-row date: the list row has no room for FormattedDate's long form,
// and it must be a bilingual pair (en "Mar 12" / zh "3月12日") like every
// other script-free text on the page.
const shortDate = (d: Date) => ({
	en: d.toLocaleDateString('en-us', { month: 'short', day: 'numeric' }),
	zh: `${d.getMonth() + 1}月${d.getDate()}日`,
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`技术博客 (Blog) — ${SITE_TITLE}`}
			description="深入工程实战与算法手记：零依赖纯前端架构、二维码手写编码、UUID 数据库索引性能优化与金融复利数学。"
		/>
	</head>
	<body>
		<Header searchConfig={blogSearchConfig} />
		<main class="blog-container">
			<!-- Header Intro -->
			<div class="blog-header">
				<div class="blog-badge">
					<span class="badge-dot"></span>
					<span class="i18n-zh">手写代码 · 实测数据 · 一次讲透原理</span>
					<span class="i18n-en">Hand-rolled Code · Measured Numbers</span>
				</div>
				<h1 class="blog-title">
					<span class="i18n-zh">技术博客与工程手记</span>
					<span class="i18n-en">Writing About the Craft</span>
				</h1>
				<p class="blog-subtitle i18n-zh">{posts.length} 篇手写引擎、实测数据驱动的工程手记。</p>
				<p class="blog-subtitle i18n-en">{posts.length} notes on hand-rolled engines and measured numbers.</p>
			</div>

			<form class="blog-category-filter" data-blog-category-filter action="/blog/" method="get">
				<div class="filter-row">
					<span class="filter-label">
						<span class="i18n-zh">按主题筛选</span>
						<span class="i18n-en">Filter by topic</span>
					</span>
					<button type="submit" name="category" value="" data-blog-category="all" aria-pressed="true" aria-current="true">
						<span class="i18n-zh">全部</span><span class="i18n-en">All</span>
						<span class="count-badge">{posts.length}</span>
					</button>
					{filterableCategories.map((category) => (
						<button type="submit" name="category" value={category.key} data-blog-category={category.key} aria-pressed="false" aria-current="false">
							<span class="i18n-zh">{category.labelZh}</span><span class="i18n-en">{category.labelEn}</span>
							<span class="count-badge">{countByCategory.get(category.key)}</span>
						</button>
					))}
				</div>
				<div class="filter-row filter-row-tags">
					<label class="filter-label" for="blog-filter-keyword">
						<span class="i18n-zh">关键词 / 标签 / 年份</span>
						<span class="i18n-en">Keyword / tags / year</span>
					</label>
					<input
						id="blog-filter-keyword"
						class="filter-keyword"
						type="search"
						placeholder="title / description…"
						data-blog-keyword
						autocomplete="off"
					/>
					{filterableTopics.map(([topic, count]) => (
						<button type="button" data-blog-topic={topic} aria-pressed="false">
							{topic}
							<span class="count-badge">{count}</span>
						</button>
					))}
					<label class="filter-year-label" for="blog-filter-year">
						<span class="i18n-zh">年份</span>
						<span class="i18n-en">Year</span>
					</label>
					<select id="blog-filter-year" class="filter-year" data-blog-year>
						{/* An <option> holds text, not elements — the script below rewrites
						    this label on load and on every language switch (only === 'zh'
						    counts as Chinese; see the i18n notes in CLAUDE.md). */}
						<option value="all" selected>All</option>
						{years.map((year) => (
							<option value={year}>{year}</option>
						))}
					</select>
					<button type="button" class="filter-reset" data-blog-reset hidden>
						<span class="i18n-zh">✕ 清除筛选</span>
						<span class="i18n-en">✕ Clear filters</span>
					</button>
				</div>
				<!-- Result count: pre-rendered bilingual, the script fills only the numbers. -->
				<p class="filter-result" data-filter-result hidden>
					<span class="i18n-zh">显示 <span data-count>0</span> / {posts.length} 篇</span>
					<span class="i18n-en">Showing <span data-count>0</span> of {posts.length}</span>
				</p>
			</form>

			<!-- Featured: newest post large + the next two compact -->
			{
				hero && (
					<section class="featured-section" data-blog-card-container>
						<div class="featured-grid">
							<a class="featured-card" href={`/blog/${hero.id}/`} data-blog-card data-cat={getBlogCategory(hero.data.category).key} data-topics={hero.data.topics.join(' ')} data-title={hero.data.title} data-desc={hero.data.description} data-year={hero.data.pubDate.getFullYear()}>
								<div class="featured-badge-row">
									<span class="featured-tag">
										<span class="i18n-zh">最新发布</span><span class="i18n-en">Latest</span>
									</span>
									<span class="cat-pill" style={`--cat-color: ${getBlogCategory(hero.data.category).color};`}>
										<span class="i18n-zh">{getBlogCategory(hero.data.category).labelZh}</span>
										<span class="i18n-en">{getBlogCategory(hero.data.category).labelEn}</span>
									</span>
									<span class="read-time-pill">
										<ReadingTime minutes={readingMinutes(hero.body ?? '')} />
									</span>
								</div>

								<h2 class="featured-title" lang={hero.data.contentLang}>{hero.data.title}</h2>
								<p class="featured-desc" lang={hero.data.contentLang}>{hero.data.description}</p>

								<div class="featured-foot">
									<div class="featured-meta">
										<FormattedDate date={hero.data.pubDate} />
										<span class="meta-dot">·</span>
										<span>QCSunny</span>
									</div>
									<span class="featured-cta">
										<span class="i18n-zh">阅读完整长文</span>
										<span class="i18n-en">Read Full Article</span>
										<span class="cta-arrow" aria-hidden="true">→</span>
									</span>
								</div>
							</a>
							<div class="featured-side">
								{minis.map((post) => {
									const cat = getBlogCategory(post.data.category);
									return (
										<a class="featured-mini" href={`/blog/${post.id}/`} data-blog-card data-cat={cat.key} data-topics={post.data.topics.join(' ')} data-title={post.data.title} data-desc={post.data.description} data-year={post.data.pubDate.getFullYear()} style={`--cat-color: ${cat.color};`}>
											<div class="mini-top">
												<span class="cat-pill" style={`--cat-color: ${cat.color};`}>
													<span class="i18n-zh">{cat.labelZh}</span>
													<span class="i18n-en">{cat.labelEn}</span>
												</span>
												<ReadingTime minutes={readingMinutes(post.body ?? '')} />
											</div>
											<h3 class="mini-title" lang={post.data.contentLang}>{post.data.title}</h3>
											<div class="mini-meta">
												<FormattedDate date={post.data.pubDate} />
												<span class="cta-arrow" aria-hidden="true">→</span>
											</div>
										</a>
									);
								})}
							</div>
						</div>
					</section>
				)
			}

			<!-- Recent Articles Grid -->
			{
				recent.length > 0 && (
					<section class="articles-section" data-blog-card-container>
						<div class="articles-header">
							<h2 class="articles-title">
								<span class="i18n-zh">近期文章</span>
								<span class="i18n-en">Recent Articles</span>
							</h2>
						</div>

						<div class="articles-grid">
							{recent.map((post) => {
								const cat = getBlogCategory(post.data.category);
								return (
									<article class="article-card" data-blog-card data-cat={cat.key} data-topics={post.data.topics.join(' ')} data-title={post.data.title} data-desc={post.data.description} data-year={post.data.pubDate.getFullYear()} style={`--cat-color: ${cat.color};`}>
										<a href={`/blog/${post.id}/`} class="article-card-link">
											<div class="article-meta-row">
												<span class="cat-pill" style={`--cat-color: ${cat.color};`}>
													<span class="i18n-zh">{cat.labelZh}</span>
													<span class="i18n-en">{cat.labelEn}</span>
												</span>
												<span class="article-date">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<span class="meta-dot">·</span>
												<ReadingTime minutes={readingMinutes(post.body ?? '')} />
											</div>

											<h3 class="article-title" lang={post.data.contentLang}>{post.data.title}</h3>
											<p class="article-desc" lang={post.data.contentLang}>{post.data.description}</p>

											<div class="article-foot">
												<span class="read-more">
													<span class="i18n-zh">阅读全文</span>
													<span class="i18n-en">Read Article</span>
													<span class="read-arrow" aria-hidden="true">→</span>
												</span>
											</div>
										</a>
									</article>
								);
							})}
						</div>
					</section>
				)
			}

			<!-- Archive: one row per older post, grouped by year -->
			{
				yearGroups.map(([year, group]) => (
					<section class="archive-year" data-blog-card-container>
						<h3 class="year-label">{year}</h3>
						<ul class="archive-list">
							{group.map((post) => {
								const cat = getBlogCategory(post.data.category);
								const d = shortDate(post.data.pubDate);
								return (
									<li>
										<a class="archive-row" href={`/blog/${post.id}/`} data-blog-card data-cat={cat.key} data-topics={post.data.topics.join(' ')} data-title={post.data.title} data-desc={post.data.description} data-year={post.data.pubDate.getFullYear()} style={`--cat-color: ${cat.color};`}>
											<span class="row-date">
												<span class="i18n-en">{d.en}</span>
												<span class="i18n-zh">{d.zh}</span>
											</span>
											<span class="row-dot" aria-hidden="true"></span>
											<span class="row-title" lang={post.data.contentLang}>{post.data.title}</span>
											<span class="row-time">
												<ReadingTime minutes={readingMinutes(post.body ?? '')} />
											</span>
										</a>
									</li>
								);
							})}
						</ul>
					</section>
				))
			}

			<!-- Empty state: only reachable with an active keyword/topic/year filter
			     (a bare category filter always has its build-time count behind it). -->
			<div class="filter-empty" data-filter-empty hidden>
				<span class="i18n-zh">没有匹配的文章 —— 试试清空关键词、减少标签或换个年份。</span>
				<span class="i18n-en">No matching posts — try clearing the keyword, fewer topics, or another year.</span>
			</div>

			<!-- Bottom Tools Promotion Box -->
			<section class="tools-cta-box">
				<div class="tools-cta-content">
					<h3>
						<span class="i18n-zh">探索配套开发者工具库</span>
						<span class="i18n-en">Explore Matching Developer Tools</span>
					</h3>
					<p>
						<span class="i18n-zh">JSON / SQL 格式化、JWT 解码、复利与房贷测算…… {toolTotal} 款纯浏览器工具全部免费、数据不出页面。</span>
						<span class="i18n-en">JSON/SQL formatting, JWT decoding, mortgage and compound-interest math — {toolTotal} free tools that run entirely in your browser, nothing uploaded.</span>
					</p>
				</div>
				<a href="/tools/" class="tools-cta-btn">
					<span class="i18n-zh">前往工具库 →</span>
					<span class="i18n-en">Browse Tools →</span>
				</a>
			</section>
		</main>
		<Footer />
		<script is:inline>
			(() => {
				const filter = document.querySelector('[data-blog-category-filter]');
				if (!filter) return;
				const catButtons = Array.from(filter.querySelectorAll('[data-blog-category]'));
				const topicButtons = Array.from(filter.querySelectorAll('[data-blog-topic]'));
				const kwInput = filter.querySelector('[data-blog-keyword]');
				const yearSelect = filter.querySelector('[data-blog-year]');
				const resetBtn = filter.querySelector('[data-blog-reset]');
				const resultEl = document.querySelector('[data-filter-result]');
				const countEls = resultEl ? resultEl.querySelectorAll('[data-count]') : [];
				const emptyEl = document.querySelector('[data-filter-empty]');
				const cards = Array.from(document.querySelectorAll('[data-blog-card]'));
				const containers = Array.from(document.querySelectorAll('[data-blog-card-container]'));
				const validCategories = new Set(catButtons.map((button) => button.dataset.blogCategory));

				let selectedCat = 'all';
				const selectedTopics = new Set();
				let keyword = '';
				let selectedYear = 'all';

				const apply = (updateUrl = false) => {
					catButtons.forEach((button) => {
						const active = button.dataset.blogCategory === selectedCat;
						button.setAttribute('aria-pressed', String(active));
						button.setAttribute('aria-current', String(active));
					});
					topicButtons.forEach((button) => {
						button.setAttribute('aria-pressed', String(selectedTopics.has(button.dataset.blogTopic)));
					});
					const kw = keyword.trim().toLowerCase();
					let visibleCount = 0;
					cards.forEach((card) => {
						const catOk = selectedCat === 'all' || card.dataset.cat === selectedCat;
						// Topics are fine-grained: several selected topics widen the
						// match (a post needs ANY of them), while every other
						// dimension intersects.
						const topics = (card.dataset.topics || '').split(' ').filter(Boolean);
						const topicOk = selectedTopics.size === 0 || [...selectedTopics].some((t) => topics.includes(t));
						const yearOk = selectedYear === 'all' || card.dataset.year === selectedYear;
						const hay = `${card.dataset.title ?? ''} ${card.dataset.desc ?? ''}`.toLowerCase();
						const kwOk = !kw || hay.includes(kw);
						const show = catOk && topicOk && yearOk && kwOk;
						card.hidden = !show;
						if (show) visibleCount++;
					});
					containers.forEach((container) => {
						if (container.dataset.cat) {
							container.hidden = selectedCat !== 'all' && container.dataset.cat !== selectedCat;
						} else {
							// Mixed-content containers (featured grid, recent grid, a
							// year group) have no single category: they show while
							// they still hold at least one visible card.
							container.hidden =
								container.querySelectorAll('[data-blog-card]:not([hidden])').length === 0;
						}
					});
					const filtering = selectedCat !== 'all' || selectedTopics.size > 0 || selectedYear !== 'all' || kw.length > 0;
					if (resultEl) {
						resultEl.hidden = !filtering;
						countEls.forEach((el) => (el.textContent = String(visibleCount)));
					}
					if (emptyEl) emptyEl.hidden = !(filtering && visibleCount === 0);
					if (resetBtn) resetBtn.hidden = !filtering;
					if (updateUrl) {
						const params = new URLSearchParams();
						if (selectedCat !== 'all') params.set('category', selectedCat);
						if (selectedTopics.size > 0) params.set('topic', [...selectedTopics].sort().join(','));
						if (selectedYear !== 'all') params.set('year', selectedYear);
						if (kw) params.set('q', keyword.trim());
						const qs = params.toString();
						window.history.pushState({}, '', '/blog/' + (qs ? `?${qs}` : ''));
					}
				};

				const readUrl = () => {
					const params = new URLSearchParams(window.location.search);
					selectedCat = params.get('category') || 'all';
					if (!validCategories.has(selectedCat)) selectedCat = 'all';
					selectedTopics.clear();
					for (const t of (params.get('topic') || '').split(',').filter(Boolean)) selectedTopics.add(t);
					selectedYear = params.get('year') || 'all';
					keyword = params.get('q') || '';
					if (kwInput) kwInput.value = keyword;
					if (yearSelect) yearSelect.value = yearsHas(selectedYear) ? selectedYear : 'all';
					selectedYear = yearSelect?.value ?? 'all';
				};
				const yearsHas = (y) => !!(yearSelect && [...yearSelect.options].some((o) => o.value === y));

				filter.addEventListener('submit', (event) => {
					event.preventDefault();
					const submitter = event.submitter;
					selectedCat = submitter?.dataset.blogCategory || 'all';
					apply(true);
				});
				topicButtons.forEach((button) => {
					button.addEventListener('click', () => {
						const topic = button.dataset.blogTopic;
						if (selectedTopics.has(topic)) selectedTopics.delete(topic);
						else selectedTopics.add(topic);
						apply(true);
					});
				});
				if (kwInput) {
					let debounce = null;
					kwInput.addEventListener('input', () => {
						if (debounce) clearTimeout(debounce);
						debounce = setTimeout(() => {
							keyword = kwInput.value;
							apply(true);
						}, 120);
					});
				}
				if (yearSelect) {
					yearSelect.addEventListener('change', () => {
						selectedYear = yearSelect.value;
						apply(true);
					});
				}
				if (resetBtn) {
					resetBtn.addEventListener('click', () => {
						selectedCat = 'all';
						selectedTopics.clear();
						selectedYear = 'all';
						keyword = '';
						if (kwInput) kwInput.value = '';
						if (yearSelect) yearSelect.value = 'all';
						apply(true);
					});
				}
				window.addEventListener('popstate', () => {
					readUrl();
					apply(false);
				});

				// The year select's "All" label: an <option> cannot hold an
				// .i18n-en/.i18n-zh span pair, so it is rewritten here on load and
				// on every language change (only === 'zh' counts as Chinese).
				const yearAllOption = yearSelect?.querySelector('option[value="all"]');
				const applyLang = () => {
					if (yearAllOption) yearAllOption.textContent = document.documentElement.dataset.lang === 'zh' ? '全部' : 'All';
				};
				applyLang();
				new MutationObserver(applyLang).observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
				window.addEventListener('site:lang-change', applyLang);

				readUrl();
				apply(false);
			})();
		</script>
	</body>
</html>

<style>
	/* The cards below set explicit display (flex/grid), which beats the UA's
	   [hidden] { display: none } — the category filter hides cards via the
	   hidden attribute, so it has to win here. */
	[hidden] {
		display: none !important;
	}

	.blog-container {
		/* --w-shell, the site-wide frame the nav, the home page and the post
		   shell all take — the list used to ride --w-outer (832), so the frame
		   jumped inward on the way from the nav to the list and back out into
		   an article. A post's reading column stays --w-prose inside its own
		   grid; this is only the list's outer frame. */
		width: min(var(--w-shell), 100% - 2.5em);
		margin: 0 auto;
		padding: 3rem 0 5rem;
	}

	/* --- HEADER --- */
	.blog-header {
		margin-bottom: 2.8rem;
		text-align: left;
	}

	.blog-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.3em 0.85em;
		background: var(--accent-soft);
		border: 1px solid var(--gridline);
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 1.2rem;
	}

	.badge-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}

	.blog-title {
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--fg);
		margin-bottom: 0.8rem;
	}

	.blog-subtitle {
		font-size: 1.1rem;
