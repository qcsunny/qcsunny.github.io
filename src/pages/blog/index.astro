---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [featured, ...rest] = posts;

// rough reading-time estimate: ~220 latin words or ~400 CJK chars per minute
const readMinutes = (body: string): number => {
	const words = body.match(/[\p{L}\p{N}][\p{L}\p{N}'’-]*/gu)?.length ?? 0;
	const cjk = body.match(/[\p{Script=Han}]/gu)?.length ?? 0;
	const minutes = (words - cjk) / 220 + cjk / 400;
	return Math.max(1, Math.round(minutes));
};

function getCategory(slug: string): { key: string; labelZh: string; labelEn: string; color: string } {
	if (
		slug.includes('compound') ||
		slug.includes('mortgage') ||
		slug.includes('tax') ||
		slug.includes('bonus') ||
		slug.includes('irr') ||
		slug.includes('installment') ||
		slug.includes('fire') ||
		slug.includes('finance')
	) {
		return { key: 'finance', labelZh: '金融与数学', labelEn: 'Finance & Math', color: '#10b981' };
	}
	if (slug.includes('uuid') || slug.includes('database')) {
		return { key: 'architecture', labelZh: '架构与数据库', labelEn: 'Architecture', color: '#6366f1' };
	}
	if (slug.includes('glm') || slug.includes('ai')) {
		return { key: 'ai', labelZh: 'AI 与大模型', labelEn: 'AI & LLM', color: '#ec4899' };
	}
	return { key: 'web', labelZh: '前端与工具研发', labelEn: 'Web Craft', color: '#f59e0b' };
}

// The four category keys, in pill order. Used both to render the filter row
// and (via getCategory().key) as the data-cat on every card, so the client-side
// filter matches by stable key rather than localized label. The pill labels are
// shorter than getCategory()'s full labels (Finance vs Finance & Math) — they
// sit in a tight pill row.
const CATEGORIES = ['finance', 'architecture', 'ai', 'web'] as const;
const CAT_LABELS: Record<string, { en: string; zh: string }> = {
	finance: { en: 'Finance', zh: '金融' },
	architecture: { en: 'Architecture', zh: '架构' },
	ai: { en: 'AI', zh: 'AI' },
	web: { en: 'Web', zh: '前端' },
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`技术博客 (Blog) — ${SITE_TITLE}`}
			description="深入工程实战与算法手记：零依赖纯前端架构、二维码手写编码、UUID 数据库索引性能优化与金融复利数学。"
		/>
	</head>
	<body>
		<Header />
		<main class="blog-container">
			<!-- Header Intro -->
			<div class="blog-header">
				<div class="blog-badge">
					<span class="badge-dot"></span>
					<span class="i18n-zh">深度工程实战 · 算法原理解析 · 知识沉淀</span>
					<span class="i18n-en">Technical Engineering & Math Insights</span>
				</div>
				<h1 class="blog-title">
					<span class="i18n-zh">技术博客与工程手记</span>
					<span class="i18n-en">Writing About the Craft</span>
				</h1>
				<p class="blog-subtitle i18n-zh">
					记录从零手写算法、纯浏览器端零依赖架构、UUID 数据库索引性能对比、金融复利数学与高并发前端的最佳实践。
				</p>
				<p class="blog-subtitle i18n-en">
					In-depth notes on hand-rolled algorithms, zero-dependency client-side architecture, database index benchmarks, and mathematical utilities.
				</p>
			</div>

			<!-- Featured Hero Article -->
			{
				featured && (
					<section class="featured-section">
						<a class="featured-card" href={`/blog/${featured.id}/`} data-cat={getCategory(featured.id).key} data-search={`${featured.data.title} ${featured.data.description} ${getCategory(featured.id).labelEn} ${getCategory(featured.id).labelZh} ${featured.id}`}>
							<div class="featured-badge-row">
								<span class="featured-tag">
									⭐ <span class="i18n-zh">最新精选</span><span class="i18n-en">Featured</span>
								</span>
								<span class="cat-pill" style={`--cat-color: ${getCategory(featured.id).color};`}>
									<span class="i18n-zh">{getCategory(featured.id).labelZh}</span>
									<span class="i18n-en">{getCategory(featured.id).labelEn}</span>
								</span>
								<span class="read-time-pill">
									{readMinutes(featured.body ?? '')} min read
								</span>
							</div>

							<h2 class="featured-title">{featured.data.title}</h2>
							<p class="featured-desc">{featured.data.description}</p>

							<div class="featured-foot">
								<div class="featured-meta">
									<FormattedDate date={featured.data.pubDate} />
									<span class="meta-dot">·</span>
									<span>QCSunny</span>
								</div>
								<span class="featured-cta">
									<span class="i18n-zh">阅读完整长文</span>
									<span class="i18n-en">Read Full Article</span>
									<span class="cta-arrow" aria-hidden="true">→</span>
								</span>
							</div>
						</a>
					</section>
				)
			}

			<!-- Articles Grid -->
			<section class="articles-section">
				<div class="articles-header">
					<h2 class="articles-title">
						<span class="i18n-zh">全部文章</span>
						<span class="i18n-en">All Articles</span>
						<span class="posts-count">({posts.length})</span>
					</h2>
				</div>

				<!-- Article search + category filter. is:inline so the prose-
				     pages-ship-no-JS guard (which only blocks module scripts
				     carrying a /_astro/ src) still holds — same pattern as
				     ToolSearchModal's inlined toolsData. -->
				<div class="blog-search" id="blog-search">
					<div class="blog-search-row">
						<span class="blog-search-icon" aria-hidden="true">🔍</span>
						<input
							type="text"
							id="blog-search-input"
							class="blog-search-input"
							placeholder="Search articles (title, topic)..."
							data-placeholder-en="Search articles (title, topic)..."
							data-placeholder-zh="搜索文章（标题、主题）..."
							aria-label="Search articles"
							data-aria-en="Search articles"
							data-aria-zh="搜索文章"
							autocomplete="off"
							spellcheck="false"
						/>
						<button
							type="button"
							id="blog-search-clear"
							class="blog-search-clear"
							aria-label="Clear"
							data-aria-en="Clear"
							data-aria-zh="清空"
							style="display: none;"
							>×</button
						>
						<span class="blog-search-count" id="blog-search-count"></span>
					</div>
					<div class="blog-filter-row">
						<button type="button" class="blog-filter-pill blog-filter-active" data-cat="all">
							<span class="i18n-en">All</span>
							<span class="i18n-zh">全部</span>
						</button>
						{CATEGORIES.map((key) => (
							<button type="button" class="blog-filter-pill" data-cat={key}>
								<span class="i18n-en">{CAT_LABELS[key].en}</span>
								<span class="i18n-zh">{CAT_LABELS[key].zh}</span>
							</button>
						))}
					</div>
				</div>

				<!-- Empty-state text is rebuilt via textContent (not innerHTML):
				     it echoes the reader's query, so like the calculator error
				     rows it must not parse as HTML. -->
				<p class="blog-search-empty" id="blog-search-empty" style="display: none;"></p>

				<div class="articles-grid">
					{
						rest.map((post) => {
							const cat = getCategory(post.id);
							return (
								<article class="article-card" data-cat={cat.key} data-search={`${post.data.title} ${post.data.description} ${cat.labelEn} ${cat.labelZh} ${post.id}`}>
									<a href={`/blog/${post.id}/`} class="article-card-link">
										<div class="article-meta-row">
											<span class="cat-pill" style={`--cat-color: ${cat.color};`}>
												<span class="i18n-zh">{cat.labelZh}</span>
												<span class="i18n-en">{cat.labelEn}</span>
											</span>
											<span class="article-date">
												<FormattedDate date={post.data.pubDate} />
											</span>
											<span class="meta-dot">·</span>
											<span class="article-read">{readMinutes(post.body ?? '')}m</span>
										</div>

										<h3 class="article-title">{post.data.title}</h3>
										<p class="article-desc">{post.data.description}</p>

										<div class="article-foot">
											<span class="read-more">
												<span class="i18n-zh">阅读全文</span>
												<span class="i18n-en">Read Article</span>
												<span class="read-arrow" aria-hidden="true">→</span>
											</span>
										</div>
									</a>
								</article>
							);
						})
					}
				</div>
			</section>

			<!-- Bottom Tools Promotion Box -->
			<section class="tools-cta-box">
				<div class="tools-cta-content">
					<h3>
						<span class="i18n-zh">探索配套开发者工具库</span>
						<span class="i18n-en">Explore Matching Developer Tools</span>
					</h3>
					<p>
						<span class="i18n-zh">本站提供 JSON 格式化、SQL 美化、JWT 本地解码、URL 解析与科学计算器等 40+ 款免费纯前端工具，零隐私上传、极速秒开。</span>
						<span class="i18n-en">Zero data upload, instant execution in your browser. 40+ free calculators, formatters, and generators.</span>
					</p>
				</div>
				<a href="/tools/" class="tools-cta-btn">
					<span class="i18n-zh">前往工具库 →</span>
					<span class="i18n-en">Browse Tools →</span>
				</a>
			</section>
		</main>
		<script is:inline>
			(function () {
				var root = document.getElementById('blog-search');
				if (!root) return;
				var input = document.getElementById('blog-search-input');
				var clearBtn = document.getElementById('blog-search-clear');
				var count = document.getElementById('blog-search-count');
				var empty = document.getElementById('blog-search-empty');
				var pills = Array.prototype.slice.call(root.querySelectorAll('.blog-filter-pill'));
				var cards = Array.prototype.slice.call(document.querySelectorAll('.featured-card, .article-card'));
				var featuredSection = document.querySelector('.featured-section');
				var activeCat = 'all';
				var query = '';

				function isZh() {
					return document.documentElement.dataset.lang === 'zh';
				}

				// textContent (not innerHTML) — the empty-state message echoes
				// the reader's query, same XSS-safe rule as CalcError rows.
				function setEmpty(none) {
					if (!none) {
						empty.style.display = 'none';
						empty.textContent = '';
						return;
					}
					var q = query.trim();
					var zh = isZh();
					empty.textContent = q
						? (zh ? '未找到与"' + q + '"相关的文章' : 'No articles matching "' + q + '"')
						: (zh ? '该分类暂无文章' : 'No articles in this category');
					empty.style.display = '';
				}

				function applyFilter() {
					var q = query.trim().toLowerCase();
					var visible = 0;
					cards.forEach(function (card) {
						var catOk = activeCat === 'all' || card.getAttribute('data-cat') === activeCat;
						var text = (card.getAttribute('data-search') || '').toLowerCase();
						var qOk = !q || text.indexOf(q) !== -1;
						var show = catOk && qOk;
						card.style.display = show ? '' : 'none';
						if (show) visible++;
					});
					// Hide the featured hero when it falls out of the filter so
					// an empty featured-section doesn't leave a padded shell.
					if (featuredSection) {
						var fc = featuredSection.querySelector('.featured-card');
						featuredSection.style.display = (fc && fc.style.display !== 'none') ? '' : 'none';
					}
					setEmpty(visible === 0);
					clearBtn.style.display = query ? '' : 'none';
					if (count) {
						var filtering = q || activeCat !== 'all';
						count.textContent = filtering
							? (isZh() ? visible + ' 篇' : visible + (visible === 1 ? ' result' : ' results'))
							: '';
					}
				}

				input.addEventListener('input', function () {
					query = input.value;
					applyFilter();
				});
				clearBtn.addEventListener('click', function () {
					input.value = '';
					query = '';
					applyFilter();
					input.focus();
				});
				pills.forEach(function (pill) {
					pill.addEventListener('click', function () {
						pills.forEach(function (p) { p.classList.remove('blog-filter-active'); });
						pill.classList.add('blog-filter-active');
						activeCat = pill.getAttribute('data-cat');
						applyFilter();
					});
				});
				input.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') {
						input.value = '';
						query = '';
						applyFilter();
						input.blur();
					}
				});

				function syncLang() {
					var zh = isZh();
					input.placeholder = zh ? input.getAttribute('data-placeholder-zh') : input.getAttribute('data-placeholder-en');
					input.setAttribute('aria-label', zh ? input.getAttribute('data-aria-zh') : input.getAttribute('data-aria-en'));
					clearBtn.setAttribute('aria-label', zh ? clearBtn.getAttribute('data-aria-zh') : clearBtn.getAttribute('data-aria-en'));
					applyFilter();
				}
				syncLang();

				// Catch every writer of data-lang: the head blocking script
				// (first paint), another tab's sync (MutationObserver), and the
				// site:lang-change event from wireLangToggle on standalone pages.
				var observer = new MutationObserver(function (mutations) {
					for (var i = 0; i < mutations.length; i++) {
						if (mutations[i].attributeName === 'data-lang') { syncLang(); break; }
					}
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-lang'] });
				document.addEventListener('site:lang-change', syncLang);
			})();
		</script>
		<Footer />
	</body>
</html>

<style>
	.blog-container {
		/* --w-shell, the site-wide frame the nav, the home page and the post
		   shell all take — the list used to ride --w-outer (832), so the frame
		   jumped inward on the way from the nav to the list and back out into
		   an article. A post's reading column stays --w-prose inside its own
		   grid; this is only the list's outer frame. */
		width: min(var(--w-shell), 100% - 2.5em);
		margin: 0 auto;
		padding: 3rem 0 5rem;
	}

	/* --- HEADER --- */
	.blog-header {
		margin-bottom: 2.8rem;
		text-align: left;
	}

	.blog-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.3em 0.85em;
		background: var(--accent-soft);
		border: 1px solid var(--gridline);
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 1.2rem;
	}

	.badge-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}

	.blog-title {
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--fg);
		margin-bottom: 0.8rem;
	}

	.blog-subtitle {
		font-size: 1.1rem;
		color: var(--dim);
		line-height: 1.7;
		max-width: 44em;
		margin: 0;
	}

	/* --- FEATURED SECTION --- */
	.featured-section {
		margin-bottom: 3.5rem;
	}

	.featured-card {
		display: block;
		padding: 2.2rem 2.4rem;
		background: var(--card);
		border: 1px solid var(--gridline);
		border-radius: 16px;
		text-decoration: none;
		box-shadow: var(--box-shadow);
		position: relative;
		overflow: hidden;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.featured-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--accent) 0%, #a855f7 50%, #ec4899 100%);
	}

	.featured-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		text-decoration: none;
	}

	.featured-badge-row {
		display: flex;
		align-items: center;
		gap: 0.8em;
		margin-bottom: 1rem;
		flex-wrap: wrap;
	}

	.featured-tag {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.2em 0.6em;
		border-radius: 6px;
	}

	.cat-pill {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--cat-color);
		background: color-mix(in srgb, var(--cat-color) 12%, transparent);
		padding: 0.2em 0.6em;
		border-radius: 6px;
	}

	.read-time-pill {
		font-size: 0.78rem;
		color: var(--dim);
		font-family: var(--font-mono);
	}

	.featured-title {
		font-size: clamp(1.45rem, 3.2vw, 1.95rem);
		font-weight: 800;
		color: var(--fg);
		line-height: 1.35;
		letter-spacing: -0.02em;
		margin-bottom: 0.7rem;
		transition: color 0.15s ease;
	}

	.featured-card:hover .featured-title {
		color: var(--accent);
	}

	.featured-desc {
		font-size: 1rem;
		color: var(--dim);
		line-height: 1.65;
		margin-bottom: 1.8rem;
		max-width: 48em;
	}

	.featured-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid var(--gridline);
		padding-top: 1.1rem;
		flex-wrap: wrap;
		gap: 0.8em;
	}

	.featured-meta {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.86rem;
		color: var(--dim);
		font-family: var(--font-mono);
	}

	.meta-dot {
		opacity: 0.5;
	}

	.featured-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--accent);
	}

	.cta-arrow {
		transition: transform 0.15s ease;
	}

	.featured-card:hover .cta-arrow {
		transform: translateX(5px);
	}

	/* --- ARTICLES SECTION --- */
	.articles-section {
		margin-top: 2rem;
	}

	.articles-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.5rem;
		border-bottom: 1px solid var(--gridline);
		padding-bottom: 0.8rem;
	}

	.articles-title {
		font-size: 1.35rem;
		font-weight: 700;
		color: var(--fg);
		margin: 0;
	}

	.posts-count {
		font-size: 0.95rem;
		font-weight: 400;
		color: var(--dim);
		margin-left: 0.4em;
	}

	/* --- BLOG SEARCH --- */
	.blog-search {
		margin-bottom: 1.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.blog-search-row {
		position: relative;
		display: flex;
		align-items: center;
		gap: 0.6em;
		padding: 0.55em 0.9em;
		background: var(--card);
		border: 1px solid var(--gridline);
		border-radius: 10px;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}

	.blog-search-row:focus-within {
		border-color: var(--accent);
		box-shadow: 0 0 0 3px var(--accent-soft);
	}

	.blog-search-icon {
		font-size: 0.95rem;
		opacity: 0.6;
		flex-shrink: 0;
	}

	.blog-search-input {
		flex: 1;
		border: none;
		background: transparent;
		outline: none;
		font-size: 0.95rem;
		color: var(--fg);
		font-family: inherit;
		min-width: 0;
	}

	.blog-search-input::placeholder {
		color: var(--dim);
	}

	.blog-search-clear {
		flex-shrink: 0;
		border: none;
		background: var(--gridline);
		color: var(--dim);
		width: 1.6em;
		height: 1.6em;
		border-radius: 50%;
		font-size: 0.85rem;
		line-height: 1;
		cursor: pointer;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 0;
		transition: background 0.15s ease, color 0.15s ease;
	}

	.blog-search-clear:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.blog-search-count {
		flex-shrink: 0;
		font-size: 0.78rem;
		color: var(--dim);
		font-family: var(--font-mono);
		white-space: nowrap;
	}

	.blog-filter-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
	}

	.blog-filter-pill {
		border: 1px solid var(--gridline);
		background: var(--card);
		color: var(--dim);
		font-size: 0.8rem;
		font-weight: 600;
		padding: 0.35em 0.85em;
		border-radius: 999px;
		cursor: pointer;
		font-family: inherit;
		transition: border-color 0.15s ease, color 0.15s ease, background 0.15s ease;
	}

	.blog-filter-pill:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.blog-filter-pill.blog-filter-active {
