---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ReadingTime from '../../components/ReadingTime.astro';
import Header from '../../components/Header.astro';
import { readingMinutes } from '../../blog/blogMetadata';
import { BLOG_CATEGORIES, getBlogCategory } from '../../blog/blogMetadata';
import { buildBlogSearchConfig } from '../../components/tools/blogSearchConfig';
import { SITE_TITLE } from '../../consts';
import { TOOL_COUNT } from '../../tools/registry';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// The bottom CTA used to say "40+"; a hardcoded number ages into a lie as tools
// ship. TOOL_COUNT is the single registry-derived total (REAL_TOOLS minus the
// redirect stubs that only carry legacy URLs), so the copy shows this build's
// real number.
const toolTotal = TOOL_COUNT;

// Feeds the Header's search overlay: on the blog the button searches these
// articles instead of the tool registry.
const blogSearchConfig = buildBlogSearchConfig(posts);

// Filter chips carry a build-time count, and a category with zero posts does
// not get a chip at all — an empty filter result can then never happen, no
// runtime empty-state needed.
const countByCategory = new Map<string, number>();
for (const post of posts) {
	const key = getBlogCategory(post.data.category).key;
	countByCategory.set(key, (countByCategory.get(key) ?? 0) + 1);
}
const filterableCategories = BLOG_CATEGORIES.filter((c) => (countByCategory.get(c.key) ?? 0) > 0);

// The page reads as a magazine top and an archive tail: the newest posts get
// display space (featured 1+2, then a card grid), everything older collapses
// into per-year single-line rows. 47 identical two-column cards was a wall;
// the archive rows halve the page and make the years of writing visible.
const [hero, ...rest] = posts;
const minis = rest.slice(0, 2);
const recent = rest.slice(2, 6);
const archive = rest.slice(6);
const byYear = new Map<number, typeof posts>();
for (const post of archive) {
	const year = post.data.pubDate.getFullYear();
	const bucket = byYear.get(year) ?? [];
	bucket.push(post);
	byYear.set(year, bucket);
}
const yearGroups = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

// Short in-row date: the list row has no room for FormattedDate's long form,
// and it must be a bilingual pair (en "Mar 12" / zh "3月12日") like every
// other script-free text on the page.
const shortDate = (d: Date) => ({
	en: d.toLocaleDateString('en-us', { month: 'short', day: 'numeric' }),
	zh: `${d.getMonth() + 1}月${d.getDate()}日`,
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`技术博客 (Blog) — ${SITE_TITLE}`}
			description="深入工程实战与算法手记：零依赖纯前端架构、二维码手写编码、UUID 数据库索引性能优化与金融复利数学。"
		/>
	</head>
	<body>
		<Header searchConfig={blogSearchConfig} />
		<main class="blog-container">
			<!-- Header Intro -->
			<div class="blog-header">
				<div class="blog-badge">
					<span class="badge-dot"></span>
					<span class="i18n-zh">手写代码 · 实测数据 · 一次讲透原理</span>
					<span class="i18n-en">Hand-rolled Code · Measured Numbers</span>
				</div>
				<h1 class="blog-title">
					<span class="i18n-zh">技术博客与工程手记</span>
					<span class="i18n-en">Writing About the Craft</span>
				</h1>
				<p class="blog-subtitle i18n-zh">{posts.length} 篇手写引擎、实测数据驱动的工程手记。</p>
				<p class="blog-subtitle i18n-en">{posts.length} notes on hand-rolled engines and measured numbers.</p>
			</div>

			<form class="blog-category-filter" data-blog-category-filter action="/blog/" method="get">
				<span class="filter-label">
					<span class="i18n-zh">按主题筛选</span>
					<span class="i18n-en">Filter by topic</span>
				</span>
				<button type="submit" name="category" value="" data-blog-category="all" aria-pressed="true" aria-current="true">
					<span class="i18n-zh">全部</span><span class="i18n-en">All</span>
					<span class="count-badge">{posts.length}</span>
				</button>
				{filterableCategories.map((category) => (
					<button type="submit" name="category" value={category.key} data-blog-category={category.key} aria-pressed="false" aria-current="false">
						<span class="i18n-zh">{category.labelZh}</span><span class="i18n-en">{category.labelEn}</span>
						<span class="count-badge">{countByCategory.get(category.key)}</span>
					</button>
				))}
			</form>

			<!-- Featured: newest post large + the next two compact -->
			{
				hero && (
					<section class="featured-section" data-blog-card-container>
						<div class="featured-grid">
							<a class="featured-card" href={`/blog/${hero.id}/`} data-blog-card data-cat={getBlogCategory(hero.data.category).key}>
								<div class="featured-badge-row">
									<span class="featured-tag">
										<span class="i18n-zh">最新发布</span><span class="i18n-en">Latest</span>
									</span>
									<span class="cat-pill" style={`--cat-color: ${getBlogCategory(hero.data.category).color};`}>
										<span class="i18n-zh">{getBlogCategory(hero.data.category).labelZh}</span>
										<span class="i18n-en">{getBlogCategory(hero.data.category).labelEn}</span>
									</span>
									<span class="read-time-pill">
										<ReadingTime minutes={readingMinutes(hero.body ?? '')} />
									</span>
								</div>

								<h2 class="featured-title" lang={hero.data.contentLang}>{hero.data.title}</h2>
								<p class="featured-desc" lang={hero.data.contentLang}>{hero.data.description}</p>

								<div class="featured-foot">
									<div class="featured-meta">
										<FormattedDate date={hero.data.pubDate} />
										<span class="meta-dot">·</span>
										<span>QCSunny</span>
									</div>
									<span class="featured-cta">
										<span class="i18n-zh">阅读完整长文</span>
										<span class="i18n-en">Read Full Article</span>
										<span class="cta-arrow" aria-hidden="true">→</span>
									</span>
								</div>
							</a>
							<div class="featured-side">
								{minis.map((post) => {
									const cat = getBlogCategory(post.data.category);
									return (
										<a class="featured-mini" href={`/blog/${post.id}/`} data-blog-card data-cat={cat.key} style={`--cat-color: ${cat.color};`}>
											<div class="mini-top">
												<span class="cat-pill" style={`--cat-color: ${cat.color};`}>
													<span class="i18n-zh">{cat.labelZh}</span>
													<span class="i18n-en">{cat.labelEn}</span>
												</span>
												<ReadingTime minutes={readingMinutes(post.body ?? '')} />
											</div>
											<h3 class="mini-title" lang={post.data.contentLang}>{post.data.title}</h3>
											<div class="mini-meta">
												<FormattedDate date={post.data.pubDate} />
												<span class="cta-arrow" aria-hidden="true">→</span>
											</div>
										</a>
									);
								})}
							</div>
						</div>
					</section>
				)
			}

			<!-- Recent Articles Grid -->
			{
				recent.length > 0 && (
					<section class="articles-section" data-blog-card-container>
						<div class="articles-header">
							<h2 class="articles-title">
								<span class="i18n-zh">近期文章</span>
								<span class="i18n-en">Recent Articles</span>
							</h2>
						</div>

						<div class="articles-grid">
							{recent.map((post) => {
								const cat = getBlogCategory(post.data.category);
								return (
									<article class="article-card" data-blog-card data-cat={cat.key} style={`--cat-color: ${cat.color};`}>
										<a href={`/blog/${post.id}/`} class="article-card-link">
											<div class="article-meta-row">
												<span class="cat-pill" style={`--cat-color: ${cat.color};`}>
													<span class="i18n-zh">{cat.labelZh}</span>
													<span class="i18n-en">{cat.labelEn}</span>
												</span>
												<span class="article-date">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<span class="meta-dot">·</span>
												<ReadingTime minutes={readingMinutes(post.body ?? '')} />
											</div>

											<h3 class="article-title" lang={post.data.contentLang}>{post.data.title}</h3>
											<p class="article-desc" lang={post.data.contentLang}>{post.data.description}</p>

											<div class="article-foot">
												<span class="read-more">
													<span class="i18n-zh">阅读全文</span>
													<span class="i18n-en">Read Article</span>
													<span class="read-arrow" aria-hidden="true">→</span>
												</span>
											</div>
										</a>
									</article>
								);
							})}
						</div>
					</section>
				)
			}

			<!-- Archive: one row per older post, grouped by year -->
			{
				yearGroups.map(([year, group]) => (
					<section class="archive-year" data-blog-card-container>
						<h3 class="year-label">{year}</h3>
						<ul class="archive-list">
							{group.map((post) => {
								const cat = getBlogCategory(post.data.category);
								const d = shortDate(post.data.pubDate);
								return (
									<li>
										<a class="archive-row" href={`/blog/${post.id}/`} data-blog-card data-cat={cat.key} style={`--cat-color: ${cat.color};`}>
											<span class="row-date">
												<span class="i18n-en">{d.en}</span>
												<span class="i18n-zh">{d.zh}</span>
											</span>
											<span class="row-dot" aria-hidden="true"></span>
											<span class="row-title" lang={post.data.contentLang}>{post.data.title}</span>
											<span class="row-time">
												<ReadingTime minutes={readingMinutes(post.body ?? '')} />
											</span>
										</a>
									</li>
								);
							})}
						</ul>
					</section>
				))
			}

			<!-- Bottom Tools Promotion Box -->
			<section class="tools-cta-box">
				<div class="tools-cta-content">
					<h3>
						<span class="i18n-zh">探索配套开发者工具库</span>
						<span class="i18n-en">Explore Matching Developer Tools</span>
					</h3>
					<p>
						<span class="i18n-zh">JSON / SQL 格式化、JWT 解码、复利与房贷测算…… {toolTotal} 款纯浏览器工具全部免费、数据不出页面。</span>
						<span class="i18n-en">JSON/SQL formatting, JWT decoding, mortgage and compound-interest math — {toolTotal} free tools that run entirely in your browser, nothing uploaded.</span>
					</p>
				</div>
				<a href="/tools/" class="tools-cta-btn">
					<span class="i18n-zh">前往工具库 →</span>
					<span class="i18n-en">Browse Tools →</span>
				</a>
			</section>
		</main>
		<Footer />
		<script is:inline>
			(() => {
				const filter = document.querySelector('[data-blog-category-filter]');
				if (!filter) return;
				const buttons = Array.from(filter.querySelectorAll('[data-blog-category]'));
				const cards = Array.from(document.querySelectorAll('[data-blog-card]'));
				const containers = Array.from(document.querySelectorAll('[data-blog-card-container]'));
				const validCategories = new Set(buttons.map((button) => button.dataset.blogCategory));

				const applyCategory = (category, updateUrl = false) => {
					const selected = validCategories.has(category) ? category : 'all';
					buttons.forEach((button) => {
						const active = button.dataset.blogCategory === selected;
						button.setAttribute('aria-pressed', String(active));
						button.setAttribute('aria-current', String(active));
					});
					cards.forEach((card) => {
						card.hidden = selected !== 'all' && card.dataset.cat !== selected;
					});
					containers.forEach((container) => {
						if (container.dataset.cat) {
							container.hidden = selected !== 'all' && container.dataset.cat !== selected;
						} else {
							// Mixed-content containers (featured grid, recent grid, a
							// year group) have no single category: they show while
							// they still hold at least one visible card.
							container.hidden =
								container.querySelectorAll('[data-blog-card]:not([hidden])').length === 0;
						}
					});
					if (updateUrl) {
						const url = new URL(window.location.href);
						if (selected === 'all') url.searchParams.delete('category');
						else url.searchParams.set('category', selected);
						window.history.pushState({}, '', url.pathname + (url.search ? url.search : '') + url.hash);
					}
				};

				const initial = new URLSearchParams(window.location.search).get('category') || 'all';
				applyCategory(initial);
				filter.addEventListener('submit', (event) => {
					event.preventDefault();
					const submitter = event.submitter;
					applyCategory(submitter?.dataset.blogCategory || 'all', true);
				});
				window.addEventListener('popstate', () => {
					applyCategory(new URLSearchParams(window.location.search).get('category') || 'all');
				});
			})();
		</script>
	</body>
</html>

<style>
	/* The cards below set explicit display (flex/grid), which beats the UA's
	   [hidden] { display: none } — the category filter hides cards via the
	   hidden attribute, so it has to win here. */
	[hidden] {
		display: none !important;
	}

	.blog-container {
		/* --w-shell, the site-wide frame the nav, the home page and the post
		   shell all take — the list used to ride --w-outer (832), so the frame
		   jumped inward on the way from the nav to the list and back out into
		   an article. A post's reading column stays --w-prose inside its own
		   grid; this is only the list's outer frame. */
		width: min(var(--w-shell), 100% - 2.5em);
		margin: 0 auto;
		padding: 3rem 0 5rem;
	}

	/* --- HEADER --- */
	.blog-header {
		margin-bottom: 2.8rem;
		text-align: left;
	}

	.blog-badge {
		display: inline-flex;
		align-items: center;
		gap: 0.55em;
		padding: 0.3em 0.85em;
		background: var(--accent-soft);
		border: 1px solid var(--gridline);
		border-radius: 999px;
		font-size: 0.82rem;
		font-weight: 600;
		color: var(--accent);
		margin-bottom: 1.2rem;
	}

	.badge-dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: var(--accent);
		box-shadow: 0 0 8px var(--accent);
	}

	.blog-title {
		font-size: clamp(2.2rem, 5vw, 3rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		color: var(--fg);
		margin-bottom: 0.8rem;
	}

	.blog-subtitle {
		font-size: 1.1rem;
		color: var(--dim);
		line-height: 1.7;
		max-width: 44em;
		margin: 0;
	}

	.blog-category-filter {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-wrap: wrap;
		margin: -1.1rem 0 2.6rem;
	}

	.filter-label {
		color: var(--dim);
		font-size: 0.84rem;
		font-weight: 600;
		margin-right: 0.2rem;
	}

	.blog-category-filter button {
		display: inline-flex;
		align-items: center;
		gap: 0.45em;
		border: 1px solid var(--gridline);
		border-radius: 999px;
		background: var(--card);
		color: var(--dim);
		cursor: pointer;
		font: inherit;
		font-size: 0.82rem;
		padding: 0.38rem 0.75rem;
		transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
	}

	.blog-category-filter button:hover,
	.blog-category-filter button:focus-visible {
		border-color: var(--accent);
		color: var(--accent);
	}

	.blog-category-filter button[aria-pressed='true'] {
		background: var(--accent-soft);
		border-color: var(--accent);
		color: var(--accent);
	}

	/* Build-time count per category, so an empty filter result is impossible. */
	.count-badge {
		font-size: 0.72rem;
		font-family: var(--font-mono);
		color: var(--dim);
		background: color-mix(in srgb, var(--fg) 7%, transparent);
		border-radius: 999px;
		padding: 0.05em 0.55em;
	}

	.blog-category-filter button[aria-pressed='true'] .count-badge {
		color: var(--accent);
		background: color-mix(in srgb, var(--accent) 14%, transparent);
	}

	/* --- FEATURED 1 + 2 --- */
	.featured-section {
		margin-bottom: 3rem;
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 1.55fr 1fr;
		gap: 1.2rem;
		align-items: stretch;
	}

	@media (max-width: 820px) {
		.featured-grid {
			grid-template-columns: 1fr;
		}
	}

	.featured-card {
		display: flex;
		flex-direction: column;
		padding: 2.2rem 2.4rem;
		background: var(--card);
		border: 1px solid var(--gridline);
		border-radius: 16px;
		text-decoration: none;
		box-shadow: var(--box-shadow);
		position: relative;
		overflow: hidden;
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	.featured-card::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 3px;
		background: linear-gradient(90deg, var(--accent) 0%, #a855f7 50%, #ec4899 100%);
	}

	.featured-card:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
		text-decoration: none;
	}

	.featured-badge-row {
		display: flex;
		align-items: center;
		gap: 0.8em;
		margin-bottom: 1rem;
		flex-wrap: wrap;
	}

	.featured-tag {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent);
		background: var(--accent-soft);
		padding: 0.2em 0.6em;
		border-radius: 6px;
	}

	.cat-pill {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--cat-color);
		background: color-mix(in srgb, var(--cat-color) 12%, transparent);
		padding: 0.2em 0.6em;
		border-radius: 6px;
	}

	.read-time-pill {
		font-size: 0.78rem;
		color: var(--dim);
		font-family: var(--font-mono);
	}

	.featured-title {
		font-size: clamp(1.45rem, 3.2vw, 1.95rem);
		font-weight: 800;
		color: var(--fg);
		line-height: 1.35;
		letter-spacing: -0.02em;
		margin-bottom: 0.7rem;
		transition: color 0.15s ease;
	}

	.featured-card:hover .featured-title {
		color: var(--accent);
	}

	.featured-desc {
		font-size: 1rem;
		color: var(--dim);
		line-height: 1.65;
		margin-bottom: 1.8rem;
		max-width: 48em;
		flex: 1;
	}

	.featured-foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid var(--gridline);
		padding-top: 1.1rem;
		flex-wrap: wrap;
		gap: 0.8em;
	}

	.featured-meta {
		display: flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.86rem;
		color: var(--dim);
		font-family: var(--font-mono);
	}

	.meta-dot {
		opacity: 0.5;
	}

	.featured-cta {
		display: inline-flex;
		align-items: center;
		gap: 0.4em;
		font-size: 0.92rem;
		font-weight: 700;
		color: var(--accent);
	}

	.cta-arrow {
		transition: transform 0.15s ease;
	}

	.featured-card:hover .cta-arrow {
		transform: translateX(5px);
	}

	/* The two compact cards beside the hero. Same family, less room. */
	.featured-side {
		display: grid;
		grid-template-rows: 1fr 1fr;
		gap: 1.2rem;
		min-width: 0;
	}

	.featured-mini {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.3rem 1.5rem;
		background: var(--card);
		border: 1px solid var(--gridline);
		border-radius: 16px;
		text-decoration: none;
		box-shadow: var(--box-shadow);
		transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
	}

	/* Category colour spine on the left edge — the no-image list's colour
	   anchor; the hero has its gradient bar, cards get their category. */
	.featured-mini::before,
	.article-card::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 3px;
		background: var(--cat-color);
	}

	.featured-mini:hover {
		transform: translateY(-3px);
		border-color: var(--accent);
		box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
	}

	.mini-top {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6em;
		font-size: 0.76rem;
		color: var(--dim);
		font-family: var(--font-mono);
		flex-wrap: wrap;
	}

	.mini-title {
		font-size: 1.08rem;
		font-weight: 700;
		color: var(--fg);
		line-height: 1.42;
		letter-spacing: -0.01em;
		margin: 0;
		transition: color 0.15s ease;
	}

	.featured-mini:hover .mini-title {
		color: var(--accent);
	}

	.mini-meta {
		margin-top: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.6em;
		font-size: 0.8rem;
		color: var(--dim);
		font-family: var(--font-mono);
	}

	.featured-mini:hover .mini-meta .cta-arrow {
		transform: translateX(4px);
	}

