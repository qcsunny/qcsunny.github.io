---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { readingMinutes } from '../../blog/blogMetadata';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const relatedPosts = (await getCollection('blog'))
	.filter((candidate) => post.data.relatedPosts.includes(candidate.id))
	.map((candidate) => ({
		slug: candidate.id,
		title: candidate.data.title,
		description: candidate.data.description,
		contentLang: candidate.data.contentLang,
	}));
// hasMath is set by satteri-katex.mjs, which flips it on the frontmatter the
// first time it renders a formula; it gates the KaTeX stylesheet so the posts
// without formulas do not load it.
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const body = post.body ?? '';
const minutes = readingMinutes(body);
---

<BlogPost
	{...post.data}
	relatedPosts={relatedPosts}
	minutes={minutes}
	slug={post.id}
	hasMath={remarkPluginFrontmatter.hasMath ?? false}
	headings={headings}
>
	<Content />
</BlogPost>
