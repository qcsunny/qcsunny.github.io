---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}
type Props = CollectionEntry<'blog'>;

const post = Astro.props;
// hasMath is set by satteri-katex.mjs, which flips it on the frontmatter the
// first time it renders a formula; it gates the KaTeX stylesheet so the posts
// without formulas do not load it.
const { Content, remarkPluginFrontmatter } = await render(post);
const body = post.body ?? '';
const words = body.match(/[\p{L}\p{N}][\p{L}\p{N}'’-]*/gu)?.length ?? 0;
const cjk = body.match(/[\p{Script=Han}]/gu)?.length ?? 0;
const minutes = Math.max(1, Math.round((words - cjk) / 220 + cjk / 400));
---

<BlogPost
	{...post.data}
	minutes={minutes}
	slug={post.id}
	hasMath={remarkPluginFrontmatter.hasMath ?? false}
>
	<Content />
</BlogPost>
