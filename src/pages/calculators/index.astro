---
// calculators hub — a single-category view of the Tools hub. Title, Chinese
// title and blurb come from CATEGORIES so the copy lives in one place; only
// the search placeholder is bespoke to this page.
import ToolShell from '../../components/tools/ToolShell.astro';
import ToolSearchBar from '../../components/tools/ToolSearchBar.astro';
import { CATEGORIES, REAL_TOOLS } from '../../tools/registry';

const cat = CATEGORIES.find((c) => c.id === 'calculators')!;
// REAL_TOOLS includes the three featured calculators (static pages, not
// registry entries) and already drops redirect stubs and disabled tools.
const entries = REAL_TOOLS.filter((e) => e.category === 'calculators');
---

<ToolShell title={cat.label} titleZh={cat.labelZh} description={cat.blurb}>
	<ToolSearchBar category="calculators" placeholder="Search calculators (e.g. percentage, fraction, ratio, graph)..." placeholderZh="搜索计算器 (如 百分比、分数、比例、函数图像、科学计算)..." totalCount={entries.length} />
	<div class="t-cards">
		{
			entries.map((e) => (
				<a class="t-card" href={`/${e.category}/${e.slug}/`} data-slug={e.slug} data-cat={e.category}>
					<h2>
						<span class="i18n-en">{e.name}</span>
						<span class="i18n-zh">{e.nameZh || e.name}</span>
					</h2>
					<p>
						<span class="i18n-en">{e.description}</span>
						{e.descriptionZh && <span class="i18n-zh">{e.descriptionZh}</span>}
					</p>
				</a>
			))
		}
	</div>
</ToolShell>
